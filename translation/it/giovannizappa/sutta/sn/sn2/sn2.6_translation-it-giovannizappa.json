{
  "sn2.6:0.1": "Discorsi connessi 2.6 ",
  "sn2.6:0.2": "1. Capitolo 1 ",
  "sn2.6:0.3": "Il discorso con Kāmada ",
  "sn2.6:1.1": "A Sāvatthī. ",
  "sn2.6:1.2": "Rimanendo in piedi a lato, l’angioletto Kāmada disse al Buddha: ",
  "sn2.6:1.3": "“È difficile, Beato! È troppo difficile!” ",
  "sn2.6:2.1": "“Lo fanno anche se è difficile”, ",
  "sn2.6:2.2": "disse il Buddha a Kāmada, "
}