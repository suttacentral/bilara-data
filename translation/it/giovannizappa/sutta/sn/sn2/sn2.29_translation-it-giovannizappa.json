{
  "sn2.29:0.1": "Discorsi connessi 2.29 ",
  "sn2.29:0.2": "3. Il capitolo sui vari religiosi ",
  "sn2.29:0.3": "Il discorso con Susīma ",
  "sn2.29:1.1": "A Sāvatthī. ",
  "sn2.29:1.2": "Il Venerabile Ānanda andò dal Buddha, si inchinò, e si sedette a lato. Il Buddha gli disse: ",
  "sn2.29:1.3": "“Ānanda, approvi di Sāriputta?” ",
  "sn2.29:2.1": "“Signore, chi mai non approverebbe del Venerabile Sāriputta, se non uno stolto, un bullo, un illuso, o un matto? ",
  "sn2.29:2.2": "Il Venerabile Sāriputta è astuto, ",
  "sn2.29:2.3": "possiede grande saggezza, ",
  "sn2.29:2.4": "ampia saggezza, ",
  "sn2.29:2.5": "saggezza ridente, ",
  "sn2.29:2.6": "saggezza veloce, ",
  "sn2.29:2.7": "saggezza aguzza, ",
  "sn2.29:2.8": "e saggezza penetrante. ",
  "sn2.29:2.9": "Ha pochi desideri, "
}