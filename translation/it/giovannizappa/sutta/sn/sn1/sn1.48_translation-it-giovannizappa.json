{
  "sn1.48:0.1": "Discorsi connessi 1.48 ",
  "sn1.48:0.2": "5. Il capitolo sul fuoco ",
  "sn1.48:0.3": "Il discorso sul bosco di Jeta ",
  "sn1.48:1.1": "“Questo è davvero quel Bosco di Jeta, ",
  "sn1.48:1.2": "frequentato dalla comunità di veggenti, ",
  "sn1.48:1.3": "dove il Re dell’Insegnamento dimorò: ",
  "sn1.48:1.4": "mi dà gioia! ",
  "sn1.48:2.1": "Azioni, conoscenza, e principio; ",
  "sn1.48:2.2": "condotta etica, sostentamento eccellente; "
}