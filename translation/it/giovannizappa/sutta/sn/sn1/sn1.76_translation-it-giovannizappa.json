{
  "sn1.76:0.1": "Discorsi connessi 1.76 ",
  "sn1.76:0.2": "8. Il capitolo sull’ammazzare ",
  "sn1.76:0.3": "Il discorso sull’invecchiare ",
  "sn1.76:1.1": "“Cosa invecchia, cosa non invecchia? ",
  "sn1.76:1.2": "Cosa si dice sia una deviazione? ",
  "sn1.76:1.3": "Cos’è un ostacolo alle buone qualità? ",
  "sn1.76:1.4": "Cosa finisce giorno e notte? "
}