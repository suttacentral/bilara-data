{
  "sn1.3:0.1": "Discorsi connessi 1.3 ",
  "sn1.3:0.2": "1. Il capitolo della canna ",
  "sn1.3:0.3": "Il discorso sul procedere ",
  "sn1.3:1.1": "A Sāvatthī. ",
  "sn1.3:1.2": "Rimanendo in piedi a lato, un angelo recitò questo versetto in presenza del Buddha: ",
  "sn1.3:2.1": "“Questa vita, così corta, continua. "
}