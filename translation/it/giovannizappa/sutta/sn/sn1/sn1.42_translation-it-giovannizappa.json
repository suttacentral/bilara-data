{
  "sn1.42:0.1": "Discorsi connessi 1.42 ",
  "sn1.42:0.2": "5. Il capitolo sul fuoco ",
  "sn1.42:0.3": "Il discorso sul cosa donare ",
  "sn1.42:1.1": "“Donando cosa si dona forza? ",
  "sn1.42:1.2": "Donando cosa si dona bellezza? ",
  "sn1.42:1.3": "Donando cosa si dona felicità? ",
  "sn1.42:1.4": "Donando cosa si dona visione? ",
  "sn1.42:1.5": "E chi è il donatore di ogni cosa? ",
  "sn1.42:1.6": "Per favore, risponda alla mia domanda” ",
  "sn1.42:2.1": "“Donando cibo si dona forza. "
}