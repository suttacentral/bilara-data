{
  "sn1.6:0.1": "Discorsi connessi 1.6 ",
  "sn1.6:0.2": "1. Il capitolo della canna ",
  "sn1.6:0.3": "Il discorso sulla veglia ",
  "sn1.6:1.1": "A Sāvatthī. ",
  "sn1.6:1.2": "Rimanendo in piedi a lato, un angelo recitò questo versetto in presenza del Buddha: ",
  "sn1.6:2.1": "“Quanti dormono tra chi veglia? ",
  "sn1.6:2.2": "Quanti vegliano tra chi dorme? "
}