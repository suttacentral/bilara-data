{
  "sn1.17:0.1": "Discorsi connessi 1.17 ",
  "sn1.17:0.2": "2. Il capitolo sul Giardino delle Delizie ",
  "sn1.17:0.3": "Il discorso sul difficile da fare ",
  "sn1.17:1.1": "“Difficile da fare, difficile da sopportare, ",
  "sn1.17:1.2": "è la vita ascetica per l’inetto, ",
  "sn1.17:1.3": "poiché ha molti passaggi stretti ",
  "sn1.17:1.4": "dove lo stolto crolla” ",
  "sn1.17:2.1": "“Quanti giorni può vivere un asceta ",
  "sn1.17:2.2": "senza controllare la mente? ",
  "sn1.17:2.3": "Crollerebbe ad ogni passo, ",
  "sn1.17:2.4": "sotto il peso dei pensieri. "
}