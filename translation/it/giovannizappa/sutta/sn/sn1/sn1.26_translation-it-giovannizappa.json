{
  "sn1.26:0.1": "Discorsi connessi 1.26 ",
  "sn1.26:0.2": "3. Il capitolo della spada ",
  "sn1.26:0.3": "Il discorso sulle lampade ",
  "sn1.26:1.1": "“Quante lampade ci sono ",
  "sn1.26:1.2": "che illuminano il mondo? ",
  "sn1.26:1.3": "Siamo venuti a chiederle, Signore: ",
  "sn1.26:1.4": "come possiamo capirlo?” ",
  "sn1.26:2.1": "“Ci sono quattro lampade che illuminano il mondo, ",
  "sn1.26:2.2": "non se ne trova una quinta. "
}