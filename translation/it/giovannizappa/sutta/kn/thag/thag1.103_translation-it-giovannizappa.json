{
  "thag1.103:0.1": "Versetti degli anziani 1.103 ",
  "thag1.103:0.2": "Il libro degli uno ",
  "thag1.103:0.3": "Capitolo 11 ",
  "thag1.103:0.4": "Bandhura ",
  "thag1.103:1.1": "Non ho bisogno di questo, ",
  "thag1.103:1.2": "sono felice e soddisfatto del dolce insegnamento. ",
  "thag1.103:1.3": "Ho bevuto il meglio, il nettare supremo: ",
  "thag1.103:1.4": "non mi avvicino al veleno. ",
  "thag1.103:1.5": ""
}