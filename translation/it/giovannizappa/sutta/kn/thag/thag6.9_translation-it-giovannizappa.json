{
  "thag6.9:0.1": "Versetti dei monaci anziani 6.9 ",
  "thag6.9:0.2": "Il libro dei sei ",
  "thag6.9:0.3": "Capitolo 1 ",
  "thag6.9:0.4": "Jenta figlio del sommo sacerdote ",
  "thag6.9:1.1": "Ero ubriaco dell’orgoglio della nascita, ",
  "thag6.9:1.2": "della ricchezza, e dell’autorità. ",
  "thag6.9:1.3": "Vagavo intossicato ",
  "thag6.9:1.4": "dal mio stesso bellissimo corpo. ",
  "thag6.9:2.1": "Nessuno era mio eguale o superiore, ",
  "thag6.9:2.2": "così pensavo. ",
  "thag6.9:2.3": "Ero uno stolto tanto arrogante, ",
  "thag6.9:2.4": "altezzoso, sventolavo la mia stessa bandiera. "
}