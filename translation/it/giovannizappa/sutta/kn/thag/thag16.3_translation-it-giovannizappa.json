{
  "thag16.3:0.1": "Versetti dei monaci anziani 6.13 ",
  "thag16.3:0.2": "Il libro dei venti ",
  "thag16.3:0.3": "Capitolo 1 ",
  "thag16.3:0.4": "Telakāni ",
  "thag16.3:1.1": "Per molto tempo, purtroppo, ",
  "thag16.3:1.2": "sebbene contemplavo i fenomeni con entusiasmo, ",
  "thag16.3:1.3": "non raggiungevo pace mentale. ",
  "thag16.3:1.4": "Quindi chiesi agli asceti e ai bramini: ",
  "thag16.3:2.1": "“Chi nel mondo ha attraversato? "
}