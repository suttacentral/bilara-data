{
  "thag5.12:0.1": "Versetti dei monaci anziani 5.12 ",
  "thag5.12:0.2": "Il libro dei cinque ",
  "thag5.12:0.3": "Capitolo 1 ",
  "thag5.12:0.4": "Kosiya ",
  "thag5.12:1.1": "Chiunque sia giudizioso, comprendendo le parole del maestro, ",
  "thag5.12:1.2": "rimane con lui, e il suo entusiasmo cresce; ",
  "thag5.12:1.3": "quell’astuto è davvero devoto, ",
  "thag5.12:1.4": "comprendendo gli insegnamenti, è distinto. ",
  "thag5.12:2.1": "Quando sorgono estremi stres, "
}