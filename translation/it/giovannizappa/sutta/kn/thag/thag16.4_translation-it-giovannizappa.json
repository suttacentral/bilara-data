{
  "thag16.4:0.1": "Versetti dei monaci anziani 16.4 ",
  "thag16.4:0.2": "Il libro dei venti ",
  "thag16.4:0.3": "Capitolo 1 ",
  "thag16.4:0.4": "Raṭṭhapāla ",
  "thag16.4:1.1": "“Guarda questo bel pupazzo, ",
  "thag16.4:1.2": "un corpo fatto di piaghe, ",
  "thag16.4:1.3": "malato, su cui ci si ossessiona, ",
  "thag16.4:1.4": "in cui niente dura. ",
  "thag16.4:2.1": "Guarda questa bella figura, ",
  "thag16.4:2.2": "con gemme e orecchini; ",
  "thag16.4:2.3": "sono ossa avvolte in pelle, "
}