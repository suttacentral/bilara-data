{
  "thag6.8:0.1": "Versetti dei monaci anziani 6.8 ",
  "thag6.8:0.2": "Il libro dei sei ",
  "thag6.8:0.3": "Capitolo 1 ",
  "thag6.8:0.4": "Migajāla ",
  "thag6.8:1.1": "Fu spiegato bene dal Chiaroveggente, ",
  "thag6.8:1.2": "dal Buddha, il parente del Sole, ",
  "thag6.8:1.3": "che ha trasceso ogni catena, ",
  "thag6.8:1.4": "e distrutto ogni inerzia. ",
  "thag6.8:2.1": "Emancipante, porta all’altra sponda, ",
  "thag6.8:2.2": "prosciugando la radice della sete, ",
  "thag6.8:2.3": "e, avendo tagliato la radice velenosa, il mattatoio, ",
  "thag6.8:2.4": "porta all’estinzione. ",
  "thag6.8:3.1": "Spezzando la radice dell’ignoranza, ",
  "thag6.8:3.2": "distrugge il meccanismo delle azioni, ",
  "thag6.8:3.3": "e fa discendere il fulmine della conoscenza ",
  "thag6.8:3.4": "e della presa di coscienza. ",
  "thag6.8:4.1": "Informa riguardo alle sensazioni, ",
  "thag6.8:4.2": "liberando dall’attaccamento, ",
  "thag6.8:4.3": "contemplando con comprensione "
}