{
  "thag1.47:0.1": "Versetti degli anziani 1.47 ",
  "thag1.47:0.2": "Il libro degli uno ",
  "thag1.47:0.3": "Capitolo 5 ",
  "thag1.47:0.4": "Ujjaya ",
  "thag1.47:1.1": "Lode a te, oh Buddha, oh eroe, ",
  "thag1.47:1.2": "libero in ogni modo! ",
  "thag1.47:1.3": "Dimorando nei frutti della tua pratica, ",
  "thag1.47:1.4": "vivo senza contaminanti. ",
