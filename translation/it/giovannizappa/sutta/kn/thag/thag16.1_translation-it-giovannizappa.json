{
  "thag16.1:0.1": "Versetti dei monaci anziani 16.1 ",
  "thag16.1:0.2": "Il libro dei venti ",
  "thag16.1:0.3": "Capitolo 1 ",
  "thag16.1:0.4": "Adhimutta (2°) ",
  "thag16.1:1.1": "“Quelli che uccidemmo in passato, ",
  "thag16.1:1.2": "sia per sacrificio o per la loro ricchezza, ",
  "thag16.1:1.3": "senza eccezioni avevano paura; ",
  "thag16.1:1.4": "tremavano e stridevano. ",
  "thag16.1:2.1": "Ma tu non hai paura, ",
  "thag16.1:2.2": "sembri persino più calmo di prima. ",
  "thag16.1:2.3": "Perché non urli ",
  "thag16.1:2.4": "in una situazione così terrificante?” ",
  "thag16.1:3.1": "“Non c’è alcuna sofferenza mentale ",
  "thag16.1:3.2": "per chi è senza speranza, capovillaggio. ",
  "thag16.1:3.3": "Ogni paura è lasciata alle spalle "
}