{
  "thag1.79:0.1": "Versetti degli anziani 1.79 ",
  "thag1.79:0.2": "Il libro degli uno ",
  "thag1.79:0.3": "Capitolo 8 ",
  "thag1.79:0.4": "Rakkhita ",
  "thag1.79:1.1": "Ogni mia avidità è stata abbandonata, ",
  "thag1.79:1.2": "ogni mio odio eradicato, ",
  "thag1.79:1.3": "ogni mia illusione sparita: ",
  "thag1.79:1.4": "sono raffrescato, estinto. ",
  "thag1.79:1.5": ""
}