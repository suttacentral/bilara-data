{
  "thag1.59:0.1": "Versetti degli anziani 1.59 ",
  "thag1.59:0.2": "Il libro degli uno ",
  "thag1.59:0.3": "Capitolo 6 ",
  "thag1.59:0.4": "Kosalavihārin ",
  "thag1.59:1.1": "Lasciai casa per fede ",
  "thag1.59:1.2": "e costruii una piccola capanna nella natura. ",
  "thag1.59:1.3": "Sono accorto, ardente, ",
  "thag1.59:1.4": "presente e consapevole. ",
