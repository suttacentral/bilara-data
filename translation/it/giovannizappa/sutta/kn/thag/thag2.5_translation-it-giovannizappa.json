{
  "thag2.5:0.1": "Versetti degli anziani 2.5 ",
  "thag2.5:0.2": "Il libro dei due ",
  "thag2.5:0.3": "Capitolo 1 ",
  "thag2.5:0.4": "Ajina ",
  "thag2.5:1.1": "Persino un maestro delle tre conoscenze, ",
  "thag2.5:1.2": "incontaminato, conquistatore della morte, ",
  "thag2.5:1.3": "viene guardato dall’alto in basso se sconosciuto ",
  "thag2.5:1.4": "dagli stolti ignoranti. ",
  "thag2.5:2.1": "Ma chiunque qui ",
  "thag2.5:2.2": "riceve cibo e bevande ",
  "thag2.5:2.3": "viene onorato da loro, ",
  "thag2.5:2.4": "anche se è di cattivo carattere. ",
  "thag2.5:2.5": ""
}