{
  "thag2.38:0.1": "Versetti degli anziani 2.38 ",
  "thag2.38:0.2": "Il libro dei due ",
  "thag2.38:0.3": "Capitolo 4 ",
  "thag2.38:0.4": "Nisabha ",
  "thag2.38:1.1": "Chi ha abbandonato le cinque eccitazioni dei sensi, ",
  "thag2.38:1.2": "così piacevoli e deliziose, ",
  "thag2.38:1.3": "e ha lasciato la vita di casa in fede, ",
  "thag2.38:1.4": "che ponga fine alla sofferenza! ",
  "thag2.38:2.1": "Non desidero la morte, ",
  "thag2.38:2.2": "non desidero la vita; ",
  "thag2.38:2.3": "aspetto la mia ora, ",
  "thag2.38:2.4": "presente e consapevole. ",
  "thag2.38:2.5": ""
}