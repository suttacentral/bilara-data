{
  "thag5.8:0.1": "Versetti degli anziani 5.8 ",
  "thag5.8:0.2": "Il libro dei cinque ",
  "thag5.8:0.3": "Capitolo 1 ",
  "thag5.8:0.4": "Vakkali ",
  "thag5.8:1.1": "“Colpito da male da aria ",
  "thag5.8:1.2": "mentre vivi nel bosco, ",
  "thag5.8:1.3": "ti sei addentrato in un posto difficile per trovare elemosina, ",
  "thag5.8:1.4": "come sopravviverai, mendicante?” ",
  "thag5.8:2.1": "“Pervadendo questo sacco di ossa ",
  "thag5.8:2.2": "di abbondante euforia e felicità, ",
  "thag5.8:2.3": "sopportando ciò che è difficile da sopportare, ",
  "thag5.8:2.4": "dimorerò nel bosco. ",
  "thag5.8:3.1": "Coltivando le basi della consapevolezza, ",
  "thag5.8:3.2": "le facoltà e i poteri, ",
  "thag5.8:3.3": "sviluppando i fattori di risveglio, ",
  "thag5.8:3.4": "dimorerò nel bosco. ",
  "thag5.8:4.1": "Avendo visto coloro che sono energici, risoluti, ",
  "thag5.8:4.2": "e sempre strenuamente vigorosi, ",
  "thag5.8:4.3": "armoniosi e uniti, ",
  "thag5.8:4.4": "dimorerò nel bosco. ",
  "thag5.8:5.1": "Richiamando alla mente il Buddha ",
  "thag5.8:5.2": "il migliore, il domato, il concentrato, ",
  "thag5.8:5.3": "instancabile tutto il giorno e tutta la notte, ",
  "thag5.8:5.4": "dimorerò nel bosco”. ",
  "thag5.8:5.5": ""
}