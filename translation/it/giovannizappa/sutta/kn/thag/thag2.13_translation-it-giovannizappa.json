{
  "thag2.13:0.1": "Versetti degli anziani 2.13 ",
  "thag2.13:0.2": "Il libro dei due ",
  "thag2.13:0.3": "Capitolo 2 ",
  "thag2.13:0.4": "Heraññakāni ",
  "thag2.13:1.1": "I giorni e le notti volano, ",
  "thag2.13:1.2": "e la vita viene interrotta. ",
  "thag2.13:1.3": "La vita dei mortali si consuma, ",
  "thag2.13:1.4": "come acqua in piccoli ruscelli. ",
  "thag2.13:2.1": "Ma mentre compie peccati ",
  "thag2.13:2.2": "lo stolto non sa ",
  "thag2.13:2.3": "che sarà amara più avanti, ",
  "thag2.13:2.4": "poiché il risultato sarà per lui cattivo. ",
  "thag2.13:2.5": ""
}