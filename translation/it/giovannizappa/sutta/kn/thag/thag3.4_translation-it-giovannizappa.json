{
  "thag3.4:0.1": "Versetti dei monaci anziani 3.4 ",
  "thag3.4:0.2": "Il libro dei tre ",
  "thag3.4:0.3": "Capitolo 1 ",
  "thag3.4:0.4": "Dhaniya ",
  "thag3.4:1.1": "Se vuoi vivere nella felicità, ",
  "thag3.4:1.2": "desiderando la vita ascetica, ",
  "thag3.4:1.3": "non criticare gli abiti della comunità, ",
  "thag3.4:1.4": "o il suo cibo e bevande. ",
  "thag3.4:2.1": "Se vuoi vivere nella felicità, ",
  "thag3.4:2.2": "desiderando la vita ascetica, ",
  "thag3.4:2.3": "Stai nei ripari della comunità ",
  "thag3.4:2.4": "come un serpente che usa la tana di un topo. ",
  "thag3.4:3.1": "Se vuoi vivere nella felicità, ",
  "thag3.4:3.2": "desiderando la vita ascetica, ",
  "thag3.4:3.3": "sviluppa questa sola qualità: ",
  "thag3.4:3.4": "sii soddisfatto di ciò che viene offerto. "
}