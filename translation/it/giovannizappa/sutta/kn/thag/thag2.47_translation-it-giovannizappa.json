{
  "thag2.47:0.1": "Versetti degli anziani 2.47 ",
  "thag2.47:0.2": "Il libro dei due ",
  "thag2.47:0.3": "Capitolo 5 ",
  "thag2.47:0.4": "Anūpama ",
  "thag2.47:1.1": "La mente presuntuosa, dipendente dal piacere, ",
  "thag2.47:1.2": "si impala sul proprio palo. ",
  "thag2.47:1.3": "Va sempre dove ",
  "thag2.47:1.4": "c’è un palo, un tagliere. ",
  "thag2.47:2.1": "Ti dichiaro la mente perdente! ",
  "thag2.47:2.2": "Ti dichiaro la mente insidiosa! ",
  "thag2.47:2.3": "Hai trovato il maestro così difficile da trovare, ",
  "thag2.47:2.4": "non portarmi via dall’obiettivo. ",
  "thag2.47:2.5": ""
}