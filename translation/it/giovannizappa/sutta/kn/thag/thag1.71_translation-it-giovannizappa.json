{
  "thag1.71:0.1": "Versetti degli anziani 1.71 ",
  "thag1.71:0.2": "Il libro degli uno ",
  "thag1.71:0.3": "Capitolo 8 ",
  "thag1.71:0.4": "Vacchapāla ",
  "thag1.71:1.1": "Per chi vede il significato, così sottile e raffinato, ",
  "thag1.71:1.2": "abile nel pensiero e umile nelle maniere, ",
  "thag1.71:1.3": "che ha coltivato un’etica matura, ",
  "thag1.71:1.4": "non è difficile raggiungere l’estinzione. ",
  "thag1.71:1.5": ""
}