{
  "thag1.107:0.1": "Versetti degli anziani 1.107 ",
  "thag1.107:0.2": "Il libro degli uno ",
  "thag1.107:0.3": "Capitolo 11 ",
  "thag1.107:0.4": "Dhammasava ",
  "thag1.107:1.1": "Dopo aver investigato, lasciai casa ",
  "thag1.107:1.2": "dalla vita di casa a quella mendicante. ",
  "thag1.107:1.3": "Ho raggiunto le tre conoscenze ",
  "thag1.107:1.4": "e completato le istruzioni del Buddha. ",
  "thag1.107:1.5": ""
}