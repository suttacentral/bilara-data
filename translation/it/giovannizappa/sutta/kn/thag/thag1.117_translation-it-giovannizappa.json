{
  "thag1.117:0.1": "Versetti degli anziani 1.117 ",
  "thag1.117:0.2": "Il libro degli uno ",
  "thag1.117:0.3": "Capitolo 12 ",
  "thag1.117:0.4": "Yasa ",
  "thag1.117:1.1": "Sono ben vestito e consacrato, ",
  "thag1.117:1.2": "adornato da tutti i miei gioielli. ",
  "thag1.117:1.3": "Ho raggiunto le tre conoscenze ",
  "thag1.117:1.4": "e completato le istruzioni del Buddha. ",
  "thag1.117:1.5": ""
}