{
  "thag2.3:0.1": "Versetti degli anziani 2.3 ",
  "thag2.3:0.2": "Il libro dei due ",
  "thag2.3:0.3": "Capitolo 1 ",
  "thag2.3:0.4": "Valliya (2°) ",
  "thag2.3:1.1": "Una scimmia si avvicina alla piccola capanna ",
  "thag2.3:1.2": "con cinque porte. ",
  "thag2.3:1.3": "Ci gira intorno, bussando ",
  "thag2.3:1.4": "a ogni porta, ancora e ancora. ",
  "thag2.3:2.1": "Stai ferma scimmia, non correre! ",
  "thag2.3:2.2": "Le cose sono diverse ora; ",
  "thag2.3:2.3": "sei stata catturata dalla saggezza, ",
  "thag2.3:2.4": "non andrai lontano. ",
  "thag2.3:2.5": ""
}