{
  "thag7.3:0.1": "Versetti dei monaci anziani 7.3 ",
  "thag7.3:0.2": "Il libro dei sette ",
  "thag7.3:0.3": "Capitolo 1 ",
  "thag7.3:0.4": "Bhadda ",
  "thag7.3:1.1": "Ero figlio unico, ",
  "thag7.3:1.2": "amato da mia madre e mio padre. ",
  "thag7.3:1.3": "Mi fecero praticare ",
  "thag7.3:1.4": "molte preghiere e osservanze. ",
  "thag7.3:2.1": "Per premura per me, ",
  "thag7.3:2.2": "desiderando il mio bene, e volendo il meglio per me, ",
  "thag7.3:2.3": "mia madre e mio padre ",
  "thag7.3:2.4": "mi portarono a vedere il Buddha. ",
  "thag7.3:3.1": "“Abbiamo avuto questo figlio con difficoltà. ",
  "thag7.3:3.2": "È delicato e fragile. ",
  "thag7.3:3.3": "Lo offriamo a lei, Signore, ",
  "thag7.3:3.4": "per fare da assistente al vincitore”. ",
  "thag7.3:4.1": "Il Maestro, accettandomi, ",
  "thag7.3:4.2": "dichiarò ad Ānanda: ",
  "thag7.3:4.3": "“Dagli subito i voti, "
}