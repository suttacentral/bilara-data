{
  "thag7.4:0.1": "Versetti dei monaci anziani 7.4 ",
  "thag7.4:0.2": "Il libro dei sette ",
  "thag7.4:0.3": "Capitolo 1 ",
  "thag7.4:0.4": "Sopāka (2°) ",
  "thag7.4:1.1": "Vidi il supremo ",
  "thag7.4:1.2": "camminare consapevolmente all’ombra della terrazza, ",
  "thag7.4:1.3": "così mi avvicinai, ",
  "thag7.4:1.4": "e mi inchinai al supremo fra gli uomini. ",
  "thag7.4:2.1": "Sistemandomi l’abito sulla spalla ",
  "thag7.4:2.2": "e premendo i palmi delle mani, ",
  "thag7.4:2.3": "camminai vicini all’immacolato, ",
  "thag7.4:2.4": "supremo fra tutti gli esseri. ",
  "thag7.4:3.1": "Il saggio, esperto nelle domande, ",
  "thag7.4:3.2": "mi interrogò. ",
  "thag7.4:3.3": "Coraggioso e intrepido, ",
  "thag7.4:3.4": "risposi al Maestro. ",
  "thag7.4:4.1": "Una volta risposta ogni domanda, "
}