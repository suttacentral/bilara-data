{
  "thag2.7:0.1": "Versetti degli anziani 2.7 ",
  "thag2.7:0.2": "Il libro dei due ",
  "thag2.7:0.3": "Capitolo 1 ",
  "thag2.7:0.4": "Rādha ",
  "thag2.7:1.1": "Proprio come la pioggia si infiltra ",
  "thag2.7:1.2": "in una casa mal coperta, ",
  "thag2.7:1.3": "l’avidità si infiltra ",
  "thag2.7:1.4": "in una mente sottosviluppata. ",
  "thag2.7:2.1": "Proprio come la pioggia non si infiltra ",
  "thag2.7:2.2": "in una casa ben coperta, ",
  "thag2.7:2.3": "l’avidità non si infiltra ",
  "thag2.7:2.4": "in una mente ben sviluppata. ",
  "thag2.7:2.5": ""
}