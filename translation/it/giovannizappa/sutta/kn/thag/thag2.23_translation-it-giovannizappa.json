{
  "thag2.23:0.1": "Versetti degli anziani 2.23 ",
  "thag2.23:0.2": "Il libro dei due ",
  "thag2.23:0.3": "Capitolo 3 ",
  "thag2.23:0.4": "Sobhita ",
  "thag2.23:1.1": "Da mendicante, consapevole e saggio, ",
  "thag2.23:1.2": "potente e pieno di energia, ",
  "thag2.23:1.3": "ho ricordato cinquecento ere ",
  "thag2.23:1.4": "in una sola notte. ",
  "thag2.23:2.1": "Sviluppando le quattro basi della consapevolezza, ",
  "thag2.23:2.2": "i sette fattori di risveglio, e l’ottuplice sentiero, ",
  "thag2.23:2.3": "ho ricordato cinquecento ere ",
  "thag2.23:2.4": "in una sola notte. ",
  "thag2.23:2.5": ""
}