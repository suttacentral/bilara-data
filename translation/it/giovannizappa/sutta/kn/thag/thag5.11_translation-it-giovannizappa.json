{
  "thag5.11:0.1": "Versetti dei monaci anziani 5.11 ",
  "thag5.11:0.2": "Il libro dei cinque ",
  "thag5.11:0.3": "Capitolo 1 ",
  "thag5.11:0.4": "Soṇa dalle Orecchie Aguzze ",
  "thag5.11:1.1": "Ho ricevuto l’ordinazione; ",
  "thag5.11:1.2": "sono libero, senza contaminanti; ",
  "thag5.11:1.3": "Ho visto il Beato io stesso, ",
  "thag5.11:1.4": "e sono stato persino con lui. ",
  "thag5.11:2.1": "Il Beato, il maestro, "
}