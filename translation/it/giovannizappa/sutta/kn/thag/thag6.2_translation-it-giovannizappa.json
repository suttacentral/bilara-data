{
  "thag6.2:0.1": "Versetti dei monaci anziani 6.2 ",
  "thag6.2:0.2": "Il libro dei sei ",
  "thag6.2:0.3": "Capitolo 1 ",
  "thag6.2:0.4": "Tekicchakāri ",
  "thag6.2:1.1": "“Il riso è stato raccolto ",
  "thag6.2:1.2": "e radunato per la trebbiatura, ",
  "thag6.2:1.3": "ma non ricevo elemosina! ",
  "thag6.2:1.4": "Come sopravviverò?” ",
  "thag6.2:2.1": "“In fede, richiama alla mente l’immensurabile Buddha! "
}