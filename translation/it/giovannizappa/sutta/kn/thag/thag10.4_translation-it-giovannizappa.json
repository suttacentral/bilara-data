{
  "thag10.4:0.1": "Versetti degli anziani 10.4 ",
  "thag10.4:0.2": "Il libro dei dieci ",
  "thag10.4:0.3": "Capitolo 1 ",
  "thag10.4:0.4": "Cūḷapanthaka ",
  "thag10.4:1.1": "Il mio progresso era lento, ",
  "thag10.4:1.2": "ero detestato in passato. ",
  "thag10.4:1.3": "Persino mio fratello mi mandò via, ",
  "thag10.4:1.4": "dicendo: “Vai a casa, ora”. ",
  "thag10.4:2.1": "Mandato via al cancello ",
  "thag10.4:2.2": "del convento della comunità, ",
  "thag10.4:2.3": "rimasi lì triste, ",
  "thag10.4:2.4": "desiderando la religione. ",
  "thag10.4:3.1": "Poi il Buddha venne ",
  "thag10.4:3.2": "e mi toccò la testa. ",
  "thag10.4:3.3": "Prendendomi per il braccio, ",
  "thag10.4:3.4": "mi portò all’interno del convento. ",
  "thag10.4:4.1": "Il Maestro, per premura, ",
  "thag10.4:4.2": "mi diede un panno per asciugare i piedi, dicendo: ",
  "thag10.4:4.3": "“Concentra la tua attenzione ",
  "thag10.4:4.4": "esclusivamente su questo panno pulito”. ",
  "thag10.4:5.1": "Dopo aver udito le sue parole, ",
  "thag10.4:5.2": "feci volentieri come diceva. ",
  "thag10.4:5.3": "Praticai la concentrazione ",
  "thag10.4:5.4": "per il raggiungimento dell’obiettivo più alto. ",
  "thag10.4:6.1": "Conosco le mie vite passate, ",
  "thag10.4:6.2": "la mia chiaroveggenza è purificata, ",
  "thag10.4:6.3": "Ho raggiunto le tre conoscenze ",
  "thag10.4:6.4": "e completato le istruzioni del Buddha. ",
  "thag10.4:7.1": "Io, Panthaka, creai mille ",
  "thag10.4:7.2": "immagini di me stesso, ",
  "thag10.4:7.3": "e mi sedetti nel delizioso bosco di mango ",
  "thag10.4:7.4": "finché l’ora per l’offerta di cibo fu annunciata. ",
  "thag10.4:8.1": "Allora il Maestro mandò da me ",
  "thag10.4:8.2": "un messaggero per annunciare l’ora. ",
  "thag10.4:8.3": "Una volta annunciata l’ora, ",
  "thag10.4:8.4": "volai da lui nell’aria. ",
  "thag10.4:9.1": "Resi omaggio ai piedi del Maestro, ",
  "thag10.4:9.2": "e mi sedetti a lato. ",
  "thag10.4:9.3": "Quando vide che ero seduto, ",
  "thag10.4:9.4": "il Maestro ricevette l’offerta. ",
  "thag10.4:10.1": "Ricevitore di doni da parte del mondo intero, ",
  "thag10.4:10.2": "ricevitore di sacrifici, ",
  "thag10.4:10.3": "campo di merito per l’umanità, ",
  "thag10.4:10.4": "ricevette l’offerta religiosa. ",
  "thag10.4:10.5": ""
}