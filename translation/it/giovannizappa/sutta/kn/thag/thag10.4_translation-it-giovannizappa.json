{
  "thag10.4:0.1": "Versetti dei monaci anziani 10.4 ",
  "thag10.4:0.2": "Il libro dei dieci ",
  "thag10.4:0.3": "Capitolo 1 ",
  "thag10.4:0.4": "Cūḷapanthaka ",
  "thag10.4:1.1": "Il mio progresso era lento, ",
  "thag10.4:1.2": "ero detestato in passato. ",
  "thag10.4:1.3": "Persino mio fratello mi mandò via, ",
  "thag10.4:1.4": "dicendo: “Vai a casa, ora”. ",
  "thag10.4:2.1": "Mandato via al cancello ",
  "thag10.4:2.2": "del monastero della comunità, ",
  "thag10.4:2.3": "rimasi lì triste, ",
  "thag10.4:2.4": "desiderando la religione. "
}