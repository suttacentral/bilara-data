{
  "thag2.10:0.1": "Versetti degli anziani 2.10 ",
  "thag2.10:0.2": "Il libro dei due ",
  "thag2.10:0.3": "Capitolo 1 ",
  "thag2.10:0.4": "Vasabha ",
  "thag2.10:1.1": "Prima si uccide se stessi, ",
  "thag2.10:1.2": "poi si uccidono gli altri. ",
  "thag2.10:1.3": "Ci si uccide, davvero morti, ",
  "thag2.10:1.4": "come chi uccide un uccello usando un uccello come esca. ",
  "thag2.10:2.1": "Il colore di un santo non è esterno; ",
  "thag2.10:2.2": "il colore di un santo è interno. ",
  "thag2.10:2.3": "Chiunque ospiti peccati dentro sé ",
  "thag2.10:2.4": "è davvero oscuro, Sujampati. ",
