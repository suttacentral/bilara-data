{
  "thag5.7:0.1": "Versetti degli anziani 5.7 ",
  "thag5.7:0.2": "Il libro dei cinque ",
  "thag5.7:0.3": "Capitolo 1 ",
  "thag5.7:0.4": "Gayākassapa ",
  "thag5.7:1.1": "Tre volte al giorno, ",
  "thag5.7:1.2": "al mattino, a mezzogiorno, e la sera, ",
  "thag5.7:1.3": "mi immergevo nell’acqua a Gayā ",
  "thag5.7:1.4": "per il festival di primavera. ",
  "thag5.7:2.1": "“Qualsiasi malvagità abbia compiuto ",
  "thag5.7:2.2": "in vite passate, ",
  "thag5.7:2.3": "ora laverò via proprio qui”, ",
  "thag5.7:2.4": "quella era la mia opinione. ",
  "thag5.7:3.1": "Dopo che udii le parole raffinate, ",
  "thag5.7:3.2": "un passaggio significativo dell’insegnamento, ",
  "thag5.7:3.3": "ho riflettuto in maniera lungimirante ",
  "thag5.7:3.4": "sul vero ed essenziale obiettivo. ",
  "thag5.7:4.1": "Ho lavato via ogni cosa cattiva; ",
  "thag5.7:4.2": "sono senza macchie, pulito, pristino; ",
  "thag5.7:4.3": "il puro erede di colui che è puro, ",
  "thag5.7:4.4": "un figlio legittimo del Buddha. ",
  "thag5.7:5.1": "Nell’immergermi nell’ottuplice ruscello, ",
  "thag5.7:5.2": "ogni cosa cattiva è stata lavata via. ",
  "thag5.7:5.3": "Ho raggiunto le tre conoscenze ",
  "thag5.7:5.4": "e completato le istruzioni del Buddha. ",
  "thag5.7:5.5": ""
}