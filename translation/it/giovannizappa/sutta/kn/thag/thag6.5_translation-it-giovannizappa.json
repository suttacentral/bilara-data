{
  "thag6.5:0.1": "Versetti dei monaci anziani 6.5 ",
  "thag6.5:0.2": "Il libro dei sei ",
  "thag6.5:0.3": "Capitolo 1 ",
  "thag6.5:0.4": "Māluṅkyaputta (1°) ",
  "thag6.5:1.1": "Quando si vive sventatamente, ",
  "thag6.5:1.2": "la sete cresce come una rampicante. ",
  "thag6.5:1.3": "Si salta da vita a vita, come una scimmia ",
  "thag6.5:1.4": "avida di frutti nella foresta. ",
  "thag6.5:2.1": "Chi viene colpito da questa miserabile sete, ",
  "thag6.5:2.2": "questo attaccamento al mondo, ",
  "thag6.5:2.3": "la sua tristezza cresce, "
}