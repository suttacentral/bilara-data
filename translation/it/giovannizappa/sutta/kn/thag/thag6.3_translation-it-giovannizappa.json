{
  "thag6.3:0.1": "Versetti dei monaci anziani 6.3 ",
  "thag6.3:0.2": "Il libro dei sei ",
  "thag6.3:0.3": "Capitolo 1 ",
  "thag6.3:0.4": "Mahānāga ",
  "thag6.3:1.1": "Chi non ha rispetto ",
  "thag6.3:1.2": "per i propri compagni spirituali ",
  "thag6.3:1.3": "cade dal vero insegnamento ",
  "thag6.3:1.4": "come un pesce in una piccola pozzanghera. ",
  "thag6.3:2.1": "Chi non ha rispetto ",
  "thag6.3:2.2": "per i propri compagni spirituali ",
  "thag6.3:2.3": "non prospera nel vero insegnamento ",
  "thag6.3:2.4": "come un seme marcio in un campo. ",
  "thag6.3:3.1": "Chi non ha rispetto ",
  "thag6.3:3.2": "per i propri compagni spirituali ",
  "thag6.3:3.3": "è lontano dall’estinzione, ",
  "thag6.3:3.4": "nella religione del re dell’insegnamento. ",
  "thag6.3:4.1": "Chi ha rispetto ",
  "thag6.3:4.2": "per i propri compagni spirituali "
}