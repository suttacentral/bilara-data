{
  "thag16.2:0.1": "Versetti dei monaci anziani 16.2 ",
  "thag16.2:0.2": "Il libro dei venti ",
  "thag16.2:0.3": "Capitolo 1 ",
  "thag16.2:0.4": "Pārāsariya (2°) ",
  "thag16.2:1.1": "Questo pensiero venne all’asceta, ",
  "thag16.2:1.2": "il monaco Pārāsariya, ",
  "thag16.2:1.3": "mentre sedeva solo, ",
  "thag16.2:1.4": "nell’estasi dell’isolamento: ",
  "thag16.2:2.1": "“Seguendo quale procedura, ",
  "thag16.2:2.2": "che osservanza, che condotta, ",
  "thag16.2:2.3": "si può fare ciò che bisogna fare per se stessi, ",
  "thag16.2:2.4": "senza recare danno agli altri? ",
  "thag16.2:3.1": "Le facoltà degli esseri umani ",
  "thag16.2:3.2": "possono portare sia beneficio che danno. "
}