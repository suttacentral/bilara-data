{
  "thag1.63:0.1": "Versetti degli anziani 1.63 ",
  "thag1.63:0.2": "Il libro degli uno ",
  "thag1.63:0.3": "Capitolo 7 ",
  "thag1.63:0.4": "Pakkha ",
  "thag1.63:1.1": "Cadono, collassati e caduti; ",
  "thag1.63:1.2": "avidi, ritornano. ",
  "thag1.63:1.3": "Il lavoro è compiuto, ora ci si gode la gioia, ",
  "thag1.63:1.4": "la felicità trovata per mezzo della felicità. ",
  "thag1.63:1.5": ""
}