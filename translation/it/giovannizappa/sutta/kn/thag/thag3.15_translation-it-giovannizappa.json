{
  "thag3.15:0.1": "Versetti degli anziani 3.15 ",
  "thag3.15:0.2": "Il libro dei tre ",
  "thag3.15:0.3": "Capitolo 1 ",
  "thag3.15:0.4": "Hārita (2°) ",
  "thag3.15:1.1": "Chi desidera fare dopo ",
  "thag3.15:1.2": "ciò che avrebbe dovuto fare prima ",
  "thag3.15:1.3": "ha perso la causa della felicità, ",
  "thag3.15:1.4": "e dopo viene tormentato da rimpianti. ",
  "thag3.15:2.1": "Dovete dire solo ciò che poi fate; ",
  "thag3.15:2.2": "non dite ciò che poi non fate. ",
  "thag3.15:2.3": "I saggi riconoscono ",
  "thag3.15:2.4": "chi parla senza agire. ",
  "thag3.15:3.1": "Oh! L’estinzione è così felice, ",
  "thag3.15:3.2": "insegnata dal Buddha completamente risvegliato: ",
  "thag3.15:3.3": "senza malinconia, senza macchie, sicura: ",
  "thag3.15:3.4": "dove ogni sofferenza cessa. ",
  "thag3.15:3.5": ""
}