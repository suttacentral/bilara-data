{
  "thag6.4:0.1": "Versetti degli anziani 6.4 ",
  "thag6.4:0.2": "Il libro dei sei ",
  "thag6.4:0.3": "Capitolo 1 ",
  "thag6.4:0.4": "Kulla ",
  "thag6.4:1.1": "Io, Kulla, entrai in un cimitero ",
  "thag6.4:1.2": "e vidi il corpo di una donna abbandonato lì, ",
  "thag6.4:1.3": "scartato nel cimitero, ",
  "thag6.4:1.4": "pieno di vermi che lo divoravano. ",
  "thag6.4:2.1": "“Guarda questo sacco di ossa, Kulla, ",
  "thag6.4:2.2": "malato, disgustoso, marcio, ",
  "thag6.4:2.3": "putrido e gocciolante, ",
  "thag6.4:2.4": "la delizia di uno stolto”. ",
  "thag6.4:3.1": "Prendendo l’insegnamento come specchio ",
  "thag6.4:3.2": "per realizzare conoscenza e visione, ",
  "thag6.4:3.3": "esaminai questo corpo, ",
  "thag6.4:3.4": "vuoto, dentro e fuori. ",
  "thag6.4:4.1": "Come questo è, quello è; ",
  "thag6.4:4.2": "come quello è, questo è. ",
  "thag6.4:4.3": "Come sotto, anche sopra; ",
  "thag6.4:4.4": "come sopra, anche sotto. ",
  "thag6.4:5.1": "Come di giorno, anche di notte; ",
  "thag6.4:5.2": "come di notte, anche di giorno. ",
  "thag6.4:5.3": "Come davanti, anche dietro; ",
  "thag6.4:5.4": "come dietro, anche davanti. ",
  "thag6.4:6.1": "Persino la musica di un quintetto ",
  "thag6.4:6.2": "non può dare tanto piacere ",
  "thag6.4:6.3": "come quando, con mente raccolta, ",
  "thag6.4:6.4": "si discerne l’insegnamento. ",
  "thag6.4:6.5": ""
}