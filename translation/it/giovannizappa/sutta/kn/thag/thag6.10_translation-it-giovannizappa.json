{
  "thag6.10:0.1": "Versetti degli anziani 6.10 ",
  "thag6.10:0.2": "Il libro dei sei ",
  "thag6.10:0.3": "Capitolo 1 ",
  "thag6.10:0.4": "Sumana (2°) ",
  "thag6.10:1.1": "Avevo solo sette anni ",
  "thag6.10:1.2": "e avevo appena lasciato casa ",
  "thag6.10:1.3": "quando sottomisi il potente re dei serpenti ",
  "thag6.10:1.4": "con i miei poteri psichici. ",
  "thag6.10:2.1": "Portai dell’acqua per il mio mentore ",
  "thag6.10:2.2": "dal grande lago Anotatta. ",
  "thag6.10:2.3": "Quando mi vide, ",
  "thag6.10:2.4": "il mio Maestro dichiarò: ",
  "thag6.10:3.1": "“Figlio di Sāri, vedi questo ",
  "thag6.10:3.2": "giovane ragazzo venire, ",
  "thag6.10:3.3": "portando una brocca d’acqua, ",
  "thag6.10:3.4": "concentrato internamente. ",
  "thag6.10:4.1": "Il suo atteggiamento ispira fiducia, ",
  "thag6.10:4.2": "è dal portamento piacevole: ",
  "thag6.10:4.3": "è il novizio di Anuruddha, ",
  "thag6.10:4.4": "maturo nei poteri psichici. ",
  "thag6.10:5.1": "Reso purosangue da un purosangue, ",
  "thag6.10:5.2": "reso buono da un buono, ",
  "thag6.10:5.3": "educato e addestrato da Anuruddha, ",
  "thag6.10:5.4": "che ha completato il proprio compito. ",
  "thag6.10:6.1": "Avendo raggiunto la pace suprema ",
  "thag6.10:6.2": "e visto l’irremovibile, ",
  "thag6.10:6.3": "il novizio Sumana esprime il desiderio: ",
  "thag6.10:6.4": "‘Che nessuno sappia di me!’” ",
  "thag6.10:6.5": ""
}