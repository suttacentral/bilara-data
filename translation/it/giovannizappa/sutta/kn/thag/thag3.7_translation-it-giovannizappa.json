{
  "thag3.7:0.1": "Versetti degli anziani 3.7 ",
  "thag3.7:0.2": "Il libro dei tre ",
  "thag3.7:0.3": "Capitolo 1 ",
  "thag3.7:0.4": "Vāraṇa ",
  "thag3.7:1.1": "Chi tra gli umani ",
  "thag3.7:1.2": "ferisce le altre creature: ",
  "thag3.7:1.3": "quella persona cadrà ",
  "thag3.7:1.4": "sia da questo mondo che dal prossimo. ",
  "thag3.7:2.1": "Ma chi con una mente di amichevolezza, ",
  "thag3.7:2.2": "premuroso per ogni creatura: ",
  "thag3.7:2.3": "una persona così ",
  "thag3.7:2.4": "crea molto merito. ",
  "thag3.7:3.1": "Bisogna allenarsi a seguire buoni consigli, ",
  "thag3.7:3.2": "alla via dell’asceta, ",
  "thag3.7:3.3": "a sedersi soli in posti nascosti, ",
  "thag3.7:3.4": "e a calmare la mente. ",
  "thag3.7:3.5": ""
}