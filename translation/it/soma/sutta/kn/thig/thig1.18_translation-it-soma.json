{
  "thig1.18:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig1.18:0.2": "Capitolo degli Uno ",
  "thig1.18:0.3": "Canto dell’Anziana Saṅghā ",
  "thig1.18:1.1": "“Ho lasciato la casa e ho rinunciato al mondo. ",
  "thig1.18:1.2": "Ho lasciato figlio, armenti e ogni affetto.",
  "thig1.18:1.3": "Ho lasciato passione e avversione.",
  "thig1.18:1.4": "Dissipata l’ignoranza,",
  "thig1.18:1.5": "Ho estirpato l’appetito alla radice: ",
  "thig1.18:1.6": "si è estinta e spenta.” ",
  "thig1.18:2.1": "... L’Anziana Saṅghā ",
  "thig1.18:3.1": "Il Capitolo degli Uno è finito. "
}