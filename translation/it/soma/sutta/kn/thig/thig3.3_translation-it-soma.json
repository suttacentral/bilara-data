{
  "thig3.3:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig3.3:0.2": "Capitolo dei Tre ",
  "thig3.3:0.3": "Canto di un’Altra Anziana Uttamā ",
  "thig3.3:1.1": "“Questi sette fattori del risveglio ",
  "thig3.3:1.2": "sono la via per arrivare al Nibbāna. ",
  "thig3.3:1.3": "Li ho coltivati tutti,",
  "thig3.3:1.4": "così come indicato dal Buddha. ",
  "thig3.3:2.1": "Io accedo, quando voglio,",
  "thig3.3:2.2": "alla vacuità in cui nulla più si afferra.",
  "thig3.3:2.3": "Sono figlia legittima del Buddha, ",
  "thig3.3:2.4": "per sempre consacrata al Nibbāna.",
  "thig3.3:3.1": "Ogni piacere sensuale è stato eradicato ",
  "thig3.3:3.2": "sia divino che umano. ",
  "thig3.3:3.3": "Ho annientato la rinascita in saṁsāra, ",
  "thig3.3:3.4": "adesso non ritornerò più.” ",
  "thig3.3:4.1": "Un’altra Anziana Uttamā "
}