{
  "thig3.4:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig3.4:0.2": "Capitolo dei Tre ",
  "thig3.4:0.3": "Canto dell’Anziana Dantikā ",
  "thig3.4:1.1": "“Lasciata la mia capanna ",
  "thig3.4:1.2": "sulla montagna del Picco dell’Avvoltoio, ",
  "thig3.4:1.3": "vidi un elefante emerso dall’acqua ",
  "thig3.4:1.4": "sulla sponda del fiume. ",
  "thig3.4:2.1": "Un uomo, impugnando un pungolo,",
  "thig3.4:2.2": "gli ordinò: ‘Dammi la zampa.’ ",
  "thig3.4:2.3": "L’elefante gli porse la zampa ",
  "thig3.4:2.4": "e l’uomo lo montò. ",
  "thig3.4:3.1": "Quando vidi l’indomito domato, ",
  "thig3.4:3.2": "sotto il controllo umano, ",
  "thig3.4:3.3": "allora raccolsi il cuore nel Samādhi:",
  "thig3.4:3.4": "per questo andai nella foresta.” ",
  "thig3.4:4.1": "L’Anziana Dantikā "
}