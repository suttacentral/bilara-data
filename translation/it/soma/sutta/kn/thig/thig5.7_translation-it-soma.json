{
  "thig5.7:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig5.7:0.2": "Capitolo dei Cinque ",
  "thig5.7:0.3": "Canto dell’Anziana Sakulā ",
  "thig5.7:1.1": "“Vivevo ancora tra le mure domestiche",
  "thig5.7:1.2": "quando ascoltai il Dhamma da un bhikkhu. ",
  "thig5.7:1.3": "Vidi il candido Dhamma, ",
  "thig5.7:1.4": "la via che porta all’eterno Nibbāna.",
  "thig5.7:2.1": "Lasciai allora figli,",
  "thig5.7:2.2": "ricchezze e poderi.",
  "thig5.7:2.3": "Mi rasai il capo",
  "thig5.7:2.4": "e rinunciai al mondo per non avere più tetto (vagar senza dimora). ",
  "thig5.7:3.1": "Pacifica fu la mia ascesi (addestrandomi nella pace),",
  "thig5.7:3.2": "coltivando il sentiero diretto.",
  "thig5.7:3.3": "Abbandonai passione e avversione ",
  "thig5.7:3.4": "e tutte le altre contaminazioni. ",
  "thig5.7:4.1": "Divenuta una bikkhunī,",
  "thig5.7:4.2": "ricordai le mie vite passate. ",
  "thig5.7:4.3": "Purificai il mio occhio divino",
  "thig5.7:4.4": "ben sviluppato e senza pecche. ",
  "thig5.7:5.1": "Vidi le formazioni come aliene ",
  "thig5.7:5.2": "venute a galla per via di condizioni e soggette al decadimento. ",
  "thig5.7:5.3": "Ho eliminato tutte le influenze ",
  "thig5.7:5.4": "ho raggiunto il refrigerio del Nibbāna. ",
  "thig5.7:6.1": "L’Anziana Sakulā "
}