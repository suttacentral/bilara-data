{
  "thig1.17:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig1.17:0.2": "Capitolo degli Uno ",
  "thig1.17:0.3": "Canto dell’Anziana Dhammā ",
  "thig1.17:1.1": "“In cammino per la questua, ",
  "thig1.17:1.2": "china sul bastone, ",
  "thig1.17:1.3": "mi tremaron le gambe ",
  "thig1.17:1.4": "e caddi proprio lì in terra. ",
  "thig1.17:1.5": "Quando vidi l’insidia nel corpo, ",
  "thig1.17:1.6": "allora la mia mente fu liberata.” ",
  "thig1.17:2.1": "L’Anziana Dhammā "
}