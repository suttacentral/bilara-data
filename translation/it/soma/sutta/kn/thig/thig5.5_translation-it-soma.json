{
  "thig5.5:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig5.5:0.2": "Capitolo dei Cinque ",
  "thig5.5:0.3": "Canto dell’Anziana Nandutturā ",
  "thig5.5:1.1": "“Veneravo il fuoco, la luna, ",
  "thig5.5:1.2": "il sole e gli Dei. ",
  "thig5.5:1.3": "Mi recavo ai guadi sacri",
  "thig5.5:1.4": "per immergermi nelle loro acque. ",
  "thig5.5:2.1": "Votata a severe penitenze,",
  "thig5.5:2.2": "avevo metà del capo rasato,",
  "thig5.5:2.3": "riposavo sulla nuda terra",
  "thig5.5:2.4": "e digiunavo la sera.",
  "thig5.5:3.1": "Eppure, ancora schiava di gioielli e trucchi,",
  "thig5.5:3.2": "tra bagni e unzioni",
  "thig5.5:3.3": "struggendomi nel fuoco dei desideri.",
  "thig5.5:3.4": "struggendomi nel fuoco dei desideri.",
  "thig5.5:4.1": "Poi, trovata la fede,",
  "thig5.5:4.2": "rinunciai al mondo per non avere più tetto.",
  "thig5.5:4.3": "Visto questo corpo nella sua vera natura,",
  "thig5.5:4.4": "sradicai la passione dei sensi.",
  "thig5.5:5.1": "Recise tutte le esistenze,",
  "thig5.5:5.2": "i desideri e le aspirazioni,\n",
  "thig5.5:5.3": "sottratta a ogni giogo, ",
  "thig5.5:5.4": "ho raggiunto la pace della mente.” ",
  "thig5.5:6.1": "L’Anziana Nandutturā "
}