{
  "thig2.8:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig2.8:0.2": "Capitolo dei Due ",
  "thig2.8:0.3": "Canto dell’Anziana Abhayā ",
  "thig2.8:1.1": "“Madre, passa in rassegna il corpo ",
  "thig2.8:1.2": "dalla pianta dei piedi ",
  "thig2.8:1.3": "fino alla sommità della testa, ",
  "thig2.8:1.4": "osservandolo come impuro e fetido. ",
  "thig2.8:2.1": "Dimorando in questo modo, ",
  "thig2.8:2.2": "ho estirpato ogni passione, ",
  "thig2.8:2.3": "eradicato ogni febbre, ",
  "thig2.8:2.4": "sono diventata fresca ed estinta.” ",
  "thig2.8:3.1": "L’Anziana Abhayā "
}