{
  "thig3.1:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig3.1:0.2": "Capitolo dei Tre ",
  "thig3.1:0.3": "Canto di un’Altra Anziana Sāmā ",
  "thig3.1:1.1": "“In venticinque anni ",
  "thig3.1:1.2": "di rinuncia al mondo, ",
  "thig3.1:1.3": "non avevo trovato serenità mentale ",
  "thig3.1:1.4": "nemmeno per un secondo. ",
  "thig3.1:2.1": "Non trovavo pace nel cuore, ",
  "thig3.1:2.2": "ero senza controllo sulla mente. ",
  "thig3.1:2.3": "Poi mi colpì un senso di urgenza, ",
  "thig3.1:2.4": "mentre rammentavo l’insegnamento del Vittorioso. ",
  "thig3.1:3.1": "In mezzo a tanta sofferenza, ",
  "thig3.1:3.2": "appagandomi di sobrietà, ",
  "thig3.1:3.3": "ho ottenuto la distruzione dell’appetito ",
  "thig3.1:3.4": "e completato l’insegnamento del Buddha. ",
  "thig3.1:3.5": "Oggi è la settima notte ",
  "thig3.1:3.6": "da quando l’appetito si è prosciugata.” ",
  "thig3.1:4.1": "Un’altra Anziana Sāmā "
}