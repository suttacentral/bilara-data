{
  "thig1.2:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig1.2:0.2": "Capitolo degli Uno ",
  "thig1.2:0.3": "Canto dell’Anziana Muttā ",
  "thig1.2:1.1": "“Muttā, liberati dai gioghi, ",
  "thig1.2:1.2": "come la luna dalla stretta di Rāhu. ",
  "thig1.2:1.3": "E con una mente libera, ",
  "thig1.2:1.4": "nutriti di offerte senza indebitarti.” ",
  "thig1.2:2.1": "Con questi versi il Buddha esortava spesso l’allieva Muttā. "
}