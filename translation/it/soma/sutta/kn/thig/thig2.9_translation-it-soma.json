{
  "thig2.9:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig2.9:0.2": "Capitolo dei Due ",
  "thig2.9:0.3": "Canto della Madre dell’Anziana Abhayā ",
  "thig2.9:1.1": "“Abhayā, questo corpo si rompe facilmente:",
  "thig2.9:1.2": "la gente del mondo badare a questo. ",
  "thig2.9:1.3": "Metterò giù questo corpo ",
  "thig2.9:1.4": "memore e consapevole. ",
  "thig2.9:2.1": "In mezzo a tanta sofferenza, ",
  "thig2.9:2.2": "mi consacrai alla fermezza.",
  "thig2.9:2.3": "ho ottenuto la distruzione dell’appetito ",
  "thig2.9:2.4": "e completato l’insegnamento del Buddha.” ",
  "thig2.9:3.1": "Madre dell’Anziana Abhayā "
}