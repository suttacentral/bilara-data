{
  "thig1.15:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig1.15:0.2": "Capitolo degli Uno ",
  "thig1.15:0.3": "Canto dell’Anziana Uttarā ",
  "thig1.15:1.1": "“Tenevo a freno ogni mia azione, ",
  "thig1.15:1.2": "parola e pensiero. ",
  "thig1.15:1.3": "Estirpata la sete alla radice, ",
  "thig1.15:1.4": "ho raggiunto il refrigerio del Nibbāna.” ",
  "thig1.15:2.1": "L’Anziana Uttarā "
}