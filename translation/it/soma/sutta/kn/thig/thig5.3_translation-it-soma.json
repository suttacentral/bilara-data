{
  "thig5.3:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig5.3:0.2": "Capitolo dei Cinque ",
  "thig5.3:0.3": "Canto dell’Anziana Sīhā ",
  "thig5.3:1.1": "“Poiché muovevo la mente senza ponderare, ",
  "thig5.3:1.2": "mi struggevo nel fuoco dei desideri.",
  "thig5.3:1.3": "In passato ero irrequieta, ",
  "thig5.3:1.4": "incapace di dominare la mente. ",
  "thig5.3:2.1": "Oppressa dai vizi,",
  "thig5.3:2.2": "rincorrevo tutto ciò che appariva bello",
  "thig5.3:2.3": "Serva delle passioni",
  "thig5.3:2.4": "mai ottenevo la quiete del cuore.",
  "thig5.3:3.1": "Emaciata, pallida e debole, ",
  "thig5.3:3.2": "vagai così per sette anni, ",
  "thig5.3:3.3": "senza mai trovare sollievo né di giorno né di notte, ",
  "thig5.3:3.4": "colma di ogni sofferenza. ",
  "thig5.3:4.1": "Allora afferrai una corda",
  "thig5.3:4.2": "e m’inoltrai nel fitto della foresta. ",
  "thig5.3:4.3": "Meglio impiccarmi qui ",
  "thig5.3:4.4": "che ritornare alla vita profana. ",
  "thig5.3:5.1": "Annodai un cappio stretto",
  "thig5.3:5.2": "al ramo di un albero.",
  "thig5.3:5.3": "Nel momento esatto in cui me lo strinsi al collo,",
  "thig5.3:5.4": "la mia mente fu liberata.” ",
  "thig5.3:6.1": "L’Anziana Sīhā "
}