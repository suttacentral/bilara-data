{
  "thig1.9:0.1": "Canti delle Anziane Bhikkhunī ",
  "thig1.9:0.2": "Capitolo degli Uno ",
  "thig1.9:0.3": "Canto dell’Anziana Bhadrā ",
  "thig1.9:1.1": "“Adesso che per fede hai rinunciato al mondo, ",
  "thig1.9:1.2": "Bhadrā, bada a ciò che è propizio. ",
  "thig1.9:1.3": "Coltiva qualità benefiche, ",
  "thig1.9:1.4": "salvezza suprema dal giogo.” ",
  "thig1.9:2.1": "L’Anziana Bhadrā "
}