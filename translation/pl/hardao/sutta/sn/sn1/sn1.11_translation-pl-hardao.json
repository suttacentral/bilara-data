  "sn1.11:0.1": "Zbiór połączonych mów - 1",
  "sn1.11:0.2": "Rozdział w Nandanie",
  "sn1.11:0.3": "Mowa o Nandanie",
  "sn1.11:1.1": "Oto com usłyszał – ",
  "sn1.11:1.2": "pewnego razu Błogosławiony przebywał niedaleko miasta Sāvatthi w klasztorze Anāthapiṇḍiki w gaju Jety. ",
  "sn1.11:1.3": "Tam Błogosławiony zwrócił się do mnichów: ",
  "sn1.11:1.4": "„Mnisi”. ",
  "sn1.11:1.5": "„Bhadante”, mnisi ci posłyszeli Błogosławionego. ",
