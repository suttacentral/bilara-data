{
  "sn1.15:0.1": "Zbiór połączonych mów - 1",
  "sn1.15:0.2": "Rozdział w Nandanie",
  "sn1.15:0.3": "Mowa o szumie",
  "sn1.15:1.1": "„Gdy pora południa nastała,",
  "sn1.15:1.2": "a ptaki już przysiadły,",
  "sn1.15:1.3": "szumi już tylko wielka knieja –",
  "sn1.15:1.4": "jako bojaźń mi się to jawi”.",
  "sn1.15:2.1": "„Gdy pora południa nastaje,",
  "sn1.15:2.2": "a ptaki już przysiadły,",
  "sn1.15:2.3": "i szumią wielkie knieje –",
  "sn1.15:2.4": "jako rozkosz mi się to jawi”."
}