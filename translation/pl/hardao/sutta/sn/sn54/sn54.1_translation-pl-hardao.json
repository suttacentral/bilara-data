{
  "sn54.1:0.1": "Zbiór połączonych mów - 54 ",
  "sn54.1:0.2": "Rozdział o jednej rzeczy ",
  "sn54.1:0.3": "Mowa o pojedynczej jakości ",
  "sn54.1:1.1": "Stało się w Sāvatthi. ",
