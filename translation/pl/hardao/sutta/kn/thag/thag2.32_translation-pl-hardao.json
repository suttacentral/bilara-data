{
  "thag2.32:0.2": "Zbiór par ",
  "thag2.32:0.3": "Czwarty rozdział ",
  "thag2.32:0.4": "Wersy Starszego Sivaki ",
  "thag2.32:1.1": "Nietrwałe są domy, ",
  "thag2.32:1.2": "kolejny i następny, wciąż od nowa. ",
  "thag2.32:1.3": "Budowniczego domu poszukiwałem, ",
  "thag2.32:1.4": "a wciąż tylko krzywdę z odrodzin miałem. ",
  "thag2.32:2.1": "Budowniczy domu! Dostrzeżonyś! ",
  "thag2.32:2.2": "Nowej konstrukcji już nie postawisz! ",
  "thag2.32:2.3": "Wszystkie twe krokwie połamane, ",
  "thag2.32:2.4": "dachówki popękane. ",
  "thag2.32:2.5": "umysł wyzwolił się poza ograniczenia, ",
  "thag2.32:2.6": "w tym życiu będzie zdmuchnięty. ",
  "thag2.32:2.7": "Starszy Sivaka "
}