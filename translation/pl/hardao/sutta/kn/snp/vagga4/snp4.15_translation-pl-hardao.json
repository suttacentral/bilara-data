{
  "snp4.15:0.1": "Kolekcja mów 4.15 ",
  "snp4.15:0.2": "Mowa o uzbrajaniu się ",
  "snp4.15:1.1": "",
  "snp4.15:1.2": "",
  "snp4.15:1.3": "",
  "snp4.15:1.4": "",
  "snp4.15:2.1": "Zobaczyłem wijącą się ludzkość, ",
  "snp4.15:2.2": "Jak ryby w małej ilości wody, ",
  "snp4.15:2.3": "Jedna drugiej sprawiająca trudność, ",
  "snp4.15:2.4": "Dostrzegłszy to, strachem byłem ogarniony. ",
  "snp4.15:3.1": "Świat jakiejkolwiek substancji pozbawiony, ",
  "snp4.15:3.2": "We wszystkich kierunkach pogmatwany. ",
  "snp4.15:3.3": "Chcąc zbudować coś dla siebie samego, ",
  "snp4.15:3.4": "Nic nie dostrzegłem nieosiedlonego. ",
  "snp4.15:4.1": "Ale nawet gdy się osiedlili, trudności sobie robili, ",
  "snp4.15:4.2": "Dostrzegłszy to, stałem się niezadowolony. ",
  "snp4.15:4.3": "Wtedy też na tę strzałę padło me spojrzenie, ",
  "snp4.15:4.4": "Ledwo widoczną, w sercu osadzoną. ",
  "snp4.15:5.1": "Ktoś przez tę strzałę usidlony, ",
  "snp4.15:5.2": "Ucieka w popłochu we wszystkie strony, ",
  "snp4.15:5.3": "Ale ze strzałą wyciągniętą ",
  "snp4.15:5.4": "Nie biega, nie jest pogrążony. ",
