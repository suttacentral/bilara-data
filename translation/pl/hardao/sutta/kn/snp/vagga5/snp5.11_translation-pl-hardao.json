{
  "snp5.11:0.1": "",
  "snp5.11:0.2": "",
  "snp5.11:1.1": "Dla stojących pośrodku jeziora,",
  "snp5.11:1.2": "(tak rzekł czcigodny Kappa),",
  "snp5.11:1.3": "wielka to bojaźń, gdy powódź zrodzona",
  "snp5.11:1.4": "dla ogarniętych starością i śmiercią,",
  "snp5.11:1.5": "opisz wyspę, Czcigodny Panie.",
  "snp5.11:1.6": "Opowiedz mi o tej wyspie,",
  "snp5.11:1.7": "tak, by nic ponad nią już nie było.",
  "snp5.11:2.1": "Dla stojących pośrodku jeziora,",
  "snp5.11:2.2": "(Błogosławiony rzekł do Kappy)",
  "snp5.11:2.3": "wielka to bojaźń, gdy powódź zrodzona",
  "snp5.11:2.4": "dla ogarniętych starością i śmiercią,",
  "snp5.11:2.5": "",
  "snp5.11:3.1": "Bez niczego, bez trzymania żadnego, ",
  "snp5.11:3.2": "tę oto wyspę nie przewyższa już nic innego,",
  "snp5.11:3.3": "Nibbāną ją nazywam,",
  "snp5.11:3.4": "zniszczenia starości i śmierci całkowitego.",
  "snp5.11:4.1": "Ci, którzy pojęli, pomni,",
  "snp5.11:4.2": "",
  "snp5.11:4.3": "nie idą w ślad za władzą Māry,",
  "snp5.11:4.4": "",
  "snp5.11:4.5": ""
}