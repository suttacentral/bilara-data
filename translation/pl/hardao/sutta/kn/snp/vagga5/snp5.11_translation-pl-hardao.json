  "snp5.11:1.1": "Dla stojących pośrodku jeziora,",
  "snp5.11:1.2": "(tak rzekł czcigodny Kappa),",
  "snp5.11:1.3": "wielka to bojaźń, gdy powódź zrodzona",
  "snp5.11:1.4": "dla ogarniętych starością i śmiercią,",
  "snp5.11:1.5": "opisz wyspę, Czcigodny Panie;",
  "snp5.11:1.6": "Opowiedz mi o tej wyspie,",
  "snp5.11:1.7": "tak, by nic ponad nią już nie było.",
  "snp5.11:2.1": "Dla stojących pośrodku jeziora,",
  "snp5.11:2.2": "(Błogosławiony rzekł do Kappy)",
