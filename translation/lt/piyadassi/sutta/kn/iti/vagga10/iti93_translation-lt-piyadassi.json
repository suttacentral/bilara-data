{
  "iti93:0.1": "Taip bylota 93 ",
  "iti93:0.2": "Trejetukų knyga ",
  "iti93:0.3": "Penktasis skyrius ",
  "iti93:0.4": "Ugnis ",
  "iti93:1.1": "Aš girdėjau, kad taip tikrai bylojo Palaimintasis, taip bylojo _Arahantas_: ",
  "iti93:2.1": "„Esti, vienuoliai, šios trys ugnys. ",
  "iti93:2.2": "Kokios trys? ",
  "iti93:2.3": "Aistros ugnis, neapykantos ugnis, paklydimo ugnis. ",
  "iti93:2.4": "Šios yra trys ugnys.” ",
  "iti93:2.5": "Apie tai Palaimintasis kalbėjo. ",
  "iti93:2.6": "Taip pasakyta apie tai: ",
  "iti93:3.1": "„Aistros ugnis degina mirtinguosius, ",
  "iti93:3.2": "besidžiaugiančius jusliniais malonumais gobšuolius. ",
  "iti93:3.3": "Neapykantos ugnis – piktanorius ",
  "iti93:3.4": "žudančius žmones. ",
  "iti93:4.1": "Paklydimo ugnis – paklydelius ",
  "iti93:4.2": "nenusimanančius apie tauriųjų mokymą. ",
  "iti93:4.3": "Nežinodama šių trijų ugnių ",
  "iti93:4.4": "liaudis mėgaujasi įsikūnijimu. ",
  "iti93:5.1": "Jie prisideda prie auginimo pragaro, ",
  "iti93:5.2": "gyvūnų pasaulio, ",
  "iti93:5.3": "_asur_ų ir dvasių, ",
  "iti93:5.4": "būdami nelaisvi, mirties pančiuose. "
}