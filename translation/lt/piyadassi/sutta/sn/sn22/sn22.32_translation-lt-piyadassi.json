{
  "sn22.32:0.1": "Pagal temą susijusių suttų rinkinys 22 ",
  "sn22.32:0.2": "3. Našta ",
  "sn22.32:0.3": "32. Trapu",
  "sn22.32:1.1": "_Savatth_yje. ",
