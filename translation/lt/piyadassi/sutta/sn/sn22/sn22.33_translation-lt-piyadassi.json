{
  "sn22.33:0.1": "Pagal temą susijusių suttų rinkinys 22 ",
  "sn22.33:0.2": "4. Ne jūsų",
  "sn22.33:0.3": "33. Ne jūsų",
  "sn22.33:1.1": "_Savatth_yje. ",
  "sn22.33:1.2": "„Vienuoliai, palikite tai, kas nėra jūsų.",
  "sn22.33:1.3": "To palikimas jums neš naudą ir laimę. ",
  "sn22.33:1.4": "Ir kas, vienuoliai, nėra jūsų?",
  "sn22.33:1.5": "Materiali forma, vienuoliai, nėra jūsų – palikite ją.",
  "sn22.33:1.6": "Jos palikimas jums neš naudą ir laimę. ",
  "sn22.33:1.7": "Jausmo tonas, vienuoliai, nėra jūsų – palikite jį.",
