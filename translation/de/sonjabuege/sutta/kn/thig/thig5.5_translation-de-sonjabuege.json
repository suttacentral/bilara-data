{
  "thig5.5:0.1": "Strophen der Therī  5.5 ",
  "thig5.5:0.2": "Das Fünferbuch ",
  "thig5.5:0.3": "Die Strophen der Therī Nanduttarā ",
  "thig5.5:1.1": "Das Feuer, den Mond und die Sonne, ",
  "thig5.5:1.2": "auch die Götter verehrte ich, ",
  "thig5.5:1.3": "zum Flußufer ging ich, ",
  "thig5.5:1.4": "stieg zum Wasser hinab. "
}