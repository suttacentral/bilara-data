{
  "thig3.1:0.1": "Strophen der altehrwürdigen Nonnen ",
  "thig3.1:0.2": "Das Dreierbuch ",
  "thig3.1:0.3": "Die Verse einer weiteren Therī Sāmā ",
  "thig3.1:1.1": "Seit ich vor fünfundzwanzig Jahren in die Hauslosigkeit zog, ",
  "thig3.1:1.2": "kann ich mich nicht entsinnen, ",
  "thig3.1:1.3": "jemals ein Zur-Ruhe-Kommen ",
  "thig3.1:1.4": "des Geistes erreicht zu haben. ",
  "thig3.1:2.1": "Die Ruhe des Geistes unerreicht, ",
  "thig3.1:2.2": "ohne Selbstkontrolle im Geist, ",
  "thig3.1:2.3": "wurde ich da wachgerüttelt "
}