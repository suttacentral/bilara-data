{
  "thig6.6:0.1": "Strophen der Therī 6.6 ",
  "thig6.6:0.2": "Das Sechserbuch ",
  "thig6.6:0.3": "Die Strophen der Therī Mahāpajāpatigotamī ",
  "thig6.6:1.1": "Ehre soll (dir) sein, Buddha, Heldenhafter, ",
  "thig6.6:1.2": "von allen Lebenden der Edelste, ",
  "thig6.6:1.3": "der mich, so wie viele andere, ",
  "thig6.6:1.4": "vom Leiden erlöste. "
}