{
  "thig2.8:0.1": "Strophen der Therī ",
  "thig2.8:0.2": "Das Zweierbuch ",
  "thig2.8:0.3": "Abhayā ",
  "thig2.8:1.1": "Von den Fußsohlen aufsteigend, Mutter, ",
  "thig2.8:1.2": "dann vom Scheitel herab, ",
  "thig2.8:1.3": "betrachte stets den Körper ",
  "thig2.8:1.4": "als unrein, faulig stinkend. ",
  "thig2.8:2.1": "Für eine, die in diesem Zustand ist, ",
  "thig2.8:2.2": "ist jede Begierde vergangen. ",
  "thig2.8:2.3": "Ich, deren Feuer erloschen ist, ",
  "thig2.8:2.4": "bin zur Ruhe gekommen. "
}