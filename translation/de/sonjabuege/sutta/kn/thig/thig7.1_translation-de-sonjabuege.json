{
  "thig7.1:0.1": "Strophen der Therī 7.1 ",
  "thig7.1:0.2": "Das Siebenerbuch ",
  "thig7.1:0.3": "Die Strophen der Therī Uttarā ",
  "thig7.1:1.1": "Die Stößel ergreifend, ",
  "thig7.1:1.2": "mahlen die jungen Männer das Getreide. ",
  "thig7.1:1.3": "Die jungen Männer versorgen die Kinder und Frauen, ",
  "thig7.1:1.4": "kommen zu Wohlstand. ",
  "thig7.1:2.1": "Bemüht euch um die Lehre des Buddha, ",
  "thig7.1:2.2": "wer sie praktiziert, bereut es nicht. ",
  "thig7.1:2.3": "Reinigt schnell die Füße ",
  "thig7.1:2.4": "und setzt euch zur Seite. ",
  "thig7.1:3.1": "Wenn der Geist konzentriert, ",
  "thig7.1:3.2": "gut beherrscht, gefestigt ist, ",
  "thig7.1:3.3": "betrachte man die Geistesbildungen ",
  "thig7.1:3.4": "als fremd und nicht als Selbst. ",
  "thig7.1:4.1": "Als ich diese Worte gehört hatte, ",
  "thig7.1:4.2": "die Anweisung von Paṭācārā, ",
  "thig7.1:4.3": "reinigte ich die Füße, ",
  "thig7.1:4.4": "setzte mich zur Seite. ",
  "thig7.1:5.1": "Im ersten Drittel der Nacht ",
  "thig7.1:5.2": "erinnerte ich mich früherer Geburten. ",
  "thig7.1:5.3": "Im mittleren Drittel der Nacht "
}