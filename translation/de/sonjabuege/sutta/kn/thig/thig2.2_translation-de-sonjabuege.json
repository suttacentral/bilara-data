{
  "thig2.2:0.1": "Die Strophen der altehrwürdigen Nonnen 2.2 ",
  "thig2.2:0.2": "Das Zweierbuch ",
  "thig2.2:0.3": "Die Verse der Therī Jentā ",
  "thig2.2:1.1": "Die sieben Erweckungsfaktoren sind ",
  "thig2.2:1.2": "die Wege, die zum Nibbāna führen. ",
  "thig2.2:1.3": "Sie alle wurden von mir entwickelt, ",
  "thig2.2:1.4": "so wie vom Erhabenen gelehrt. ",
  "thig2.2:2.1": "Ich habe den Erhabenen gesehen, "
}