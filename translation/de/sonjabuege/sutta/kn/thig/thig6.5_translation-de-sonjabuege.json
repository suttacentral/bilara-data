{
  "thig6.5:0.1": "Strophen der Therī 6.5 ",
  "thig6.5:0.2": "Das Sechserbuch ",
  "thig6.5:0.3": "Die Strophen der Therī Anopamā ",
  "thig6.5:1.1": "In eine noble Familie geboren, ",
  "thig6.5:1.2": "mit viel Reichtum und Vermögen, ",
  "thig6.5:1.3": "war ich hier, die Tochter von Majjha, ",
  "thig6.5:1.4": "versehen mit Schönheit und Charme. ",
  "thig6.5:2.1": "Hofiert (war ich) von Königssöhnen, ",
  "thig6.5:2.2": "von Millionärssöhnen umworben. ",
  "thig6.5:2.3": "Meinem Vater wurde ein Bote entsandt: ",
  "thig6.5:2.4": "„Gebt mir Anopamā!\" "
}