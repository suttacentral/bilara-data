{
  "thig6.8:0.1": "Strophen der Therī 6.8 ",
  "thig6.8:0.2": "Das Sechserbuch ",
  "thig6.8:0.3": "Die Strophen der Therī Vijayā ",
  "thig6.8:1.1": "Vier- oder fünfmal schon ",
  "thig6.8:1.2": "verließ ich meine Hütte, ",
  "thig6.8:1.3": "den Herzensfrieden unerreicht, ",
  "thig6.8:1.4": "ohne Kontrolle über den Geist. ",
  "thig6.8:2.1": "Da ging ich hin zu einer Nonne, ",
  "thig6.8:2.2": "befragte (sie) respektvoll. ",
  "thig6.8:2.3": "Sie lehrte mich den Dhamma, ",
  "thig6.8:2.4": "die Elemente und die Sinnesorgane, ",
  "thig6.8:3.1": "die Vier Edlen Wahrheiten, ",
  "thig6.8:3.2": "die Fähigkeiten und Kräfte, ",
  "thig6.8:3.3": "die Erwachungsglieder und den Achtfachen Weg, ",
  "thig6.8:3.4": "um das höchste Ziel zu erreichen. ",
  "thig6.8:4.1": "Nachdem ich ihre Worte gehört hatte, ",
  "thig6.8:4.2": "führte ich ihre Anweisung aus. "
}