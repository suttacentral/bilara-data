{
  "thig2.10:0.1": "Strophen der altehrwürdigen Nonnen 2.10 ",
  "thig2.10:0.2": "Das Zweierbuch ",
  "thig2.10:0.3": "Die Verse der Therī Sāmā ",
  "thig2.10:1.1": "Vier oder fünfmal ",
  "thig2.10:1.2": "verließ ich die Häuslichkeit, ",
  "thig2.10:1.3": "Für mich ist dies nun die achte Nacht. ",
  "thig2.10:1.4": "in der der Durst verlöscht ist. "
}