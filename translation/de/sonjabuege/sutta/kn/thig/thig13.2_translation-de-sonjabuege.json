{
  "thig13.2:0.1": "Strophen der Therī 13.2 ",
  "thig13.2:0.2": "Das Zwanzigerbuch ",
  "thig13.2:0.3": "Die Strophen der Therī Rohinī ",
  "thig13.2:1.1": "„Asket“ träumst du, Liebes, beim Schlafen, ",
  "thig13.2:1.2": "„Asket“ denkst du beim Aufwachen. ",
  "thig13.2:1.3": "Du lobst nur die Asketen. ",
  "thig13.2:1.4": "Eine Asketin wirst du gewiss. ",
  "thig13.2:2.1": "Du gibst Asketen reichlich ",
  "thig13.2:2.2": "Speise und Trank. ",
  "thig13.2:2.3": "Rohinī, nun frage ich dich, ",
  "thig13.2:2.4": "warum sind dir Asketen lieb? ",
  "thig13.2:3.1": "Sie mögen nicht arbeiten, sind untätig, ",
  "thig13.2:3.2": "ernähren sich von den Spenden anderer, ",
  "thig13.2:3.3": "erhoffen ständig leckere Speisen. "
}