{
  "thig2.5:0.1": "Strophen der altehrwürdigen Nonnen 2.5 ",
  "thig2.5:0.2": "Das Zweierbuch ",
  "thig2.5:0.3": "Die Strophen der Therī Cittā ",
  "thig2.5:1.1": "Obwohl ich abgezehrt bin, ",
  "thig2.5:1.2": "krank und äußerst kraftlos, ",
  "thig2.5:1.3": "gehe ich auf einen Stock gestützt ",
  "thig2.5:1.4": "den Berg hinauf. ",
  "thig2.5:2.1": "Die äußere Robe abgelegt habend, ",
  "thig2.5:2.2": "und die Bettelschale umgedreht war, ",
  "thig2.5:2.3": "Mein Selbst an den Felsen gestützt, ",
  "thig2.5:2.4": "zersprengte ich die Aggregate der Verblendung. "
}