{
  "thig8.1:0.1": "Strophen der Therī 8.1 ",
  "thig8.1:0.2": "Das Achterbuch ",
  "thig8.1:0.3": "Die Strophen der Therī Sīsūpacālā ",
  "thig8.1:1.1": "Eine Bhikkhunī, die tugendhaft ist, ",
  "thig8.1:1.2": "in den Sinnesfähigkeiten gut beherrscht, ",
