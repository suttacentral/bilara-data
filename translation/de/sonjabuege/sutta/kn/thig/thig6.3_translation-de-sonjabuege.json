{
  "thig6.3:0.1": "Lieder der Therī 6.3 ",
  "thig6.3:0.2": "Das Sechserbuch ",
  "thig6.3:0.3": "Die Strophen der Therī Khemā ",
  "thig6.3:1.1": "Jung bist du und schön, ",
  "thig6.3:1.2": "ich bin ein junger Mann. ",
  "thig6.3:1.3": "Komm, Khemā, lass uns ",
  "thig6.3:1.4": "bei viel-instrumentiger Musik genießen. ",
  "thig6.3:2.1": "Da dieser faulige Körper, ",
  "thig6.3:2.2": "krank und schwach, ",
  "thig6.3:2.3": "mich ekelt und beschämt, ",
  "thig6.3:2.4": "ist Sinnesdurst ganz ausgemerzt. ",
  "thig6.3:3.1": "Sinnesbegierden sind wie Schwerter und Speere, ",
  "thig6.3:3.2": "sie sind für die Khandas der Henker’s Block. ",
  "thig6.3:3.3": "Was du hier „Sinnesfreuden“ nennst, ",
  "thig6.3:3.4": "für mich sind sie das Gegenteil. ",
  "thig6.3:4.1": "Vernichtet aller sinnlicher Genuß, ",
  "thig6.3:4.2": "die Masse der Finsternis ist zerschlagen. ",
  "thig6.3:4.3": "So wisse denn, du Übeltäter, "
}