{
  "thig5.7:0.1": "Strophen der Therī 5.7 ",
  "thig5.7:0.2": "Das Fünferbuch ",
  "thig5.7:0.3": "Die Strophen der Therī Sakulā ",
  "thig5.7:1.1": "Das häusliche Leben lebte ich, ",
  "thig5.7:1.2": "als ich die Lehre eines Bhikkhu hörte. ",
  "thig5.7:1.3": "Ich sah den unbefleckten Dhamma, ",
  "thig5.7:1.4": "den unerschütterlichen Weg zum Nibbāna. ",
  "thig5.7:2.1": "Ich, die ich die eigenen Kinder, ",
  "thig5.7:2.2": "verschmäht, "
}