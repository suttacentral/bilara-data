{
  "thig13.5:0.1": "Strophen der Therī 13.5 ",
  "thig13.5:0.2": "Das Zwanzigerbuch ",
  "thig13.5:0.3": "Die Strophen der Therī Subhākammāradhītu ",
  "thig13.5:1.1": "Ein junges Mädchen war ich, weiß gekleidet, ",
  "thig13.5:1.2": "als ich den Dhamma hörte. ",
  "thig13.5:1.3": "Darauf empfand ich starken Widerwillen ",
  "thig13.5:1.4": "kam das volle Verständnis der Wahrheit. ",
  "thig13.5:2.1": "Ich verließ die Familie, ",
  "thig13.5:2.2": "Sklaven und Arbeiter, "
}