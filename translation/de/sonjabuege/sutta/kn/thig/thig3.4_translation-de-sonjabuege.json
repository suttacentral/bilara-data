{
  "thig3.4:0.1": "Strophen der altehrwürdigen Nonnen 3.4 ",
  "thig3.4:0.2": "Das Dreierbuch ",
  "thig3.4:0.3": "Die Verse der Therī Dantikā ",
  "thig3.4:1.1": "Als ich meinen Meditationsplatz ",
  "thig3.4:1.2": "am Geierhügelberge verließ, ",
  "thig3.4:1.3": "sah ich einen Elefanten, der ",
  "thig3.4:1.4": "vom Bade am Ufer heraufstieg. ",
  "thig3.4:2.1": "Ein Mann ergriff den Elefantenhaken und ",
  "thig3.4:2.2": "befahl: Heb deinen Fuß! ",
  "thig3.4:2.3": "Der Elefant streckte den Fuß aus, "
}