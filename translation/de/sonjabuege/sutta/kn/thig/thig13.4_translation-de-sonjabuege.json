{
  "thig13.4:0.1": "Strophen der Therī 13.4 ",
  "thig13.4:0.2": "Das Zwanzigerbuch ",
  "thig13.4:0.3": "Die Strophen der Therī Sundarī ",
  "thig13.4:1.1": "Liebe Dame, als vormals die Totengeister ",
  "thig13.4:1.2": "deine Kinder gefressen haben, ",
  "thig13.4:1.3": "deine Kinder verschlungen haben, ",
  "thig13.4:1.4": "hast du Tag und Nacht schlimm gelitten. ",
  "thig13.4:2.1": "Nachdem jetzt alle hundert Kinder ",
  "thig13.4:2.2": "verschlungen wurden, Brāhmaṇin, ",
  "thig13.4:2.3": "aus welchem Grund, Vāseṭṭhi, "
}