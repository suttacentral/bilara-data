{
  "thig13.4:0.1": "Strophen der Therī 13.4 ",
  "thig13.4:0.2": "Das Zwanzigerbuch ",
  "thig13.4:0.3": "Die Strophen der Therī Sundarī ",
  "thig13.4:1.1": "Liebe Dame, als vormals die Totengeister ",
  "thig13.4:1.2": "deine Kinder gefressen haben, ",
  "thig13.4:1.3": "hast du bei Tag und bei Nacht ",
  "thig13.4:1.4": "zutiefst getrauert. ",
  "thig13.4:2.1": "Nachdem jetzt alle sieben Kinder ",
  "thig13.4:2.2": "gefressen wurden, Brahmanin, ",
  "thig13.4:2.3": "was ist der Grund, Vāseṭṭhi, ",
  "thig13.4:2.4": "dass du nicht mehr so tief trauerst?\" ",
  "thig13.4:3.1": "\"Viele hundert Söhne ",
  "thig13.4:3.2": "und Verwandte, Brahmanin, ",
  "thig13.4:3.3": "und Verwandte, Brahmane, ",
  "thig13.4:3.4": "deine und meine, "
}