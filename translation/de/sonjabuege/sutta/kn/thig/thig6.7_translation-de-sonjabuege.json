{
  "thig6.7:0.1": "Strophen der Therī 6.7 ",
  "thig6.7:0.2": "Das Sechserbuch ",
  "thig6.7:0.3": "Die Strophen der Therī Guttā ",
  "thig6.7:1.1": "Guttā, warum bist du ins Asketenleben gezogen? ",
  "thig6.7:1.2": "Kind, Reichtum, Liebes hast du verlassen. ",
  "thig6.7:1.3": "Praktiziere genau in diesem Sinne, ",
  "thig6.7:1.4": "lass dich nicht von momentanen Gedanken leiten. ",
  "thig6.7:2.1": "Durch Gedanken getäuschte Wesen ",
  "thig6.7:2.2": "vergnügen sich in Māra’s Reich. ",
  "thig6.7:2.3": "Zahllose Kreisläufe der Geburten ",
  "thig6.7:2.4": "durchwandern die Narren. ",
  "thig6.7:3.1": "Sinnliche Lust und Böswilligkeit, ",
  "thig6.7:3.2": "ebenso Persönlichkeitsglaube, ",
  "thig6.7:3.3": "Anhaftung an Regeln und Ritualen, ",
  "thig6.7:3.4": "Zweifelsucht als fünftes: "
}