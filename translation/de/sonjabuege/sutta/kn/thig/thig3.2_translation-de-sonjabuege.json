{
  "thig3.2:0.1": "Strophen der altehrwürdigen Nonnen ",
  "thig3.2:0.2": "Das Dreierbuch ",
  "thig3.2:0.3": "Die Verse der Therī Uttamā ",
  "thig3.2:1.1": "Vier- oder fünfmal schon ",
  "thig3.2:1.2": "verließ ich meine Hütte, ",
  "thig3.2:1.3": "den Herzensfrieden unerreicht, ",
  "thig3.2:1.4": "ohne Kontrolle über den Geist. ",
  "thig3.2:2.1": "Da ging ich hin zu einer Nonne, ",
  "thig3.2:2.2": "zu der ich Vertrauen hatte. ",
  "thig3.2:2.3": "ie lehrte mich den Dhamma, ",
  "thig3.2:2.4": "die Aggregate, Sinnesbereiche und die Elemente. "
}