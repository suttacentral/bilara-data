{
  "thig11.1:0.1": "Strophen der Therī ",
  "thig11.1:0.2": "Das Zwölferbuch ",
  "thig11.1:0.3": "Die Strophen der Therī Uppalavaṇṇā ",
  "thig11.1:1.1": "Wir beide, Mutter und Tochter, ",
  "thig11.1:1.2": "hatten einen gemeinsamen Ehemann! ",
  "thig11.1:1.3": "Mich überkam so ein Entsetzen, ",
  "thig11.1:1.4": "dass mir die Haare zu Berge standen. ",
  "thig11.1:2.1": "Schande über diese unreinen, "
}