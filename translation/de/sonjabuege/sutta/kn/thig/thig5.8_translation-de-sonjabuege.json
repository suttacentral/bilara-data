{
  "thig5.8:0.1": "Strophen der Therī 5.8 ",
  "thig5.8:0.2": "Das Fünferbuch ",
  "thig5.8:0.3": "Die Strophen der Therī Soṇā ",
  "thig5.8:1.1": "Nachdem ich zehn Kinder geboren habe, ",
  "thig5.8:1.2": "aus dieser Körpermasse, ",
  "thig5.8:1.3": "wurde ich schwach und alt. ",
  "thig5.8:1.4": "Da ging ich zu einer Bhikkhuni. "
}