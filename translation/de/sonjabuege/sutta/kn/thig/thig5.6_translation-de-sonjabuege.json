{
  "thig5.6:0.1": "Strophen der Therī 5.6 ",
  "thig5.6:0.2": "Das Fünferbuch ",
  "thig5.6:0.3": "Die Strophen der Therī Mittākāḷī ",
  "thig5.6:1.1": "Vertrauensvoll zog ich hinaus ",
  "thig5.6:1.2": "aus der Häuslichkeit in die Hauslosigkeit. ",
  "thig5.6:1.3": "Ich wanderte hier und da herum, ",
  "thig5.6:1.4": "nach Gewinn und Ehre strebend. ",
  "thig5.6:2.1": "Das höchste Ziel vernachlässigend, ",
  "thig5.6:2.2": "diente ich nur dem niederen. ",
  "thig5.6:2.3": "Der unreinen Lust ging ich nach, "
}