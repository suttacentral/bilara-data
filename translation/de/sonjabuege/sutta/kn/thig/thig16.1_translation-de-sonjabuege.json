{
  "thig16.1:0.1": "Strophen der Therī 16.1 ",
  "thig16.1:0.2": "Das große Buch ",
  "thig16.1:0.3": "Die Strophen der Therī Sumedhā ",
  "thig16.1:1.1": "In der Stadt Mantāvatī ",
  "thig16.1:1.2": "hatte König Koñca’s erste Gattin ",
  "thig16.1:1.3": "eine Tochter, Sumedhā, ",
  "thig16.1:1.4": "die durch die Lehre [des Buddha] zu Frieden gekommen war. ",
  "thig16.1:2.1": "Tugendhaft, eine gute Rednerin, hochgebildet, ",
  "thig16.1:2.2": "war sie in der Buddhalehre geschult. "
}