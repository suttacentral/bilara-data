{
  "snp3.2:0.1": "Lehrreden-Sammelband 3.2 ",
  "snp3.2:0.2": "Streben ",
  "snp3.2:1.1": "„Während der Zeit meines entschlossenen Strebens, ",
  "snp3.2:1.2": "damals am Ufer des Flusses Nerañjara, ",
  "snp3.2:1.3": "meditierte ich sehr angestrengt ",
  "snp3.2:1.4": "um ein Refugium vor dem Joch zu finden. ",
  "snp3.2:2.1": "Namucī näherte sich ",
  "snp3.2:2.2": "und sprach mitfühlende Worte: ",
  "snp3.2:2.3": "‚Du bist dünn, von schlechter Farbe, ",
  "snp3.2:2.4": "an der Schwelle des Todes. ",
  "snp3.2:3.1": "Der Tod hat tausend Teile von dir, ",
  "snp3.2:3.2": "ein Bruchteil bleibt dem Leben. ",
  "snp3.2:3.3": "Lebe, werter Herr! Leben ist besser! "
}