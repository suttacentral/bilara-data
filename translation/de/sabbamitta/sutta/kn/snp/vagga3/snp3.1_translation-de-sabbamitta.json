{
  "snp3.1:0.1": "Lehrreden-Sammelband 3.1 ",
  "snp3.1:0.2": "Das Fortziehen ",
  "snp3.1:1.1": "„Ich werde das Fortziehen rühmen ",
  "snp3.1:1.2": "am Beispiel des Klaräugigen, ",
  "snp3.1:1.3": "die Untersuchung, ",
  "snp3.1:1.4": "die ihn zum Fortziehen bewog. ",
  "snp3.1:2.1": "‚Dieses Hausleben ist eng, ",
  "snp3.1:2.2": "ein Bereich des Schmutzes.‘ ",
  "snp3.1:2.3": "‚Das Leben eines, der fortgezogen ist, ist wie der offene Raum.‘ ",
  "snp3.1:2.4": "Als er das sah, zog er fort. ",
  "snp3.1:3.1": "Als er fortgezogen war, ",
  "snp3.1:3.2": "scheute er schlechte Taten mit dem Körper. ",
  "snp3.1:3.3": "Er gab schlechtes Verhalten mit der Sprache auf ",
  "snp3.1:3.4": "und läuterte seinen Lebenserwerb. ",
  "snp3.1:4.1": "Der Buddha ging nach Rājagaha, ",
  "snp3.1:4.2": "zum Bergring der Magadher. ",
  "snp3.1:4.3": "Er begab sich zum Almosengang, ",
  "snp3.1:4.4": "reichlich mit vortrefflichen Kennzeichen versehen. ",
  "snp3.1:5.1": "Bimbisāra sah ihn, ",
  "snp3.1:5.2": "als er auf seinem Langhaus stand. ",
  "snp3.1:5.3": "Als er sah, dass er mit Kennzeichen versehen war, ",
  "snp3.1:5.4": "sagte er Folgendes: ",
  "snp3.1:6.1": "‚Gebt acht auf diesen, gute Herren, ",
  "snp3.1:6.2": "ansprechend, majestätisch, strahlend; ",
  "snp3.1:6.3": "vollendet ist er im Betragen, "
}