{
  "snp3.1:0.1": "Lehrreden-Sammelband 3.1 ",
  "snp3.1:0.2": "Das Fortziehen ",
  "snp3.1:1.1": "„Ich werde das Fortziehen rühmen ",
  "snp3.1:1.2": "am Beispiel des Klaräugigen, ",
  "snp3.1:1.3": "die Untersuchung, ",
  "snp3.1:1.4": "die ihn zum Fortziehen bewog. ",
  "snp3.1:2.1": "‚Dieses Hausleben ist eng, ",
  "snp3.1:2.2": "ein Bereich des Schmutzes.‘ ",
  "snp3.1:2.3": "‚Das Leben eines, der fortgezogen ist, ist wie der offene Raum.‘ ",
  "snp3.1:2.4": "Als er das sah, zog er fort. ",
  "snp3.1:3.1": "Als er fortgezogen war, ",
  "snp3.1:3.2": "scheute er schlechte Taten mit dem Körper. "
}