{
  "snp2.2:0.1": "Lehrreden-Sammelband 2.2 ",
  "snp2.2:0.2": "Fäulnis ",
  "snp2.2:1.1": "„Hirse, wilde Gräser, Besenkorn, ",
  "snp2.2:1.2": "Blätter, Wurzelknollen, Beeren – ",
  "snp2.2:1.3": "das essen die Guten, rechtmäßig erhalten. ",
  "snp2.2:1.4": "Sie lügen nicht, um zu bekommen, was sie wollen. ",
  "snp2.2:2.1": "Doch wenn du vorzügliche Speisen isst, ",
  "snp2.2:2.2": "gut gekocht und zubereitet, von andern gespendet, ",
  "snp2.2:2.3": "wenn du ein erlesenes Reisgericht genießt, ",
  "snp2.2:2.4": "Kassapa, dann isst du Fäulnis. ",
  "snp2.2:3.1": "‚Fäulnis ist für mich nicht angemessen‘, ",
  "snp2.2:3.2": "so sagtest du, Brahmane nur durch Verwandtschaft. ",
  "snp2.2:3.3": "Doch hier genießt du ein erlesenes Reisgericht, ",
  "snp2.2:3.4": "gut gekocht mit Geflügelfleisch. ",
  "snp2.2:3.5": "Ich frage dich dieses, Kassapa: ",
  "snp2.2:3.6": "Was verstehst du unter Fäulnis?“ ",
  "snp2.2:4.1": "„Geschöpfe töten, verstümmeln, morden, entführen, ",
  "snp2.2:4.2": "stehlen, lügen, täuschen und betrügen, ",
  "snp2.2:4.3": "krumme Zaubersprüche lernen, Ehebruch: ",
  "snp2.2:4.4": "das ist Fäulnis, nicht Fleischessen. ",
  "snp2.2:5.1": "Menschen hier mit unbezähmter Sinnlichkeit, ",
  "snp2.2:5.2": "gierig nach Geschmäcken, in Unreinheit durchmischt, ",
  "snp2.2:5.3": "Nihilisten, unmoralisch, widerspenstig: ",
  "snp2.2:5.4": "das ist Fäulnis, nicht Fleischessen. ",
  "snp2.2:6.1": "Grobe und brutale Verleumder, ",
  "snp2.2:6.2": "mitleidlose, selbstgefällige Freundesbetrüger, ",
  "snp2.2:6.3": "Geizhälse, die nie irgendetwas abgeben: ",
  "snp2.2:6.4": "das ist Fäulnis, nicht Fleischessen. ",
  "snp2.2:7.1": "Zorn, Eitelkeit, Starrsinn, Trotz, ",
  "snp2.2:7.2": "Betrug, Eifersucht, Prahlsucht, ",
  "snp2.2:7.3": "Hochmut, Nähe zu Bösen: ",
  "snp2.2:7.4": "das ist Fäulnis, nicht Fleischessen. ",
  "snp2.2:8.1": "Die Ungezogenen, Schuldenflüchtlinge, Verleumder, ",
  "snp2.2:8.2": "Berufsschwindler und Hochstapler, "
}