{
  "mn111:0.1": "Mittlere Lehrreden 111 ",
  "mn111:0.2": "Eins nach dem anderen ",
  "mn111:1.1": "So habe ich es gehört: ",
  "mn111:1.2": "Einmal hielt sich der Buddha bei Sāvatthī in Jetas Wäldchen auf, dem Kloster des Anāthapiṇḍika. ",
  "mn111:1.3": "Da wandte sich der Buddha an die Mönche und Nonnen: ",
  "mn111:1.4": "„Mönche und Nonnen!“ ",
  "mn111:1.5": "„Ehrwürdiger Herr“, antworteten sie. ",
  "mn111:1.6": "Der Buddha sagte: ",
  "mn111:2.1": "„Sāriputta ist klug, Mönche und Nonnen, ",
  "mn111:2.2": "er besitzt große Weisheit, ",
  "mn111:2.3": "umfassende Weisheit, "
}