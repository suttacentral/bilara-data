{
  "thig5.9:0.1": "Kıdemli Dervişelerin Şarkıları 5.9 ",
  "thig5.9:0.2": "Beşler Silsilesi ",
  "thig5.9:0.3": "Kıvırcık Saçlı Azize Bhaddā'nın Şarkısı ",
  "thig5.9:1.1": "Tek bir cübbeyle gezerdim ",
  "thig5.9:1.2": "Çamur içinde, saçlarım yoluk. ",
  "thig5.9:1.3": "Hata olmayan yerde hata bulup ",
  "thig5.9:1.4": "Gerçek hataları görmezdim. ",
  "thig5.9:2.1": "Akbaba Gagası Dağı'ndaki ",
  "thig5.9:2.2": "Günlük ikametimden kalkıp ",
  "thig5.9:2.3": "Lekesiz Buda'yı gördüm "
}