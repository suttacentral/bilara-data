{
  "thig7.2:0.1": "Kıdemli Dervişelerin Şarkıları 7.2 ",
  "thig7.2:0.2": "Yediler Silsilesi ",
  "thig7.2:0.3": "Cālā'nın Şarkısı ",
  "thig7.2:1.1": "(Cālā:)  \n“Bir dervişeyim, hafızası müesses ",
  "thig7.2:1.2": "Ve de duyuları muazzam; ",
  "thig7.2:1.3": "Fiiliyatın keyifle dindiği ",
  "thig7.2:1.4": "Huzurlu adıma ermiş olan.” ",
  "thig7.2:2.1": "(Ölüm:)\n“Kime adanıp kafanı kazıttın? ",
  "thig7.2:2.2": "Zâhitlere benzemişsin de ",
  "thig7.2:2.3": "Hiçbir öğretiyi kabul etmezsin; ",
  "thig7.2:2.4": "Neden meczup gibi gezersin?” "
}