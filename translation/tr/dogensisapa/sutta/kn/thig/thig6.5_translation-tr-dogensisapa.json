{
  "thig6.5:0.2": "Altılar Silsilesi ",
  "thig6.5:0.3": "Para pul, mal mülk sahibi ",
  "thig6.5:1.1": "Seçkin bir aileye doğdum. ",
  "thig6.5:1.2": "Tenimin rengi ve hoş görünümümle ",
  "thig6.5:1.3": "Majjha'nın öz kızıydım. ",
  "thig6.5:1.4": "Kralların oğulları peşimdeydi, ",
  "thig6.5:2.1": "Varlıklı oğullar beni arzulardı. ",
  "thig6.5:2.2": "Biri de babama elçi yolladı: ",
  "thig6.5:2.3": "\"Ver bana Anopamā'yı! ",
  "thig6.5:2.4": "Öz kızın Anopamā'nın ",
  "thig6.5:3.1": "Ne ederse ağırlığı ",
  "thig6.5:3.2": "Sekiz katı vereceğim ",
  "thig6.5:3.3": "Altın ve mücevheratı.\" ",
  "thig6.5:3.4": "Ama dünyanın önde geleni ",
  "thig6.5:4.1": "O eşsiz Aydın'ı görünce ",
  "thig6.5:4.2": "Saygıyla ayaklarına kapandım, ",
  "thig6.5:4.3": "Yanına çöküp oturdum. ",
  "thig6.5:4.4": "Hakikati öğretti Dosdoğru Gören ",
  "thig6.5:5.1": "Merhamet eyleyip bana. ",
  "thig6.5:5.2": "Orada otururken hem ",
  "thig6.5:5.3": "Üçüncü meyveye dokundum. "
}