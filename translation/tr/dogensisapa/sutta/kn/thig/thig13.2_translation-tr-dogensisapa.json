{
  "thig13.2:0.1": "Kıdemli Dervişelerin Şarkıları 13.2 ",
  "thig13.2:0.2": "Yirmiler Silsilesi ",
  "thig13.2:0.3": "Rohinī'nin Şarkısı ",
  "thig13.2:1.1": "(Rohinī'nin Babası:)  \n\"“Zâhit' der yatarsın, ",
  "thig13.2:1.2": "'Zâhit' der kalkarsın, ",
  "thig13.2:1.3": "Sade översin zâhitleri, ",
  "thig13.2:1.4": "Muhakkak zâhit olursun! ",
  "thig13.2:2.1": "Zâhitlere bolca bolca ",
  "thig13.2:2.2": "Verirsin yiyecek-içeceğini. ",
  "thig13.2:2.3": "Sorarım sana Rohinī- ",
  "thig13.2:2.4": "Niye seversin zâhitleri? ",
  "thig13.2:3.1": "İş sevmezler, hem de tembel; ",
  "thig13.2:3.2": "Sadakadır yiyip içtikleri, ",
  "thig13.2:3.3": "Güzel yemekler beklerler- ",
  "thig13.2:3.4": "Niye seversin zâhitleri?” ",
  "thig13.2:22.1": "… Kıdemli dervişe Rohinī …. "
}