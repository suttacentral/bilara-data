{
  "thig13.2:0.1": "Kıdemli Dervişelerin Şarkıları 13.2 ",
  "thig13.2:0.2": "Yirmiler Silsilesi ",
  "thig13.2:0.3": "Rohinī'nin Şarkısı ",
  "thig13.2:1.1": "(Rohinī'nin Babası:)  \n\"“Zâhit' der yatarsın, ",
  "thig13.2:1.2": "'Zâhit' der kalkarsın, ",
  "thig13.2:1.3": "Sade översin zâhitleri, ",
  "thig13.2:1.4": "Muhakkak zâhit olursun! ",
  "thig13.2:2.1": "Zâhitlere bolca bolca ",
  "thig13.2:2.2": "Verirsin yiyecek-içeceğini. ",
  "thig13.2:2.3": "Sorarım sana Rohinī- ",
  "thig13.2:2.4": "Niye seversin zâhitleri? ",
  "thig13.2:3.1": "İş sevmezler, hem de tembel; ",
  "thig13.2:3.2": "Sadakadır yiyip içtikleri, ",
  "thig13.2:3.3": "Güzel yemekler beklerler- ",
  "thig13.2:3.4": "Niye seversin zâhitleri?” ",
  "thig13.2:4.1": "(Rohinī:)  \n“Epeyi zamandan beridir babam ",
  "thig13.2:4.2": "Sorarsın bana zâhitleri. ",
  "thig13.2:4.3": "Sana methedeyim onları- ",
  "thig13.2:4.4": "İrfan, ahlâk, gayretlerini. ",
  "thig13.2:5.1": "Severler çalışmayı, boş durmazlar; ",
  "thig13.2:5.2": "En önemli meseleyle uğraşırlar. ",
  "thig13.2:5.3": "Tutku ve öfkeden vazgeçmişler; ",
  "thig13.2:5.4": "Bu yüzden severim zâhitleri. ",
  "thig13.2:6.1": "Günahın üç kökünü ",
  "thig13.2:6.2": "Sevapları ile temizlerler, ",
  "thig13.2:6.3": "Şer olandan kaçınırlar hep; ",
  "thig13.2:6.4": "Bu yüzden severim zâhitleri. ",
  "thig13.2:7.1": "Cismanî faaliyette temizlerdir, ",
  "thig13.2:7.2": "Sözü söylerken de keza, ",
  "thig13.2:7.3": "Ve dahi temizdir zihinleri; ",
  "thig13.2:7.4": "Bu yüzden severim zâhitleri. ",
  "thig13.2:8.1": "Sedef gibi lekesizdirler, ",
  "thig13.2:8.2": "İçten dışa püripak onlar. ",
  "thig13.2:8.3": "Tertemiz hakikati kuşanmışlar; ",
  "thig13.2:8.4": "Bu yüzden severim zâhitleri. ",
  "thig13.2:9.1": "Hakikat kuşanmış âlimler, ",
  "thig13.2:9.2": "Hakikatle yaşayan asiller, ",
  "thig13.2:9.3": "Öğretir anlamıyla hakikati, ",
  "thig13.2:9.4": "Bu yüzden severim zâhitleri. ",
  "thig13.2:10.1": "Hakikat kuşanmış âlimler, ",
  "thig13.2:10.2": "Hakikatle yaşayan asiller, ",
  "thig13.2:10.3": "Aklı tek çizgide, aklı başında; ",
  "thig13.2:10.4": "Bu yüzden severim zâhitleri. ",
  "thig13.2:11.1": "Düşüncelidirler, gezerler ",
  "thig13.2:11.2": "Soğukkanlıdır tavsiyeleri. ",
  "thig13.2:11.3": "Çilenin tükenişini bilirler; ",
  "thig13.2:11.4": "Bu yüzden severim zâhitleri. ",
  "thig13.2:12.1": "Bir köyden ayrılınca ",
  "thig13.2:12.2": "Geriye hasretle bakmazlar, ",
  "thig13.2:12.3": "Endişeden arınmış, yürürler; ",
  "thig13.2:12.4": "Bu yüzden severim zâhitleri. ",
  "thig13.2:13.1": "Ambar, çömlek, sepetlerde ",
  "thig13.2:13.2": "Hiçbir şey biriktirmezler. ",
  "thig13.2:13.3": "Gelen sadakaya bakarlar sadece; ",
  "thig13.2:13.4": "Bu yüzden severim zâhitleri. ",
  "thig13.2:14.1": "Paraya veya altın-gümüşe, ",
  "thig13.2:14.2": "Yahut sikkeye değmez elleri. ",
  "thig13.2:14.3": "Var olanla geçinirler; ",
  "thig13.2:14.4": "Bu yüzden severim zâhitleri. ",
  "thig13.2:15.1": "Farklı ailelerden gelirler, ",
  "thig13.2:15.2": "Ve dahi farklı diyarlardan- ",
  "thig13.2:15.3": "Yine de severler birbirlerini; ",
  "thig13.2:22.1": "… Kıdemli dervişe Rohinī …. "
}