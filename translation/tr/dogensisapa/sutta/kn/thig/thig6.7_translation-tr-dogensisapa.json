{
  "thig6.7:0.1": "Kıdemli Dervişelerin Şarkıları 6.7 ",
  "thig6.7:0.2": "Altılar Silsilesi ",
  "thig6.7:0.3": "Guttā'nın Şarkısı ",
  "thig6.7:1.1": "Guttā! Oğlunu ve tüm sevdiklerini ",
  "thig6.7:1.2": "Terkedip yola düşme sebebine, ",
  "thig6.7:1.3": "Tam da buna ehemmiyet ver; ",
  "thig6.7:1.4": "Kapılma hiç gönlünün isteklerine. ",
  "thig6.7:2.1": "Gönülün yanılttığı varlıklar ",
  "thig6.7:2.3": "Pek cahilce tenasüh edip ",
  "thig6.7:7.1": "… Kıdemli dervişe Guttā …. "
}