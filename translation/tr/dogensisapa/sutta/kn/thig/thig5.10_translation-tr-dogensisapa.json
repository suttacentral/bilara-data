{
  "thig5.10:0.1": "Kıdemli Dervişelerin Şarkıları 5.10 ",
  "thig5.10:0.2": "Beşler Silsilesi ",
  "thig5.10:0.3": "Paṭācārā'nın Şarkısı ",
  "thig5.10:1.1": "Toprağı sürüp tohum eken, ",
  "thig5.10:1.2": "Karılarını, çocuklarını ",
  "thig5.10:1.3": "Böyle geçindiren delikanlılar ",
  "thig5.10:1.4": "Hayattayken servet bulurlar. ",
  "thig5.10:2.1": "Ben ki erdemde hünerliyim, ",
  "thig5.10:2.2": "Öğretmenin sözüne de uyarım, ",
  "thig5.10:2.3": "Ne tembel ne kibirliyim, lâkin "
}