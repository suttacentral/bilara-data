{
  "thig12.1:0.1": "Kıdemli Dervişelerin Şarkıları 12.1 ",
  "thig12.1:0.2": "Onaltılar Silsilesi ",
  "thig12.1:0.3": "Puṇṇikā'nın Şarkısı ",
  "thig12.1:1.1": "(Puṇṇikā)  \n“Soğuk havalarda sular taşıdım, ",
  "thig12.1:17.1": "… Kıdemli dervişe Puṇṇā …. ",
  "thig12.1:18.1": "Onaltılar silsilesi bitti. "
}