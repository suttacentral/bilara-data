{
  "thig12.1:0.1": "Kıdemli Dervişelerin Şarkıları 12.1 ",
  "thig12.1:0.2": "Onaltılar Silsilesi ",
  "thig12.1:0.3": "Puṇṇikā'nın Şarkısı ",
  "thig12.1:1.1": "(Puṇṇikā)  \n“Soğuk havalarda sular taşıdım, ",
  "thig12.1:1.2": "Soğuk havalarda suya dalardım; ",
  "thig12.1:1.3": "Ustamın cezalandırmasından, ",
  "thig12.1:1.4": "Küfür ve azabından korkardım. ",
  "thig12.1:2.1": "Söyle Brahman, neden korkarsın, ",
  "thig12.1:2.2": "Kendini soğuk suya atarsın; ",
  "thig12.1:2.3": "Ellerin ayakların titrer de ",
  "thig12.1:2.4": "Soğuktan donup kalırsın?” ",
  "thig12.1:3.1": "“Güzel hanımefendim Puṇṇikā, ",
  "thig12.1:3.2": "Sen iyi bilirsin ne yaptığımı: ",
  "thig12.1:3.3": "Mühim işlerle uğraştığımı ",
  "thig12.1:3.4": "Ve günahlarımdan arındığımı. ",
  "thig12.1:4.1": "Genç olsun ya da yaşlı, ",
  "thig12.1:4.2": "Kim işlemişse günahı ",
  "thig12.1:4.3": "Suda vaftiz olur ve ",
  "thig12.1:4.4": "Temizler günahlarını.” ",
  "thig12.1:5.1": "“Bir cahilden diğerine, ",
  "thig12.1:5.2": "Kim öğretti sana böyle: ",
  "thig12.1:5.3": "'Suda vaftiz oldun mu ",
  "thig12.1:5.4": "Günah temizlenir' diye? ",
  "thig12.1:6.1": "Öyleyse yılanlar ve timsahlar, ",
  "thig12.1:6.2": "Kurbağalar, kaplumbağalar, ",
  "thig12.1:6.3": "Bütün diğer suda yaşayanlar ",
  "thig12.1:6.4": "Cennete gitmez miydi böyle? ",
  "thig12.1:7.1": "Domuz-koyun katilleri, ",
  "thig12.1:7.2": "Balıkçılar, avcılar, ",
  "thig12.1:7.3": "Hırsızlar ve cellatlar, ",
  "thig12.1:7.4": "Türlü türlü günahkârlar, ",
  "thig12.1:7.5": "Varıp suda vaftiz olup ",
  "thig12.1:7.6": "Temizlerdi günahını. ",
  "thig12.1:8.1": "Varsayalım bu nehirler ",
  "thig12.1:8.2": "Temizleseydi günahları, ",
  "thig12.1:8.3": "Keza üstündeki şer zırhını ",
  "thig12.1:8.4": "Yani temizlerdi dahi sevapları. ",
  "thig12.1:9.1": "Korktuğun neyse Brahman ",
  "thig12.1:9.2": "Ki arınmak için suya dalarsın; ",
  "thig12.1:9.3": "O günahları işleme yeter, ",
  "thig12.1:9.4": "Soğuk da derini parçalamasın.” ",
  "thig12.1:10.1": "“Yanlış yola düşmüştüm, ",
  "thig12.1:10.2": "Beni asillerin yoluna yönelttin; ",
  "thig12.1:10.3": "Hanımefendim bu vaftiz örtüsünü ",
  "thig12.1:10.4": "Lütfen size hediye edeyim.” ",
  "thig12.1:17.1": "… Kıdemli dervişe Puṇṇā …. ",
  "thig12.1:18.1": "Onaltılar silsilesi bitti. "
}