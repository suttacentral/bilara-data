{
  "thig12.1:0.1": "Kıdemli Dervişelerin Şarkıları 12.1 ",
  "thig12.1:0.2": "Onaltılar Silsilesi ",
  "thig12.1:0.3": "Puṇṇikā'nın Şarkısı ",
  "thig12.1:1.1": "(Puṇṇikā)  \n“Soğuk havalarda sular taşıdım, ",
  "thig12.1:1.2": "Soğuk havalarda suya dalardım; ",
  "thig12.1:1.3": "Ustamın cezalandırmasından, ",
  "thig12.1:1.4": "Küfür ve azabından korkardım. ",
  "thig12.1:2.1": "Söyle Brahman, neden korkarsın, ",
  "thig12.1:2.2": "Kendini soğuk suya atarsın; ",
  "thig12.1:2.3": "Ellerin ayakların titrer de ",
  "thig12.1:2.4": "Soğuktan donup kalırsın?” ",
  "thig12.1:3.1": "“Güzel hanımefendim Puṇṇikā, ",
  "thig12.1:3.2": "Sen iyi bilirsin ne yaptığımı: ",
  "thig12.1:3.3": "Mühim işlerle uğraştığımı ",
  "thig12.1:3.4": "Ve günahlarımdan arındığımı. ",
  "thig12.1:4.1": "Genç olsun ya da yaşlı, ",
  "thig12.1:17.1": "… Kıdemli dervişe Puṇṇā …. ",
  "thig12.1:18.1": "Onaltılar silsilesi bitti. "
}