{
  "thig8.1:0.1": "Kıdemli Dervişelerin Şarkıları 8.1 ",
  "thig8.1:0.2": "Sekizler Silsilesi ",
  "thig8.1:0.3": "Sīsūpacālā'nın Şarkısı ",
  "thig8.1:1.1": "(Sīsūpacālā:)\n“Duyularını dizginleyen ",
  "thig8.1:1.2": "Erdemde hünerli bir dervişe, ",
  "thig8.1:1.3": "Erişir o huzurlu adıma, ",
  "thig8.1:1.4": "Saftır o, doyurucudur hem de.” ",
  "thig8.1:2.1": "(Ölüm:)\n“Hatırla bak eskiden ",
  "thig8.1:2.2": "Kimler vardı yanında yörende: ",
  "thig8.1:2.3": "Tāvatiṁsa ve Yāma tanrıları, ",
  "thig8.1:2.4": "Tusita ve Nimmānarati tanrıları ",
  "thig8.1:2.5": "Ve Vasavatti tanrıları ile! ",
  "thig8.1:2.6": "Hadi gönlünü oralara yönelt yine!” ",
  "thig8.1:3.1": "(Sīsūpacālā:)\n“Tāvatiṁsa, Yāma, ",
  "thig8.1:3.2": "Tusita tanrıları, ",
  "thig8.1:3.3": "Nimmānarati tanrıları, ",
  "thig8.1:3.4": "Ve Vasavatti tanrıları; ",
  "thig8.1:4.1": "Peşi sıra her varoluşta ",
  "thig8.1:4.2": "Ben'liğe kapılırlar. ",
  "thig8.1:4.3": "Ben'liği aşamayıp ",
  "thig8.1:4.4": "Doğa-öle dolanırlar. ",
  "thig8.1:5.1": "Bütün dünya yanıyor! ",
  "thig8.1:5.2": "Bütün dünya alev alev! ",
  "thig8.1:5.3": "Bütün dünya tutuşuyor! ",
  "thig8.1:5.4": "Bütün dünya zangır zangır! ",
  "thig8.1:6.1": "Sarsılmayan, ölçüsüz, ",
  "thig8.1:9.1": "… Kıdemli dervişe Sīsūpacālā …. ",
  "thig8.1:10.1": "Sekizler silsilesi bitti. "
}