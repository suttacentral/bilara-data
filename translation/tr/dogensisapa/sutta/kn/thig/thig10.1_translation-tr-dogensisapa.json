{
  "thig10.1:0.1": "Kıdemli Dervişelerin Şarkıları 10.1 ",
  "thig10.1:0.2": "Onbirler Silsilesi ",
  "thig10.1:0.3": "Kisāgotamī'nin Şarkısı ",
  "thig10.1:1.1": "“Bilgeler dünyada en çok ",
  "thig10.1:1.2": "İyi dostluğa değer verir. ",
  "thig10.1:1.3": "İyi dostlarla vakit geçiren ",
  "thig10.1:2.1": "Vaktini hakiki insanlarla geçir, ",
  "thig10.1:2.2": "Zira irfanın böyle böyle gelişir. ",
  "thig10.1:2.3": "Doğru insanlarla vakit geçiren ",
  "thig10.1:2.4": "Kurtulur her tür çileden. ",
  "thig10.1:3.1": "Böylece anlarsın çileyi, ",
  "thig10.1:3.2": "Kaynağını, tükenişini; ",
  "thig10.1:3.3": "Sekiz katlı asil yol ile ",
  "thig10.1:3.4": "Asillerin dört bilgisini.” ",
  "thig10.1:4.1": "“'Kadın olmak çilelidir,' dedi ",
  "thig10.1:4.2": "Ehlileşmeye hazırların öğretmeni; ",
  "thig10.1:4.3": "'Çilelidir hâkeza kocayı paylaşmak da. ",
  "thig10.1:13.1": "Onbirler silsilesi bitti. "
}