{
  "thig7.3:0.1": "Kıdemli Dervişelerin Şarkıları 7.3 ",
  "thig7.3:0.2": "Yediler Silsilesi ",
  "thig7.3:0.3": "Upacālā'nın Şarkısı ",
  "thig7.3:1.1": "(Upacālā:)  \n“Bir dervişeyim, hafızası müesses ",
  "thig7.3:1.2": "Ve de duyuları muazzam; ",
  "thig7.3:3.3": "Dövüp bağlar ölüm, perişan eder; ",
  "thig7.3:3.4": "Her doğan her daim çileye düşer. ",
  "thig7.3:4.1": "Emsalsiz bir Aydın var ",
  "thig7.3:4.2": "Sakya Aşireti'nden çıkan; "
}