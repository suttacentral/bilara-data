{
  "thig6.1:0.1": "Kıdemli Dervişelerin Şarkıları 6.1 ",
  "thig6.1:0.2": "Altılar Silsilesi ",
  "thig6.1:0.3": "Beş Yüz Azize'nin Şarkısı ",
  "thig6.1:1.1": "[Paṭācārā:]\n\"Nereden gelmiş nereye gider, ",
  "thig6.1:1.2": "Yolunu bilmez ağlarsın; ",
  "thig6.1:1.3": "Nereden geldiği belirsize ",
  "thig6.1:1.4": "'Evladım!' der yas tutarsın. ",
  "thig6.1:2.1": "Ah o yollarını bir bilsen ",
  "thig6.1:2.2": "Nereden gelip nereye giderler, ",
  "thig6.1:2.3": "O vakit yasını da tutmazsın; ",
  "thig6.1:2.4": "Budur hakikati canlıların. ",
  "thig6.1:3.1": "Onlar ki izin almadan gelirler, ",
  "thig6.1:3.2": "Ve dahi izin almadan giderler. ",
  "thig6.1:3.3": "Nereden gelirlerse gelsinler, "
}