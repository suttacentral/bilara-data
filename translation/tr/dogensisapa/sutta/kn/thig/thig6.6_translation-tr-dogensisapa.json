{
  "thig6.6:0.1": "Kıdemli Dervişelerin Şarkıları 6.6 ",
  "thig6.6:0.2": "Altılar Silsilesi ",
  "thig6.6:0.3": "Mahāpajāpati Gotamī'nin Şarkısı ",
  "thig6.6:1.1": "Saygılar sana kahraman Buda! ",
  "thig6.6:1.2": "O ki tüm varlıkların en iyisi, ",
  "thig6.6:1.3": "Çileden kurtardı ",
  "thig6.6:1.4": "Beni ve pek çok kişiyi. ",
  "thig6.6:2.1": "Tüm çileler tamamen anlaşıldı, ",
  "thig6.6:2.2": "Arzular sebepleriyle kurudu, ",
  "thig6.6:2.3": "Sekiz katlı yol geliştirildi ",
  "thig6.6:2.4": "Ve tükenişe dokunuldu. ",
  "thig6.6:3.1": "Önceki hayatlarda bir anne, bir oğul, ",
  "thig6.6:3.2": "Bir baba, bir kardeş ve bir nene idim; ",
  "thig6.6:3.3": "Neyin ne olduğunu hiç bilmez, ",
  "thig6.6:3.4": "\nÖdüle kavuşamadan dolanıp durdum. ",
  "thig6.6:4.2": "Son bedenim bu et yığını. ",
  "thig6.6:7.1": "… Kıdemli dervişe Mahāpajāpati Gotamī …. "
}