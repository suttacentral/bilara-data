{
  "thig3.5:0.1": "Kıdemli Dervişelerin Şarkıları 3.5 ",
  "thig3.5:0.2": "Üçler Silsilesi ",
  "thig3.5:0.3": "Ubbirī'nin Şarkısı ",
  "thig3.5:1.1": "[Budha:]\n\"'Annem!' deyip kızın Hayat'a ağlıyorsun; ",
  "thig3.5:1.2": "Ubbirī kendine gel! ",
  "thig3.5:1.3": "Seksen dört bin farklı Hayat, ",
  "thig3.5:1.4": "Ki hepsi senin evladındı, ",
  "thig3.5:1.5": "Heyhat bu ormanda hepsi yandı; ",
  "thig3.5:1.6": "Hangi birine ağlarsın?\" ",
  "thig3.5:2.1": "[Ubbirī:]\n\"Kalbimin derinine saplı ",
  "thig3.5:2.2": "Saklı hançeri çıkardın. "
}