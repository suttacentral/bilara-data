{
  "thig13.1:0.1": "Kıdemli Dervişelerin Şarkıları 13.1 ",
  "thig13.1:0.2": "Yirmiler Silsilesi ",
  "thig13.1:0.3": "Ambapālī'nin Şarkısı ",
  "thig13.1:1.1": "Yaban arısı gibi saçlarım, ",
  "thig13.1:1.2": "Kıvır kıvırdı kara uçları! ",
  "thig13.1:1.3": "Yaşlanınca hint ketenine benzedi- ",
  "thig13.1:1.4": "Tam da hakikinin dediği gibi. ",
  "thig13.1:2.1": "Adeta, kafamda hoş kokan ",
  "thig13.1:2.2": "Çiçek dolu bir sepetle gezerdim! ",
  "thig13.1:2.3": "Yaşlanınca hayvan derisi koktu- ",
  "thig13.1:2.4": "Tam da hakikinin dediği gibi. ",
  "thig13.1:3.1": "Katları taralı, tokalarla süslü ",
  "thig13.1:3.2": "Gür bir koru gibiydi saçlarım! ",
  "thig13.1:3.3": "Yaşlanınca orası burası seyreldi- ",
  "thig13.1:3.4": "Tam da hakikinin dediği gibi. ",
  "thig13.1:4.1": "Kara lülelerim altınla bezeliydi, ",
  "thig13.1:4.2": "Süslü örgülerim parıldardı! ",
  "thig13.1:4.3": "Yaşlanınca saçım kalmadı- ",
  "thig13.1:4.4": "Tam da hakikinin dediği gibi. ",
  "thig13.1:5.1": "Çok güzeldi kaşlarım ve nazik çizgileri ",
  "thig13.1:5.2": "Bir ressamın elinden çıkmıştı sanki! ",
  "thig13.1:5.3": "Yaşlanınca kırışıklarla kaplandı- ",
  "thig13.1:5.4": "Tam da hakikinin dediği gibi. ",
  "thig13.1:6.1": "Masmavi badem gözlerim ",
  "thig13.1:6.2": "Mücevherler gibi parlardı! "
