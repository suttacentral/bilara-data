{
  "thig1.1:0.1": "Therīgāthā 1.1 ",
  "thig1.1:0.2": "Birler Silsilesi ",
  "thig1.1:0.3": "Anonim Dervişenin Şarkısı ",
  "thig1.1:1.0": "Tamemen Aydınlanmış, Layık, Bahtiyâra hürmetler olsun. ",
  "thig1.1:1.1": "\"Huzurla uyu azizecik ",
  "thig1.1:1.2": "Diktiğin kaftanla örtülü; ",
  "thig1.1:1.3": "Arzuların tümden yatıştı, ",
  "thig1.1:1.4": "Bir çömlek kuru sebze gibi.\" "
}