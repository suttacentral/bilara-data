{
  "thig9.1:0.1": "Kıdemli Dervişelerin Şarkıları 9.1 ",
  "thig9.1:0.2": "Dokuzlar Silsilesi ",
  "thig9.1:0.3": "Vaḍḍha'nın Annesinin Şarkısı ",
  "thig9.1:1.1": "(Vaḍḍha'nın Annesi:)  \n“Ah Vaḍḍha, sakın ha ",
  "thig9.1:5.2": "En küçük zerreden bile ufak ",
  "thig9.1:7.1": "(Vaḍḍha:)  \n“Ne şahaneydi annemin ",
  "thig9.1:10.1": "… Kıdemli dervişe Vaḍḍhamātā …. "
}