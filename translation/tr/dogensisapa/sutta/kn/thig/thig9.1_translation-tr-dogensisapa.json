{
  "thig9.1:0.1": "Kıdemli Dervişelerin Şarkıları 9.1 ",
  "thig9.1:0.2": "Dokuzlar Silsilesi ",
  "thig9.1:0.3": "Vaḍḍha'nın Annesinin Şarkısı ",
  "thig9.1:1.1": "(Vaḍḍha'nın Annesi:)  \n“Ah Vaḍḍha, sakın ha ",
  "thig9.1:1.2": "Bu dünyaya bağlanma! ",
  "thig9.1:1.3": "Evladım; tekrar tekrar ",
  "thig9.1:1.4": "Sakın çileye kapılma! ",
  "thig9.1:2.1": "Vaḍḍha; bilgeler, ",
  "thig9.1:2.2": "Gerilmeden, şüphelenmeden, ",
  "thig9.1:2.3": "Serin kanlı, öz disiplinli, ",
  "thig9.1:2.4": "Rahat yaşarlar kirden âri. ",
  "thig9.1:3.1": "Bilgelerin tuttuğu, ",
  "thig9.1:3.2": "Görüye giden yolu; ",
  "thig9.1:3.4": "Yolunu izle Vaḍḍha.” ",
  "thig9.1:5.2": "En küçük zerreden bile ufak ",
  "thig9.1:7.1": "(Vaḍḍha:)  \n“Ne şahaneydi annemin ",
  "thig9.1:10.1": "… Kıdemli dervişe Vaḍḍhamātā …. ",
  "thig9.1:11.1": "Dokuzlar silsilesi bitti. "
}