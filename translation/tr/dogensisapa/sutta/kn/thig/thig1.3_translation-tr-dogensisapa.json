{
  "thig1.3:0.1": "Therīgāthā 1.3 ",
  "thig1.3:0.2": "Birler Silsilesi ",
  "thig1.3:0.3": "Puṅṅā'nın Şarkısı ",
  "thig1.3:1.1": "\"Güzel ilkelerle dol Puṇṇa, ",
  "thig1.3:1.2": "On beşinci günde ay gibi; ",
  "thig1.3:1.3": "İrfanını kusursuzlaştırıp ",
  "thig1.3:1.4": "Parçala kara kümeleri. \" ",
  "thig1.3:2.1": "Kıdemli dervişe bu dizeleri böyle dillendirdi denir. "
}