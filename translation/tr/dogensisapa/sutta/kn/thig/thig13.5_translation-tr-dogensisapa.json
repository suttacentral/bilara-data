{
  "thig13.5:0.1": "Kıdemli Dervişelerin Şarkıları 13.5 ",
  "thig13.5:0.2": "Yirmiler Silsilesi ",
  "thig13.5:0.3": "Nalbant Kızı Subhā'nın Şarkısı ",
  "thig13.5:1.1": "(Subhā:)  \n“Elbiseleri temiz bir gençtim ",
  "thig13.5:1.2": "Hakikati ilk dinlediğimde; ",
  "thig13.5:1.3": "Ve gerçeği tümden anladım ",
  "thig13.5:1.4": "Ayık kafam sayesinde. ",
  "thig13.5:2.1": "Bu sayede tüm şevklerden ",
  "thig13.5:2.2": "Rahatsız oldum muazzam; ",
  "thig13.5:2.3": "Tehlike görünce bünyede, ",
  "thig13.5:2.4": "Heves ettim ben feragâte. ",
  "thig13.5:3.1": "Terkettim aile çevremi, ",
  "thig13.5:3.2": "Kölelerimle işçilerimi; ",
  "thig13.5:3.3": "Bana keyif veren, ışıl ışıl ",
  "thig13.5:3.4": "Bereketli arazilerimi. ",
  "thig13.5:4.1": "Veciz olan saf hakikate ",
  "thig13.5:4.2": "İman edip feragât edince ",
  "thig13.5:4.3": "Yola düştüm geride bırakıp ",
  "thig13.5:4.4": "O muazzam servetimi. ",
  "thig13.5:5.1": "Hiçbirşey istemediğimden ",
  "thig13.5:5.2": "Yakışmaz artık bana, ",
  "thig13.5:5.3": "Çoktan vazgeçtim çünkü, ",
  "thig13.5:5.4": "Dokunmam paraya pula. ",
  "thig13.5:6.1": "Aydınlanma ya da sükûnet ",
  "thig13.5:6.2": "Parayla pulla alınmaz; ",
  "thig13.5:6.3": "Asiller buna kıymet vermez, ",
  "thig13.5:13.4": "Bunlardır bana münasip olanı. ",
  "thig13.5:14.1": "\n",
  "thig13.5:14.2": "\n",
  "thig13.5:14.3": "\n",
  "thig13.5:14.4": "\n",
  "thig13.5:15.1": "\n",
  "thig13.5:15.2": "\n",
  "thig13.5:15.3": "\n",
  "thig13.5:15.4": "\n",
  "thig13.5:16.1": "\n",
  "thig13.5:16.2": "\n",
  "thig13.5:16.3": "\n",
  "thig13.5:16.4": "\n",
  "thig13.5:31.1": "Yirmiler silsilesi bitti. "
}