{
  "thig6.4:0.1": "Kıdemli Dervişelerin Şarkıları 6.4 ",
  "thig6.4:0.2": "Altılar Silsilesi ",
  "thig6.4:0.3": "Sujātā'nın Şarkısı ",
  "thig6.4:1.1": "Güzel elbiselerle süslendim ",
  "thig6.4:1.2": "Buketler ve sandal kokularıyla, ",
  "thig6.4:1.3": "Heryerim cicili bicili, ",
  "thig6.4:1.4": "Dört yanımda hizmetçi. ",
  "thig6.4:2.1": "Dişe gelir ve de lezzetli ",
  "thig6.4:2.2": "Bolca yiyecek içecek aldım, ",
  "thig6.4:2.3": "Evimden çıktım yola, ",
  "thig6.4:2.4": "Zevkler bahçesine vardım ",
  "thig6.4:3.1": "Eğlenip zevke daldım orada; "
