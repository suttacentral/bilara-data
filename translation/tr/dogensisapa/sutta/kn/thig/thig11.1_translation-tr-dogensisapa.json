{
  "thig11.1:0.1": "Kıdemli Dervişelerin Şarkıları 11.1 ",
  "thig11.1:0.2": "Onikiler Silsilesi ",
  "thig11.1:0.3": "Uppalavaṇṇā'nın Şarkısı ",
  "thig11.1:1.1": "“Ana ile kız ikimiz birden, ",
  "thig11.1:1.2": "Aynı kocanın karısıyken ",
  "thig11.1:1.3": "Birden bir aciliyete kapıldım- ",
  "thig11.1:1.4": "Tüylerim diken diken. ",
  "thig11.1:2.1": "Lanet olsun pis şehvete, ",
  "thig11.1:2.2": "Kokuşmuş ve dikenli! ",
  "thig11.1:2.3": "Ana ile kızını nasıl, ",
  "thig11.1:2.4": "Aynı kocaya everdi! ",
  "thig11.1:3.1": "Tehditini görünce şehvetin, ",
  "thig11.1:3.2": "Feragât oldu sığınağım; ",
  "thig11.1:3.3": "Çıkıp Rājagaha'ya gittim, ",
  "thig11.1:3.4": "Ve evsiz yola düştüm. ",
  "thig11.1:4.1": "İlâhî görüm temizlendi: ",
  "thig11.1:10.4": "Tamamladım Buda'nın öğretisini . ",
  "thig11.1:13.1": "… Kıdemli dervişe Uppalavaṇṇā …. ",
  "thig11.1:14.1": "Onikiler silsilesi bitti. "
}