{
  "kp5:0.1": "Temel Metinler 5 ",
  "kp5:0.2": "KORUNMA SUTTASI ",
  "kp5:1.1": "Duydum ki ",
  "kp5:1.2": "Kutlu Kişi bir seferinde Sāvatthī yakınlarında Jeta Korusu’nda Anāthapiṇḍika’nın manastırında konaklıyordu. ",
  "kp5:1.3": "O sırada bir deva gecenin ilerleyen saatlerinde tüm Jeta Korusu’nu ışıkla doldurarak Kutlu Kişi’ye yaklaştı. Yanına yaklaştığında Kutlu Kişi’nin önünde saygıyla eğildi ve doğrulduktan sonra onun yanında ayakta durdu. ",
  "kp5:1.4": "Ardından şu sözleri söyledi: ",
  "kp5:2.1": "\"Tanrılar ve insanlar ",
  "kp5:2.2": "Emniyette olabilmek için ",
  "kp5:2.3": "Korunmak üzerine derin derin düşünürler. ",
  "kp5:2.4": "O sebeple lütfen söyleyin bana, nedir en yüksek korunma?\" ",
  "kp5:3.1": "Aptalı kendine yoldaş yapma, ",
  "kp5:3.2": "Bilgeyi kendine yoldaş yap. ",
  "kp5:3.3": "Saygı duyulması gerekene saygı göster. ",
  "kp5:3.4": "Bu, en yüksek korunmadır. ",
  "kp5:4.1": "Medeni topraklarda yaşamak, ",
  "kp5:4.2": "Geçmişte hayır işlemiş olmak, ",
  "kp5:4.3": "Kendini doğru yola yönlendirmek. ",
  "kp5:4.4": "Bu, en yüksek korunmadır. ",
  "kp5:5.1": "Engin bilgi ve beceri, ",
  "kp5:5.2": "İyi geliştirilmiş bir disiplin, ",
  "kp5:5.3": "İyi kullanılan sözler. ",
  "kp5:5.4": "Bu, en yüksek korunmadır. ",
  "kp5:6.1": "Anne ve babayı desteklemek, ",
  "kp5:6.2": "Eşinin ve çocuklarının geçimini temin etmek, ",
  "kp5:6.3": "İşinde sebatkar olmak. ",
  "kp5:6.4": "Bu, en yüksek korunmadır. ",
  "kp5:7.1": "Cömertçe vermek, ",
  "kp5:7.2": "Doğru düşünce ve davranışlarla yaşamak, Akrabaları desteklemek, ",
  "kp5:7.3": "Saf eylemlerde bulunmak. ",
  "kp5:7.4": "Bu, en yüksek korunmadır. ",
  "kp5:8.1": "Kötülükten uzak durmak, ",
  "kp5:8.2": "Sarhoşluktan korunmak, ",
  "kp5:8.3": "Zihnin hallerine uyanık olmak. ",
  "kp5:8.4": "Bu, en yüksek korunmadır. ",
  "kp5:9.1": "Saygı, insancıllık, ",
  "kp5:9.2": "Halinden memnun olmak, Minnet ve şükür, ",
  "kp5:9.3": "Fırsat yakaladıkça öğretiyi dinlemek. ",
  "kp5:9.4": "Bu, en yüksek korunmadır. "
}