{
  "dhp76:0.2": "DHAMMAVÄRSID ",
  "dhp76:0.3": "Targa grupp ",
  "dhp76:0.4": "Tark, kes ütleb välja sellele, ",
  "dhp76:1": "mida peaks nägema, ",
  "dhp76:2": "ja noomib [selle eest], ",
  "dhp76:3": "mida tuleks vältida, on nagu aare; ",
  "dhp76:4": "arukas suhtleb [just] sellise targaga. "
}