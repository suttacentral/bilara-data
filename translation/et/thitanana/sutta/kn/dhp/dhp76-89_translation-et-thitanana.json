{
  "dhp76:0.2": "DHAMMAVÄRSID ",
  "dhp76:0.3": "Targa grupp ",
  "dhp76:0.4": "Tark, kes ütleb välja sellele, ",
  "dhp76:1": "mida peaks nägema, ",
  "dhp76:2": "ja noomib [selle eest], ",
  "dhp76:3": "mida tuleks vältida, on nagu aare; ",
  "dhp76:4": "arukas suhtleb [just] sellise targaga. ",
  "dhp76:5": "Selline suhtlemine toob head, ",
  "dhp76:6": "mitte kurja. ",
  "dhp77:1": "Kes manitseb [ja] annab nõu, ",
  "dhp77:2": "ning hoiab kurjast eemale, ",
  "dhp77:3": "see on tõesti tõelikule kallis, ",
  "dhp77:4": "kuid pole kallis mittetõelikule. ",
  "dhp78:1": "Ära suhtle kurjade sõpradega, ",
  "dhp78:2": "ära suhtle madalate inimestega. ",
  "dhp78:3": "Suhtle hüveliste sõpradega, ",
  "dhp78:4": "suhtle kõrgemate inimestega. ",
  "dhp79:1": "Dhammast rõõmu tundev ",
  "dhp79:2": "elab rõõmsalt, puhta meelega. ",
  "dhp79:3": "Arijate kuulutatud dhamma ",
  "dhp79:4": "rõõmustab alati tarka. ",
  "dhp80:1": "Tõepoolest, niisutajad juhivad vett, ",
  "dhp80:2": "nooletegijad painutavad noolevarsi, ",
  "dhp80:3": "puusepad painutavad puitu, ",
  "dhp80:4": "targad ohjavad ennast. ",
  "dhp81:1": "Nii nagu tuul ",
  "dhp81:2": "ei kõiguta mäge, ",
  "dhp81:3": "nõnda ei kõiguta laitused ",
  "dhp81:4": "ega kiitused tarku. ",
  "dhp82:1": "Just nagu hägu settides ",
  "dhp82:2": "puhastub sügav järv, "
}