{
  "dhp334:0.3": "Iha grupp ",
  "dhp334:1": "Hooletu käitumisega inimese ihad ",
  "dhp334:2": "kasvavad nagu ronitaime [väädid]. ",
  "dhp334:3": "Ta hüppab ühest elust teise ",
  "dhp334:4": "nagu vilju ihalev ahv metsas. ",
  "dhp335:1": "See, kelle [siin] maailmas ",
  "dhp335:2": "vallutavad madalad ihad [ja] kiindumus, ",
  "dhp335:3": "selle lein kasvab ",
  "dhp335:4": "nagu biiranarohi pärast vihma. ",
  "dhp336:1": "Kuid see, kes võidab siin maailmas raskelt ",
  "dhp336:2": "ületatava, madala iha, ",
  "dhp336:3": "sellelt langeb kurbus ",
  "dhp336:4": "kui veetilk lootose [lehelt]. ",
  "dhp337:1": "Ma ütlen teile: Olge te õnnelikud, ",
  "dhp337:2": "kes te siia olete kogunenud! ",
  "dhp337:3": "Kaevake välja ihajuur ",
  "dhp337:4": "nagu usiira [juure] saamiseks ",
  "dhp337:5": "MUUTA ",
  "dhp337:6": "MUUTA ",
  "dhp338:1": "Nii nagu ka vigastamata, tugevalt juurelt ",
  "dhp338:2": "mahalõigatud puu kasvab uuesti, ",
  "dhp338:3": "nõnda tekib ikka ja jälle dukkha ",
  "dhp338:4": "kuni iha kalduvus pole hävitatud. ",
  "dhp339:1": "Kelles voogavad võimsalt ",
  "dhp339:2": "36 meelepärast voogu, ",
  "dhp339:3": "[teda] kannab kirel põhinev ",
  "dhp339:4": "mõtlemine vale vaate poole. ",
  "dhp340:1": "Vood voogavad kõikjal. ",
  "dhp340:2": "Väädid väänlevad kindlalt ülespoole. ",
  "dhp340:3": "Olles näinud [iha] väädi võsu, ",
  "dhp340:4": "lõika tarkusega [selle] juur läbi. ",
  "dhp341:1": "Iha ja heameel ",
  "dhp341:2": "on voogamas olendeis. "
}