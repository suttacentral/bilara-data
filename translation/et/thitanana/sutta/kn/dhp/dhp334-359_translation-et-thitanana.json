{
  "dhp334:0.3": "Iha grupp ",
  "dhp334:1": "Hooletu käitumisega inimese ihad ",
  "dhp334:2": "kasvavad nagu ronitaime [väädid]. ",
  "dhp334:3": "Ta hüppab ühest elust teise ",
  "dhp334:4": "nagu vilju ihalev ahv metsas. ",
  "dhp335:1": "See, kelle [siin] maailmas ",
  "dhp335:2": "vallutavad madalad ihad [ja] kiindumus, ",
  "dhp335:3": "selle lein kasvab ",
  "dhp335:4": "nagu biiranarohi pärast vihma. ",
  "dhp336:1": "Kuid see, kes võidab siin maailmas raskelt ",
  "dhp336:2": "ületatava, madala iha, "
}