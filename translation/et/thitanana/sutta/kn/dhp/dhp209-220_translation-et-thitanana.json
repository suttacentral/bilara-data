{
  "dhp209:0.1": "LÜHIKESTE KOGU ",
  "dhp209:0.2": "DHAMMAVÄRSID ",
  "dhp209:0.4": "Sidudes ennast püüdlusega, ",
  "dhp209:1": "ja mitte sidudes ennast püüdlusega, millega tuleks siduda, ",
  "dhp209:2": "loobutakse (tõelisest) heolust. ",
  "dhp209:3": "Meeldiva järele haaraja kadestab ",
  "dhp209:4": "end (vabanemispüüdlusega) sidunut. ",
  "dhp210:1": "Ära ühine meeldivaga, ",
  "dhp210:2": "ega ealeski ebameeldivaga. ",
  "dhp210:3": "Meeldiva mittenägemine on dukkha, ",
  "dhp210:4": "nagu ka ebameeldiva nägemine. ",
  "dhp211:1": "Sestap ära pea midagi meeldivaks, ",
  "dhp211:2": "meeldivast lahkusolek on tõepoolest valus. ",
  "dhp211:3": "Pole kammitsaid sellel, ",
  "dhp211:4": "kes on meeldivast ja ebameeldivast vaba. ",
  "dhp212:1": "Meeldivast sünnib lein, ",
  "dhp212:2": "meeldivast sünnib hirm. ",
  "dhp212:3": "Meeldivast vabanenul pole leina, ",
  "dhp212:4": "kust siis hirm? ",
  "dhp213:1": "Armastusest sünnib lein, ",
  "dhp213:2": "armastusest sünnib hirm. ",
  "dhp213:3": "Armastusest vabanenul pole leina, ",
  "dhp213:4": "kust siis hirm? ",
  "dhp214:1": "Kiindumusest sünnib lein, ",
  "dhp214:2": "kiindumusest sünnib hirm. ",
  "dhp214:3": "Kiindumusest vabanenul pole leina, ",
  "dhp214:4": "kust siis hirm? ",
  "dhp215:1": "Naudingust sünnib lein, ",
  "dhp215:2": "naudingust sünnib hirm. ",
  "dhp215:3": "Naudingust vabanenul pole leina, ",
  "dhp215:4": "kust siis hirm? ",
  "dhp216:1": "Ihast sünnib lein, ",
  "dhp216:2": "ihast sünnib hirm. "
}