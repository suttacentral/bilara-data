{
  "dhp209:0.1": "LÜHIKESTE KOGU ",
  "dhp209:0.2": "DHAMMAVÄRSID ",
  "dhp209:0.4": "Sidudes ennast püüdlusega, ",
  "dhp209:1": "ja mitte sidudes ennast püüdlusega, millega tuleks siduda, ",
  "dhp209:2": "loobutakse (tõelisest) heolust. ",
  "dhp209:3": "Meeldiva järele haaraja kadestab ",
  "dhp209:4": "end (vabanemispüüdlusega) sidunut. ",
  "dhp210:1": "Ära ühine meeldivaga, ",
  "dhp210:2": "(ega) ealeski ebameeldivaga. "
}