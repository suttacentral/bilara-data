{
  "dhp179:0.1": "LÜHIKESTE KOGU ",
  "dhp179:0.2": "DHAMMAVÄRSID ",
  "dhp179:0.3": "Buddha grupp ",
  "dhp179:1": "Kelle võit pole kaotatav, ",
  "dhp179:3": "Kuidas olekski võimalik hävitada sellist mõistnut, ",
  "dhp179:4": "kes viibib lõputu pärusmaa jäljetus vallas? ",
  "dhp180:1": "Kelles pole kiindumuste võrku ",
  "dhp180:2": "ega iha, seda ei vii miski kaasa. ",
  "dhp180:3": "Kuidas olekski võimalik hävitada sellist mõistnut, ",
  "dhp180:4": "kes viibib lõputu pärusmaa jäljetus vallas? ",
  "dhp181:1": "Neid, džhaanas kinnistunud taiplikke, ",
  "dhp181:2": "ilmalikust loobunuid, täielikult rahunenuid ja rõõmsaid – ",
  "dhp181:3": "neid kadestavad deevadki, ",
  "dhp181:4": "äielikult mõistnuid, täielikult teadlikke. ",
  "dhp182:1": "Raske inimeseks saada, ",
  "dhp182:2": "raske sureliku elu; ",
  "dhp182:3": "raske õiget dhammat kuulda, ",
  "dhp182:4": "raske buddhaks saada. ",
  "dhp183:1": "Kõiksugu kurja mittetegemine, ",
  "dhp183:2": "oskusliku omandamine, ",
  "dhp183:3": "oma teadvuse puhastamine —",
  "dhp183:4": "see on buddhade õpetus. ",
  "dhp184:1": "Kannatlikkus ja andestamine on ülim askees; ",
  "dhp184:2": "vaibumine on ülim — ütlevad buddhad. ",
  "dhp184:3": "Tõepoolest, ei maisehüljanu teisi kahjusta, ",
  "dhp184:4": "ei erakrändur ole teistega vaenulik. ",
  "dhp185:1": "Mittesüüdistamine, mittekahjustamine ",
  "dhp185:2": "ja vabanemisjuhiste kohane eneseohjamine, ",
  "dhp185:3": "mõõdukus söömises ja erakluses elamine, ",
  "dhp185:5": "kõrgema teadvuse taotlemine —"
}