{
  "dhp383:1": "Lõika läbi voog, püüdle! ",
  "dhp383:2": "Eemaldu naudinguist, braahman! ",
  "dhp383:3": "Moodustiste hävinemist mõistes ",
  "dhp383:4": "mõistad mittetekkinut, braahman! ",
  "dhp384:1": "Kui kahe dhamma abil ",
  "dhp384:2": "on braahman vastaskaldale jõudnud, ",
  "dhp384:3": "siis kõik köidikud ",
  "dhp384:4": "sel teadjal hääbuvad. ",
  "dhp385:1": "Seda, kelle jaoks ei leidu vastaskallast, ",
  "dhp385:2": "siinpoolset kallast ega teispoolset kallast, ",
  "dhp385:3": "[seda], kartmatut ja sõltumatut – ",
  "dhp385:4": "teda nimetan ma braahmaniks. ",
  "dhp386:1": "Džhaai, kes istub plekituna, ",
  "dhp386:2": "teinud, mida tuleb teha, tulvadeta, ",
  "dhp386:3": "kõrgeima eesmärgi saavutanud – ",
  "dhp386:4": "teda nimetan ma braahmaniks. ",
  "dhp387:1": "Päike särab päeval, ",
  "dhp387:2": "kuu hiilgab öösel, ",
  "dhp387:3": "khattiya sõdalane särab turvises, "
}