{
  "dhp383:0.1": "LÜHIKESTE KOGU ",
  "dhp383:0.2": "DHAMMAVÄRSID ",
  "dhp383:0.3": "Braahmani grupp ",
  "dhp383:1": "Lõika läbi voog, püüdle! ",
  "dhp383:2": "Eemaldu naudinguist, braahman! ",
  "dhp383:3": "Moodustiste hävinemist mõistes ",
  "dhp383:4": "mõistad mittetekkinut, braahman! ",
  "dhp384:1": "Kui kahe dhamma abil ",
  "dhp384:2": "on braahman vastaskaldale jõudnud, ",
  "dhp384:3": "siis kõik köidikud ",
  "dhp384:4": "sel teadjal hääbuvad. ",
  "dhp385:1": "Seda, kelle jaoks ei leidu vastaskallast, ",
  "dhp385:2": "siinpoolset kallast ega teispoolset kallast, ",
  "dhp385:3": "[seda], kartmatut ja sõltumatut – ",
  "dhp385:4": "teda nimetan ma braahmaniks. ",
  "dhp386:1": "Džhaai, kes istub plekituna, ",
  "dhp386:2": "teinud, mida tuleb teha, tulvadeta, ",
  "dhp386:3": "kõrgeima eesmärgi saavutanud – ",
  "dhp386:4": "teda nimetan ma braahmaniks. ",
  "dhp387:1": "Päike särab päeval, ",
  "dhp387:2": "kuu hiilgab öösel, ",
  "dhp387:3": "khattiya sõdalane särab turvises, ",
  "dhp387:4": "braahman särab džhaanades. ",
  "dhp387:5": "Mõistnu aga särab kirkalt kogu aeg, ",
  "dhp387:6": "[nii] päeval [kui] öösel. ",
  "dhp388:1": "Kurjast eemaldunut nimetatakse braahmaniks ",
  "dhp388:2": "ja rahus elajat erakränduriks. ",
  "dhp388:3": "Maise ja mustuse endalt hüljanut ",
  "dhp388:4": "nimetatakse maisehüljanuks. ",
  "dhp389:1": "Ei braahmanit lööda, ",
  "dhp389:2": "ei braahman [viha] vallanda. ",
  "dhp389:3": "Häbi braahmani ründajale! ",
  "dhp389:4": "Suurem häbi sellele [braahmanile], kes [viha] vallandab! ",
  "dhp390:1": "Ei braahmanile ole miski parem, ",
  "dhp390:2": "kui pöörata meel kalliks [peetavast] eemale. ",
  "dhp390:3": "Kuivõrd meel pöördub vägivallast, ",
  "dhp390:4": "niivõrd vaibub ka dukkha. ",
  "dhp391:1": "Kes keha, kõne, ",
  "dhp391:2": "[ega] meelega valesti ei käitu, ",
  "dhp391:3": "[ning] ohjab neid kolme – ",
  "dhp391:4": "teda nimetan ma braahmaniks. ",
  "dhp392:1": "Kellelt oled õppinud dhammat, ",
  "dhp392:2": "mida Õigestimõistnu õpetas, ",
  "dhp392:3": "seda austa tänulikult ",
  "dhp392:4": "nagu braahman austab ohvrituld. ",
  "dhp393:1": "Ei pulstunud juuksed, ei põlvnemine, ",
  "dhp393:2": "ega sünnipära tee braahmaniks. ",
  "dhp393:3": "Kelles on tõde ja ka dhamma, ",
  "dhp393:4": "see [on] puhas, see [on] braahman. ",
  "dhp394:1": "Milleks sulle pulstunud juuksed, kehvaaruline? ",
  "dhp394:2": "Milleks sulle [antiloobi] nahast riided? ",
  "dhp394:3": "Sinu sees [on plekkide] tihnik, ",
  "dhp394:4": "[sa] puudutad [vaid] välist. ",
  "dhp395:1": "Olend, [kes] kannab tolmuhunnikust [korjatud] räbalaid, ",
  "dhp395:2": "[on nii] kõhn, [et naha alt paistavad välja] sooned ",
  "dhp395:3": "[ja] kes üksi metsas džhaanasid [harjutab] – ",
  "dhp395:4": "teda nimetan ma braahmaniks. ",
  "dhp396:1": "Kuid ma ei nimeta [kedagi] braahmaniks üsast ",
  "dhp396:2": "sündimise [ega] emast pärinemise [põhjal]. ",
  "dhp396:3": "Teda tuleks nimetada aulikuks, "
}