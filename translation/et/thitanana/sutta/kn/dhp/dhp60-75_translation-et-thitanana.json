{
  "dhp60:0.1": "LÜHIKESTE KOGU ",
  "dhp60:0.2": "DHAMMAVÄRSID ",
  "dhp60:0.3": "Lapsiku grupp ",
  "dhp60:1": "Öö [on] pikk ärkvelolijale, ",
  "dhp60:2": "joodžana [on] pikk väsinule, ",
  "dhp60:3": "sansaara [on] pikk lapsikule, ",
  "dhp60:4": "kes ei tea õiget dhammat. ",
  "dhp61:1": "Kui rändaja ei leia paremat ",
  "dhp61:2": "[või] endaga võrdset, ",
  "dhp61:3": "siis peaks ta kindlasti üksi rändama. ",
  "dhp61:4": "Lapsikuga ei saa olla sõprust. ",
  "dhp62:1": "„Mul on pojad, mul on varandus“, ",
  "dhp62:2": "muretseb lapsik. ",
  "dhp62:3": "Tõepoolest, [ta] pole endagi oma. ",
  "dhp62:4": "Kuis siis pojad? Kuis siis varandus? ",
  "dhp63:1": "Oma lapsikust teadev lapsik ",
  "dhp63:2": "on just nagu tark, ",
  "dhp63:3": "aga tarkusega uhkustavat lapsikut ",
  "dhp63:4": "võib tõepoolest lapsikuks nimetada. ",
  "dhp64:1": "Kui lapsik ka terve elu ",
  "dhp64:2": "targaga koos on, ",
  "dhp64:3": "ei mõista ta dhammat, ",
  "dhp64:4": "nagu ka lusikas supi maitset. ",
  "dhp65:1": "Kui arukas targaga ",
  "dhp65:2": "vaid hetke koos on, ",
  "dhp65:3": "mõistab ta dhammat kiiresti, ",
  "dhp65:4": "nagu ka keel supi maitset. ",
  "dhp66:1": "Lapsikud ja arutud "
}