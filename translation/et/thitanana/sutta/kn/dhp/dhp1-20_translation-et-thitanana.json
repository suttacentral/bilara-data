{
  "dhp1:0.1": "Lühikeste kogu ",
  "dhp1:0.2": "Dhammavärsid ",
  "dhp1:0.3": "Paaride grupp ",
  "dhp1:1": "Dhammade eel käib meel, ",
  "dhp1:2": "[dhammad on] meele juhitud, meele loodud. ",
  "dhp1:3": "Kes räägib või tegutseb ",
  "dhp1:4": "pahelise meelega, ",
  "dhp1:5": "sellele järgneb dukkha ",
  "dhp1:6": "nagu ratas vankrit vedavale jalale. ",
  "dhp2:1": "Dhammade eel käib meel, ",
  "dhp2:2": "[dhammad on] meele juhitud, meele loodud. ",
  "dhp2:3": "Kes räägib või tegutseb ",
  "dhp2:4": "puhta meelega, ",
  "dhp2:5": "sellele järgneb õnn ",
  "dhp2:6": "nagu kaasaskäiv vari. ",
  "dhp3:1": "„[Ta] sõimas mind, lõi mind, ",
  "dhp3:2": "võitis mind, röövis mind“ – ",
  "dhp3:3": "kes nii mõtlevad, ",
  "dhp3:4": "nende vaen ei vaibu. ",
  "dhp4:1": "„[Ta] sõimas mind, lõi mind, ",
  "dhp4:2": "võitis mind, röövis mind“ – ",
  "dhp4:3": "kes nii ei mõtle, ",
  "dhp4:4": "nende vaen vaibub. ",
  "dhp5:1": "Tõepoolest, siin [maailmas] ei vaibu ",
  "dhp5:2": "vaen kunagi vaenus, ",
  "dhp5:3": "vaid vaibub vaenu puudumises – ",
  "dhp5:4": "see on igavene dhamma. ",
  "dhp6:1": "Kuid paljud ei mõista, ",
  "dhp6:2": "[et peame] end siin [maailmas] ohjama. ",
  "dhp6:3": "Aga need, [kes] siin [maailmas seda] mõistavad, ",
  "dhp6:4": "vaigistavad seeläbi tülid. ",
  "dhp7:1": "Meeldiva vaatlemises viibija, ",
  "dhp7:2": "[kelle] võimed [on] ohjamata, ",
  "dhp7:3": "ja [kes on] söömises mõõdutu, ",
  "dhp7:4": "loid [ning] madala energiaga – ",
  "dhp7:5": "sellest, tõepoolest, saab Surm jagu, ",
  "dhp7:6": "nagu tuul jõuetust puust. ",
  "dhp8:1": "Ilutuse vaatlemises viibija, ",
  "dhp8:2": "[kelle] võimed [on] hästi ohjatud ",
  "dhp8:3": "ja [kes on] söömises mõõdukas, ",
  "dhp8:4": "[kel on] usk, otsusekindlus [ning] energilisus – ",
  "dhp8:5": "sellest, tõepoolest, Surm jagu ei saa, ",
  "dhp8:6": "nagu ka tuul kivisest mäest. ",
  "dhp9:1": "Tulvadega, taltumata ",
  "dhp9:2": "ja tõest eemaldunud ",
  "dhp9:3": "kollase rüü kandja – ",
  "dhp9:4": "tema ei vääri kollast [rüüd]. ",
  "dhp10:1": "Kuid kes on tulvad hüljanud, ",
  "dhp10:2": "kõlbeline, hästi rahunenud, ",
  "dhp10:3": "ega ole tõest eemaldunud, ",
  "dhp10:4": "tema, tõepoolest, väärib kollast [rüüd]. ",
  "dhp11:1": "[Kes] mitteolemust peavad olemuseks ",
  "dhp11:2": "ja olemust näevad mitteolemusena, ",
  "dhp11:3": "need ei avasta olemust ",
  "dhp11:4": "valede mõtete pärusmaal. ",
  "dhp12:1": "[Kes] teavad olemust [kui] olemust ",
  "dhp12:2": "ja mitteolemust [kui] mitteolemust, ",
  "dhp12:3": "need avastavad olemuse ",
  "dhp12:4": "õigete mõtete pärusmaal. ",
  "dhp13:1": "Nagu vihm tungib ",
  "dhp13:2": "halva rookatusega majja, ",
  "dhp13:3": "nõnda tungib kirg ",
  "dhp13:4": "arendamata teadvusesse. ",
  "dhp14:1": "Nagu vihm ei tungi ",
  "dhp14:2": "hea rookatusega majja, ",
  "dhp14:3": "nõnda ei tungi kirg ",
  "dhp14:4": "hästi arendatud teadvusesse. ",
  "dhp15:1": "Siin[ilmas] kurvastab [ja] seal [ilmas] kurvastab, ",
  "dhp15:2": "igal pool kurvastab kurja teinu. ",
  "dhp15:3": "Ta kurvastab, ta [on] löödud, ",
  "dhp15:4": "nähes enda ebapuhtaid tegusid. "
}