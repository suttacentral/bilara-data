{
  "dhp360:0.3": "Bhikkhu grupp ",
  "dhp360:1": "Silma ohjamine [on] hea. ",
  "dhp360:2": "Hea [on] kõrva ohjamine. ",
  "dhp360:3": "Nina ohjamine [on] hea. ",
  "dhp360:4": "Hea [on] keele ohjamine. ",
  "dhp361:1": "Keha ohjamine [on] hea. ",
  "dhp361:2": "Hea [on] kõne ohjamine. ",
  "dhp361:3": "Meele ohjamine [on] hea. ",
  "dhp361:4": "Hea [on] kõige ohjamine. ",
  "dhp361:5": "Kõike ohjav bhikkhu ",
  "dhp361:6": "vabaneb kogu dukkhast. ",
  "dhp362:1": "Kätt talitsev, jalga talitsev, ",
  "dhp362:2": "kõne talitsev, ülimalt talitsetud, ",
  "dhp362:3": "seesmiselt rõõmus [ja] rahus, ",
  "dhp362:4": "üksi rahulolev – teda nimetatakse bhikkhuks. ",
  "dhp363:1": "See bhikkhu kes talitseb suud, ",
  "dhp363:2": "räägib mõõdukalt, uhkuseta, ",
  "dhp363:3": "ja selgitab dhammat, ",
  "dhp363:4": "selle jutt [on] magus. ",
  "dhp364:1": "Dhammas rõõmustav, dhammale pühendunud, ",
  "dhp364:2": "dhamma üle mõtisklev ",
  "dhp364:3": "[ja] dhammat meelespidav bhikkhu ",
  "dhp364:4": "ei eemaldu õigest dhammast. ",
  "dhp365:1": "Elada tuleks saadut põlgamata ",
  "dhp365:2": "[ja] teisi mitte kadestades. ",
  "dhp365:3": "Teisi kadestav bhikkhu ",
  "dhp365:4": "ei saavuta keskendust. ",
  "dhp366:1": "Kui bhikkhu [on] ka vähe saanud, ",
  "dhp366:2": "kuid ei põlga saadut [ära], ",
  "dhp366:3": "[siis] sellist, tõepoolest, ülistavad deevad, ",
  "dhp366:4": "[seda], tüdimuseta, puhtuses elajat. ",
  "dhp367:1": "Ühelgi viisil nime ja vormiga ",
  "dhp367:2": "see, kes pole samastunud, ",
  "dhp367:3": "ega leina olematut, ",
  "dhp367:4": "teda, tõepoolest, nimetatakse bhikkhuks. ",
  "dhp368:1": "See, sõbralikkuses elav bhikkhu, ",
  "dhp368:2": "[kes] püsib Buddha õpetuses, ",
  "dhp368:3": "leiab rahu asupaiga ",
  "dhp368:4": "[ning] moodustiste rahunemise õnne. "
}