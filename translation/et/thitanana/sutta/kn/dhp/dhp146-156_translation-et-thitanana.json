{
  "dhp146:0.1": "LÜHIKESTE KOGU ",
  "dhp146:0.2": "DHAMMAVÄRSID ",
  "dhp146:0.3": "Vanaduse grupp ",
  "dhp146:1": "Kes naerab, kes rõõmustab ",
  "dhp146:2": "lakkamatus olemasolutules. ",
  "dhp146:3": "Pimedusega kaetud ",
  "dhp146:4": "ei otsi valgust. ",
  "dhp147:0": "",
  "dhp147:1": "Vaata seda teadvuse loodud kujutist, ",
  "dhp147:2": "kokku kuhjatud, haiglast haavade kogumikku, ",
  "dhp147:3": "paljude mõtetega, ",
  "dhp147:4": "milles pole ei kestvust [ega] kindlust. ",
  "dhp148:0": "Mädanev on see keha, "
}