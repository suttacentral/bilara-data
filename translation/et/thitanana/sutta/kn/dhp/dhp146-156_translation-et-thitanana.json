{
  "dhp146:0.1": "LÜHIKESTE KOGU ",
  "dhp146:0.2": "DHAMMAVÄRSID ",
  "dhp146:0.3": "Vanaduse grupp ",
  "dhp146:1": "Kes naerab, kes rõõmustab ",
  "dhp146:2": "lakkamatus olemasolutules. ",
  "dhp146:3": "Pimedusega kaetud ",
  "dhp146:4": "ei otsi valgust. ",
  "dhp147:0": "",
  "dhp147:1": "Vaata seda teadvuse loodud kujutist, ",
  "dhp147:2": "kokku kuhjatud, haiglast haavade kogumikku, ",
  "dhp147:3": "paljude mõtetega, ",
  "dhp147:4": "milles pole ei kestvust [ega] kindlust. ",
  "dhp148:0": "",
  "dhp148:1": "Mädanev on see keha, ",
  "dhp148:2": "habras haiguste pesa. ",
  "dhp148:3": "See roiskuv mass laguneb. ",
  "dhp148:4": "Tõepoolest, elu lõpeb surmaga. ",
  "dhp149:1": "Need hallid kondid, ",
  "dhp149:2": "kui sügisel ",
  "dhp149:3": "minema visatud kõrvitsad —",
  "dhp149:4": "kes näeb neis armastust? ",
  "dhp150:1": "See linn on tehtud kontidest, ",
  "dhp150:2": "krohvitud liha [ja] verega; ",
  "dhp150:3": "selles peituvad vanadus ja surm, ",
  "dhp150:4": "ning uhkus ja põlgus. ",
  "dhp151:1": "Tõepoolest, kuninga kaunid vankrid kuluvad, ",
  "dhp151:2": "samuti keha vananeb. ",
  "dhp151:3": "Aga tõelike dhamma ei vanane; ",
  "dhp151:4": "tõelikud õpetavad seda tõelikele. ",
  "dhp152:1": "Väheõppinud mees ",
  "dhp152:2": "vananeb nagu härg —",
  "dhp152:3": "tema liha kasvab, ",
  "dhp152:4": "kuid tema tarkus ei kasva. ",
  "dhp153:1": "Olen palju sünde "
}