{
  "dhp273:0.3": "Tee grupp ",
  "dhp273:1": "Teedest parim on kaheksaosaline, ",
  "dhp273:2": "tõdedest neli värssi, ",
  "dhp273:3": "dhammadest parim on kiretus ",
  "dhp273:4": "ja kahejalgsetest nägija. ",
  "dhp274:1": "Vaid see on õige tee, muud ei ole ",
  "dhp274:2": "nägemise puhastamiseks. ",
  "dhp274:3": "Sisenege sellesse! ",
  "dhp274:4": "See petab Surma ära! ",
  "dhp275:1": "Tõepoolest, sellesse sisenedes ",
  "dhp275:2": "teed sa dukkhale lõpu. ",
  "dhp275:3": "Kuulutanud olen teile ma seda teed, ",
  "dhp275:4": "olles mõistnud noole eemaldamist. ",
  "dhp276:1": "Te peate ise püüdlema, ",
  "dhp276:2": "tathaagatad on ainult tee kuulutajad. ",
  "dhp276:3": "Teele sisenenud džhaaid ",
  "dhp276:4": "vabanevad Surma köidikutest. ",
  "dhp277:1": "„Kõik moodustised on püsitud.“ ",
  "dhp277:2": "Kes seda tarkusega näeb, ",
  "dhp277:4": "see on puhastumise tee. ",
  "dhp278:1": "„Kõik moodustised on dukkha.“ ",
  "dhp278:2": "Kes seda tarkusega näeb, "
}