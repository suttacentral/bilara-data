{
  "dhp235:0.3": "Mustuse grupp ",
  "dhp235:1": "Sa oled nagu koltunud leht, ",
  "dhp235:2": "ja ka Yama mehed on sinu kaasavõtmiseks saabunud. ",
  "dhp235:3": "Sa seisad surma suus ",
  "dhp235:4": "ja teemoonaks pole sul midagi kaasa võtta. ",
  "dhp236:1": "Tee iseendale saar, ",
  "dhp236:2": "püüdle usinalt, ole tark! ",
  "dhp236:3": "Mustuse eemaldanud rüvetu ",
  "dhp236:4": "jõuab taevalikule arija tasandile. ",
  "dhp237:1": "Peagi oled jõudmas eluea lõppu ja ",
  "dhp237:2": "oled lähenemas Yama’ga kohtumisele. ",
  "dhp237:3": "Enne kohalejõudmist pole sul puhkepaika ",
  "dhp237:4": "ja teemoonaks pole sul midagi kaasa võtta. ",
  "dhp238:1": "Tee iseendale saar, ",
  "dhp238:2": "püüdle usinalt, ole tark! ",
  "dhp238:3": "Mustuse eemaldanud rüvetule ",
  "dhp238:4": "ei saabu enam uut sündi ega vananemist. ",
  "dhp239:1": "Arukas puhastab end ",
  "dhp239:2": "mustusest järk-järgult, ",
  "dhp239:3": "vähehaaval, hetkest-hetkesse, ",
  "dhp239:4": "nagu sepp puhastab hõbedat. ",
  "dhp240:1": "Nagu rooste sööb rauda, ",
  "dhp240:2": "millest rooste on tekkinud, ",
  "dhp240:3": "nõnda juhivad tarvikutega liialdava bhikkhu ",
  "dhp240:4": "tema enda teod halba uude sündi. ",
  "dhp241:1": "Mittekordamine määrib mantrad, ",
  "dhp241:2": "korratus määrib majad, ",
  "dhp241:3": "laiskus määrib ilu, ",
  "dhp241:4": "hooletus määrib valvuri. ",
  "dhp242:1": "Halb käitumine määrib naise, ",
  "dhp242:2": "ihnus määrib annetaja. ",
  "dhp242:3": "Tõepoolest, kurjad dhammad määrivad ",
  "dhp242:4": "nii selles kui ka teises maailmas. ",
  "dhp243:1": "Mustuste mustus on ",
  "dhp243:2": "mitteteadmine – see on ülim mustus. ",
  "dhp243:3": "Kõrvaldage see mustus, ",
  "dhp243:4": "olge mustuseta, bhikkhud! ",
  "dhp244:1": "Kerge on elada häbitul, ",
  "dhp244:2": "kaak-kangelasel, solvajal, ",
  "dhp244:3": "hooplejal ja hoolimatul, ",
  "dhp244:4": "kerge on elada ebapuhtal. ",
  "dhp245:1": "Kuid raske on elada häbivõimelisel, ",
  "dhp245:2": "lakkamatult puhtust otsijal, "
}