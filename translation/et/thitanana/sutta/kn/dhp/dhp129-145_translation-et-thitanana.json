{
  "dhp129:0.1": "KÜHIKESTE KOGU ",
  "dhp129:0.2": "DHAMMAVÄRSID ",
  "dhp129:0.3": "Malaka grupp ",
  "dhp129:1": "Kõik värisevad malaka ees, ",
  "dhp129:2": "kõik kardavad surma. ",
  "dhp129:3": "Kohtle teisi nagu ennast, ",
  "dhp129:4": "ära tapa ega põhjusta tapmist! ",
  "dhp130:1": "Kõik värisevad malaka ees, ",
  "dhp130:2": "kõigile on elu kallis. ",
  "dhp130:3": "Kohtle teisi nagu ennast, ",
  "dhp130:4": "ära tapa ega põhjusta tapmist. ",
  "dhp131:1": "Olendid naudivad õnne. ",
  "dhp131:2": "See, kes [teisi] malakaga kahjustab ",
  "dhp131:3": "iseendale õnne otsides, ",
  "dhp131:4": "ei saa peale surma õnnelikuks. ",
  "dhp132:1": "Olendid naudivad õnne. ",
  "dhp132:2": "See, kes teisi malakaga ei kahjusta ",
  "dhp132:3": "iseendale õnne otsides, ",
  "dhp132:4": "saab peale surma õnnelikuks. ",
  "dhp133:1": "Ära kellegagi räägi karmilt, ",
  "dhp133:2": "sellele võidakse vastata samaga. ",
  "dhp133:3": "Kannatust, tõepoolest, toob ägestund kõne, ",
  "dhp133:4": "[seepeale] võidakse malakaga vastu lüüa. ",
  "dhp134:1": "Kui sa ei võbele enam ",
  "dhp134:2": "nagu katkine gong, ",
  "dhp134:3": "siis oled jõudnud nibbaanasse; ",
  "dhp134:4": "ägestumist [siis] sinus enam ei leidu. ",
  "dhp135:1": "Nagu malakaga lehmakarjus ",
  "dhp135:2": "viib lehmi karjamaale, ",
  "dhp135:3": "nõnda ka vananemine ja surm "
}