{
  "dhp33:0.1": "LÜHIKESTE KOGU ",
  "dhp33:0.2": "DHAMMAVÄRSID ",
  "dhp33:0.3": "Teadvuse grupp ",
  "dhp33:1": "Kõikuva, muutliku, ",
  "dhp33:2": "raskesti valvatava ja raskesti ohjatava teadvuse ",
  "dhp33:3": "ajab tark sirgeks ",
  "dhp33:4": "nagu nooletegija noole. ",
  "dhp34:1": "Nagu vesisest kodust ",
  "dhp34:2": "kuivale heidetud kala ",
  "dhp34:3": "viskleb see teadvus, ",
  "dhp34:4": "et pääseda Surma võimu alt. ",
  "dhp35:1": "Raske on ohjata ",
  "dhp35:2": "kiiret naudinguisse laskumist. ",
  "dhp35:3": "Teadvuse taltsutamine on hea, ",
  "dhp35:4": "ohjeldatud teadvus toob õnne. ",
  "dhp36:1": "Väga raskesti nähtav, väga peen on ",
  "dhp36:2": "erinevatesse naudinguisse laskuv [teadvus]. ",
  "dhp36:3": "Arukas peab teadvust valvama. ",
  "dhp36:4": "Kaitstud teadvus toob õnne. ",
  "dhp37:1": "Kes elavad koopas ",
  "dhp37:2": "[ja] ohjavad kaugustesse püüdlevat, ",
  "dhp37:3": "üksi ekslevat, kehatut teadvust, ",
  "dhp37:4": "need pääsevad Surma kammitsaist. ",
  "dhp38:1": "Ebakindla teadvusega, ",
  "dhp38:2": "õiget dhammat teadmata, ",
  "dhp38:3": "usuta [ja] tarkuseta ",
  "dhp38:4": "ei saa täiuslikuks. ",
  "dhp39:1": "Lekkimatu teadvusega ",
  "dhp39:2": "[ja] hämminguta teadvusega, ",
  "dhp39:3": "pälvimused [ning] kurja ületanud ",
  "dhp39:4": "ärkvelolijal pole hirmu. ",
  "dhp40:1": "Saanud aru, [et] see keha on kui habras anum, ",
  "dhp40:2": "[ning] kujundanud selle teadvuse "
}