{
  "dhp197:0.1": "LÜHIKESTE KOGU ",
  "dhp197:0.2": "DHAMMAVÄRSID ",
  "dhp197:0.3": "Ünne grupp ",
  "dhp197:1": "Me elame tõesti väga õnnelikult, ",
  "dhp197:2": "(kes me) vihkamiseta vihkajate seas. ",
  "dhp197:3": "Haigete inimeste seas ",
  "dhp197:4": "elame me haigusteta. ",
  "dhp198:1": "Me elame tõesti väga õnnelikult, ",
  "dhp198:2": "kes me midagi ei oma. ",
  "dhp198:3": "Me saame söönuks rõõmust, ",
  "dhp198:4": "nagu hiilgavad deevad. ",
  "dhp199:1": "Võit tekitab vihkamist, "
}