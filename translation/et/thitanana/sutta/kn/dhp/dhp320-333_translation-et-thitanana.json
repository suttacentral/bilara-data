{
  "dhp320:0.3": "Elevandi grupp ",
  "dhp320:1": "Nagu elevant talub lahingus ",
  "dhp320:2": "vibudest lastud nooli, ",
  "dhp320:3": "nii talun ka mina solvanguid. ",
  "dhp320:4": "Tõepoolest, paljud inimesed on halva kõlblusega. ",
  "dhp321:1": "Taltsutatud elevant juhitakse kogunemisele. ",
  "dhp321:2": "Taltsutatud elevandi selga tõstetakse kuningas. ",
  "dhp321:3": "Taltunu, kes talub solvanguid, ",
  "dhp321:4": "on inimeste seas parim. ",
  "dhp322:1": "Parimad muulad on taltsutatud, ",
  "dhp322:2": "nagu Sindh’i tõuhobused, ",
  "dhp322:3": "väiksemad elevandid ja suuremad elevandid, ",
  "dhp322:4": "kuid kõigist parim on iseenda taltsutanu. ",
  "dhp323:1": "Tõepoolest, mittetaltsutatud looma vankris ",
  "dhp323:2": "ei saa minna mindamatu suunas, ",
  "dhp323:3": "kuhu iseenda hästi taltsutanu "
}