{
  "dhp290:0.3": "Mitmesuguse grupp ",
  "dhp290:1": "Nähes väiksema õnne hülgamises ",
  "dhp290:2": "suuremat õnne, ",
  "dhp291:1": "Kes enesele õnne soovides ",
  "dhp291:2": "teistele kannatusi põhjustab, ",
  "dhp291:3": "on liitunud vaenuga —",
  "dhp291:4": "see ei vabane vaenust. ",
  "dhp292:1": "Mida tõesti tuleks teha, lükkavad nad tagasi, ",
  "dhp292:2": "mida tõesti ei tuleks teha, seda teevad: ",
  "dhp292:3": "selliste upsakate ja hooletute ",
  "dhp292:4": "tulvad aina kasvavad. ",
  "dhp293:1": "Kuid kes on hästi põhjalikult ",
  "dhp293:2": "ja lakkamatult kehast teadlikud, ",
  "dhp293:3": "ei seo end sellega, mida ei tuleks teha, ",
  "dhp293:4": "teevad visalt seda, mida tuleks teha, ",
  "dhp293:5": "ning püsivad teadvustatud arusaamises, ",
  "dhp293:6": "nende tulvad lähevad looja. ",
  "dhp294:1": "Olles surmanud ema, isa, ",
  "dhp294:2": "ja kaks khatthia kuningat, ",
  "dhp294:3": "surmanud kogu kuningriigi koos järgijatega, ",
  "dhp294:4": "läheb braahman häirijateta edasi. ",
  "dhp295:1": "Olles surmanud ema, isa ",
  "dhp295:2": "ja kaks braahmanist kuningat, ",
  "dhp295:3": "surmanud viiendaks tiigri, ",
  "dhp295:4": "läheb braahman häirijateta edasi. ",
  "dhp296:1": "Hästi mõistnult virguvad ",
  "dhp296:2": "kunagi kõik Gootama õpilased, ",
  "dhp296:3": "kes nii päeval kui öösel ",
  "dhp296:4": "on pidevalt Buddhast teadlikud. ",
  "dhp297:1": "Hästi mõistnult virguvad ",
  "dhp297:2": "kunagi kõik Gootama õpilased, ",
  "dhp297:3": "kes nii päeval kui öösel ",
  "dhp297:4": "on pidevalt dhammast teadlikud. ",
  "dhp298:1": "Hästi mõistnult virguvad ",
  "dhp298:2": "kunagi kõik Gootama õpilased, ",
  "dhp298:3": "kes nii päeval kui öösel ",
  "dhp298:4": "on pidevalt sanghast teadlikud. ",
  "dhp299:1": "Hästi mõistnult virguvad ",
  "dhp299:2": "kunagi kõik Gootama õpilased, ",
  "dhp299:3": "kes nii päeval kui öösel ",
  "dhp299:4": "on pidevalt kehast teadlikud. ",
  "dhp300:1": "Hästi mõistnult virguvad ",
  "dhp300:2": "kunagi kõik Gootama õpilased, ",
  "dhp300:3": "kelle meel nii päeval kui öösel ",
  "dhp300:4": "rõõmustab vägivallatuses. ",
  "dhp301:1": "Hästi mõistnult virguvad ",
  "dhp301:2": "kunagi kõik Gootama õpilased, ",
  "dhp301:3": "kelle meel nii päeval kui öösel ",
  "dhp301:4": "rõõmustab keskenduse arendamises. ",
  "dhp302:1": "Raske on maise hülgamine, "
}