{
  "dhp290:0.3": "Mitmesuguse grupp ",
  "dhp290:1": "Nähes väiksema õnne hülgamises ",
  "dhp290:2": "suuremat õnne, ",
  "dhp291:1": "Kes enesele õnne soovides ",
  "dhp291:2": "teistele kannatusi põhjustab, ",
  "dhp291:3": "on liitunud vaenuga —",
  "dhp291:4": "see ei vabane vaenust. ",
  "dhp292:1": "Mida tõesti tuleks teha, lükkavad nad tagasi, ",
  "dhp292:2": "mida tõesti ei tuleks teha, seda teevad: ",
  "dhp292:3": "selliste upsakate ja hooletute ",
  "dhp292:4": "tulvad aina kasvavad. ",
  "dhp293:1": "Kuid kes on hästi põhjalikult ",
  "dhp293:2": "ja lakkamatult kehast teadlikud, ",
  "dhp293:3": "ei seo end sellega, mida ei tuleks teha, ",
  "dhp293:4": "teevad visalt seda, mida tuleks teha, ",
  "dhp293:5": "ning püsivad teadvustatud arusaamises, ",
  "dhp293:6": "nende tulvad lähevad looja.s "
}