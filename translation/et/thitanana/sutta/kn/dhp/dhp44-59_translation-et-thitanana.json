{
  "dhp44:0.1": "LÜHIKESTE KOGU ",
  "dhp44:0.2": "DHAMMAVÄRSID ",
  "dhp44:1": "Kes uurib läbi selle maailma ",
  "dhp44:2": "ja Yama maailma ühes deevadega? ",
  "dhp44:4": "Kes mõistab hästi õpetatud dhammavärssi, ",
  "dhp45:1": "nagu oskuslik, kes nopib lille? ",
  "dhp45:2": "ja Yama maailma ühes deevadega. ",
  "dhp45:3": "Õppija mõistab hästi õpetatud dhamma värssi, ",
  "dhp45:4": "ja Yama maailma ühes deevadega. ",
  "dhp46:0": "nagu oskuslik, kes nopib lille. "
