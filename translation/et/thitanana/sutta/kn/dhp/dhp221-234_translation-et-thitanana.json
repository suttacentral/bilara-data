{
  "dhp221:0.1": "LÜHIKESTE KOGU ",
  "dhp221:0.2": "DHAMMAVÄRSID ",
  "dhp221:0.3": "Viha grupp ",
  "dhp221:0.4": "Kes on vihast loobunud, uhkuse hüljanud, ",
  "dhp221:1": "kõik köidikud ületanud, ",
  "dhp221:2": "nimesse ja vormi mitteklammerdunud, ",
  "dhp221:3": "kel pole enam midagi, ",
  "dhp221:4": "see ei saa langeda dukkhasse. ",
  "dhp222:1": "See, kes tõepoolest üleskerkinud viha ",
  "dhp222:2": "rappuvat vankrit vaos hoiab, ",
  "dhp222:3": "seda nimetan ma vankrijuhiks. ",
  "dhp222:4": "Ülejäänud inimesed hoiavad vaid ohje. ",
  "dhp223:1": "Viha on võidetav vihatusega, ",
  "dhp223:2": "headusetus on võidetav headusega, ",
  "dhp223:3": "ihnus on võidetav annetamisega "
}