{
  "dhp167:0.1": "LÜHIKESTE KOGU ",
  "dhp167:0.2": "DHAMMAVÄRSID ",
  "dhp167:0.3": "Maailma grupp ",
  "dhp167:0.4": "Ära järgi madalaid dhammasid! ",
  "dhp167:1": "Ära järgi madalaid dhammasid! ",
  "dhp167:2": "Ära ela hooletuses! ",
  "dhp167:3": "Ära järgi valesid vaateid! ",
  "dhp167:4": "Ära ole maailma kiindunud! ",
  "dhp168:1": "Tõuse! Ära ole hooletu! ",
  "dhp168:2": "Järgi heasse juhtivat dhammat! ",
  "dhp168:3": "[Õige] dhamma järgija elab õnnelikult ",
  "dhp168:4": "selles maailmas ja [ka] teises. ",
  "dhp169:1": "Harjuta heasse juhtivat dhammat! ",
  "dhp169:2": "Ära harjuta halba juhtivat dhammat! ",
  "dhp169:3": "[Õige] dhamma järgija elab õnnelikult ",
  "dhp169:4": "selles maailmas ja [ka] teises. ",
  "dhp170:1": "Vaata [maailma] kui mulli, ",
  "dhp170:2": "vaata [seda] kui illusiooni – ",
  "dhp170:3": "nõnda maailma vaadates ",
  "dhp170:4": "Surmakuningas ei näe sind. ",
  "dhp171:1": "Tule, vaata seda maailma, ",
  "dhp171:2": "[mis] sarnaneb ehitud kuninga vankriga. ",
  "dhp171:3": "Kuhu lapsikud langevad, ",
  "dhp171:4": "[seal] pole klammerdumist mõistnuid. ",
  "dhp172:0": "Kes varem oli hooletu, "
}