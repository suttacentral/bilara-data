{
  "dhp256:0.3": "Dhammas püsija grupp ",
  "dhp256:1": "Ei ole dhammas püsija see, ",
  "dhp256:2": "kes kiirustades hindab õigeks. ",
  "dhp256:3": "Tark uurib mõlemat: ",
  "dhp256:4": "nii õiget kui mitteõiget. ",
  "dhp257:1": "Kes kiirustamata, dhamma kohaselt ",
  "dhp257:2": "ja erapooletult hindab teisi, ",
  "dhp257:3": "seda arukat dhamma kaitsjat ",
  "dhp257:4": "nimetatakse dhammas püsijaks. ",
  "dhp258:1": "Ei see ole tark, ",
  "dhp258:2": "kes palju räägib. ",
  "dhp258:3": "Rahulikku, vaenutut ja hirmutut ",
  "dhp258:4": "nimetatakse targaks. ",
  "dhp259:1": "Mitte seepärast pole ta dhamma hoidja, ",
  "dhp259:2": "et palju räägib. ",
  "dhp259:3": "See kes küll dhammat on vähe kuulnud, kuid ",
  "dhp259:4": "vaatleb kehas dhammat, ",
  "dhp259:5": "see, tõepoolest, on dhamma hoidja, ",
  "dhp259:6": "see on dhammas hoolikas. ",
  "dhp260:1": "Ei see ole vanem, ",
  "dhp260:2": "kel pea on hall. ",
  "dhp260:3": "Kes vaid ealiselt on vana, ",
  "dhp260:4": "teda nimetatakse kasutult vananenuks. ",
  "dhp261:1": "Kelles on aga tõde ja dhamma, ",
  "dhp261:2": "vägivallatus, vaoshoitus ja taltumus, ",
  "dhp261:3": "seda tarka, kes tõepoolest on mustused kõrvaldanud, ",
  "dhp261:4": "teda nimetatakse vanemaks. ",
  "dhp262:1": "Ei rohkesõnalisus ",
  "dhp262:2": "ega lootoslik jume ",
  "dhp262:3": "tee meest suurepärase kehastuseks, kui ta on ",
  "dhp262:4": "kade, ihne ja petlik. ",
  "dhp263:1": "Kuid see, kes on kadeduse, ",
  "dhp264:1": "Ei raseeritud pea tee erakränduriks ",
  "dhp264:2": "õiget dhammat mittejärgivat valskuse rääkijat. ",
  "dhp264:3": "Kuidas igatsusse ja ahnusesse langenu saakski ",
  "dhp264:4": "olla erakrändur? ",
  "dhp265:1": "See, kes vaigistab kogu kurja, ",
  "dhp265:2": "nii väikese kui suure, ",
  "dhp265:3": "seda, kurjuse tõepoolest vaigistanut, ",
  "dhp265:4": "nimetatakse erakränduriks. ",
  "dhp266:1": "Ei teistelt almuste kerjamine ",
  "dhp266:2": "tee kedagi bhikkhuks. ",
  "dhp266:3": "Bhikkhu pole see, ",
  "dhp266:4": "kes järgib igat dhammat. ",
  "dhp267:1": "Kes iganes on pälvimuse ja kurja ",
  "dhp267:2": "kõrvaldanud, käitub brahmalikult, ",
  "dhp267:3": "ning elab maailma olemust mõistes, ",
  "dhp267:4": "teda, tõepoolest, nimetatakse bhikkhuks. "
}