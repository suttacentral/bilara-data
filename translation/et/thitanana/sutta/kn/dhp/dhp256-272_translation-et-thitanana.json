{
  "dhp256:0.3": "Dhammas püsija grupp ",
  "dhp256:1": "Ei ole dhammas püsija see, ",
  "dhp256:2": "kes kiirustades hindab õigeks. ",
  "dhp256:3": "Tark uurib mõlemat: ",
  "dhp256:4": "nii õiget kui mitteõiget. ",
  "dhp257:1": "Kes kiirustamata, dhamma kohaselt ",
  "dhp257:2": "ja erapooletult hindab teisi, ",
  "dhp257:3": "seda arukat dhamma kaitsjat ",
  "dhp257:4": "nimetatakse dhammas püsijaks. ",
  "dhp258:1": "Ei see ole tark, ",
  "dhp258:2": "kes palju räägib. ",
  "dhp258:3": "Rahulikku, vaenutut ja hirmutut ",
  "dhp258:4": "nimetatakse targaks. ",
  "dhp259:1": "Mitte seepärast pole ta dhamma hoidja, ",
  "dhp259:2": "et palju räägib. ",
  "dhp259:3": "See kes küll dhammat on vähe kuulnud, kuid ",
  "dhp259:4": "vaatleb kehas dhammat, ",
  "dhp259:5": "see, tõepoolest, on dhamma hoidja, ",
  "dhp259:6": "see on dhammas hoolikas. "
}