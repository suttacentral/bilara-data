{
  "dhp33:0.1": "მცირე კრებული (ხუდდაკა–ნიკაია) ",
  "dhp33:0.2": "წმინდა პწკარები 33-43 ",
  "dhp33:0.3": "3. გონი ",
  "dhp33:1": "გონი თრთის და ირყევა, ",
  "dhp33:2": "რთულია მისი მოფრთხილება და ალაგმვა. ",
  "dhp33:3": "ბრძენი მას ისე ასწორებს, ",
  "dhp33:4": "როგორც ჯოლბორდი – ისარს. ",
  "dhp34:1": "როგორც თევზი, რომელიც წყლიდან ამოიყვანეს ",
  "dhp34:2": "და ნაპირზე მოისროლეს, ",
  "dhp34:3": "გონიც ისევე ფართხალებს, ",
  "dhp34:4": "რადგან ცდილობს, მარას ბატონობის მოშორებას. ",
  "dhp35:1": "რთულია მისი მოთოკვა, იგი მოუსვენარია, ",
  "dhp35:2": "იქ მიიჩქარის, სადაც მოესურვება; ",
  "dhp35:3": "კარგია გონის მოთვინიერება, ",
  "dhp35:4": "რადგან თვინიერ გონს ბედნიერება მოაქვს. ",
  "dhp36:1": "იგი ძნელად შესამჩნევნი და ფაქიზია, ",
  "dhp36:2": "იქ მიიჩქარის, სადაც მოესურვება; ",
  "dhp36:3": "ბრძენი გონს იცავს, ",
  "dhp36:4": "რადგან დაცულ გონს ბედნიერება მოაქვს. ",
  "dhp37:1": "გონი ბევრს მოგზაურობს, მარტო დახეტიალობს, ",
  "dhp37:2": "უსხეულოა, გულის კუნჭულში იმალება. ",
  "dhp37:3": "ვინც გონს დაიმორჩილებს, ",
  "dhp37:4": "მარას ბორკილესგან თავისუფლდება. ",
  "dhp38:1": "ვისაც არამტკიცე გონი აქვს, "
}