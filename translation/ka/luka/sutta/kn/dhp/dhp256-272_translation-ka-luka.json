{
  "dhp256:0.1": "მცირე კრებული (ხუდაკა-ნიკაია) ",
  "dhp256:0.2": "ჭეშმარიტების გზა (დჰამაპადა) 256-272 ",
  "dhp256:0.3": "19. მართალნი ",
  "dhp256:0.4": "",
  "dhp256:1": "ნაჩქარევად განსჯით ",
  "dhp256:2": "სამართლიანი ვერ გახდები. ",
  "dhp256:3": "გონიერ კაცს ორივეს შეფასება შეუძლია – ",
  "dhp256:4": "მართებულისაც და არამართებულისაც. ",
  "dhp257:1": "ბრძენი სხვას აუჩქარებლად აფასებს, ",
  "dhp257:2": "სამართლიანად და მიუკერძოებლად. ",
  "dhp257:3": "სწავლების ეს გონიერი მცველი, ",
  "dhp257:4": "სამართლიანად იწოდება. ",
  "dhp258:0": "",
  "dhp258:1": "კაცი არ არის ბრძენი ",
  "dhp258:2": "მხოლოდ იმიტომ, რომ ბევრს საუბრობს. ",
  "dhp258:3": "ვინც მშვიდია, მტრობისა და შიშისაგან თავისუფალი, ",
  "dhp258:4": "სწორედ ის ბრძენად იწოდება. ",
  "dhp259:0": "",
  "dhp259:1": "კაცი არ არის სწავლების გულით მატარებელი, ",
  "dhp259:2": "მხოლოდ იმიტომ, რომ ბევრს ღაღადებს. ",
  "dhp259:3": "ვინც ცოტას მოსმენის შემდეგაც კი, ",
  "dhp259:4": "უშუალოდ ჭვრეტს სწავლებას, ",
  "dhp259:5": "ჭეშმარიტად ის არის სწავლების გულით მატარებელი, ",
  "dhp259:6": "რამეთუ იგი არასოდეს ივიწყებს მას. ",
  "dhp260:0": "",
  "dhp260:1": "კაცი არ ხდება უხუცესი, ",
  "dhp260:2": "მხოლოდ ჭაღარა თმების გამო. ",
  "dhp260:3": "ვისაც მხოლოდ ასაკი ემატება, ",
  "dhp260:4": "ამაოდ ბერდება. ",
  "dhp261:1": "ვინც მართალი და სწავლების მიმდევარია, ",
  "dhp261:2": "უვნებელია, თავშეკავებული და თავდაჭერილი, ",
  "dhp261:3": "ფხიზელი და ბიწისგან განწმენდილი, ",
  "dhp261:4": "სწორედ ის უხუცესად იწოდება. ",
  "dhp262:0": "",
  "dhp262:1": "თუკი ადამიანი ძუნწი, შურიანი და მზაკვარია, ",
  "dhp262:2": "მხოლოდ მჭევრმეტყველებით, ",
  "dhp262:3": "ან სახის მშვენიერებით ",
  "dhp262:4": "ვერ გახდება იგი სათნო. ",
  "dhp263:1": "მაგრამ, ვისაც ეს ყველაფერი მოკვეთილი, ",
  "dhp263:2": "ძირფესვიანად ამოთხრილი და განადგურებული აქვს, ",
  "dhp263:3": "ბრძენი და უბიწო, ",
  "dhp263:4": "სათნოდ იწოდება. ",
  "dhp264:0": "",
  "dhp264:1": "თუკი ადამიანი აღთქმას არღვევს და ცრუობს, ",
  "dhp264:2": "თუკი ლტოლვითა და სიხარბით არის სავსე, ",
  "dhp264:3": "სულაც რომ თავი გადაიპარსოს, ",
  "dhp264:4": "ასეთი ადამიანი განდეგილი როგორ გახდება? ",
  "dhp265:1": "ვინც აღკვეთს ყოველგვარ ბოროტ საქმეს, ",
  "dhp265:2": "დიდსა თუ მცირეს, ",
  "dhp265:3": "ბოროტების დაცხრომის გამო, ",
  "dhp265:4": "განდეგილად იწოდება. ",
  "dhp266:0": "",
  "dhp266:1": "თუკი ადამიანი ამქვეყნიური ცხოვრებით ცხოვრობს, ",
  "dhp266:2": "ის ჯერ არ არის ბერი; ",
  "dhp266:3": "მხოლოდ სხვებისგან მოწყალების თხოვნით ",
  "dhp266:4": "ბერი ვერ გახდები. ",
  "dhp267:1": "ვინც წმინდა წმინდა ცხოვრებით ცხოვრობს, ",
  "dhp267:2": "ვინც განთავისუფლდა სიკეთისა და ბოროტებისაგან, ",
  "dhp267:3": "ვინც ამ სოფლად შემეცნებით დაიარება, ",
  "dhp267:4": "ის იწოდება ბერად. ",
  "dhp268:0": "",
  "dhp268:1": "თუკი ადამიანი კვლავ გზააბნეული და უმეცარია, ",
  "dhp268:2": "ის ჯერ არ არის ბრძენი; მხოლოდ გარეგანი ბრძნობით  ბერი ვერ გახდები. ",
  "dhp268:3": "გონიერი კაცი, სასწორთმპყრობელი, ",
  "dhp268:4": "მხოლოდ საუკეთესოს ირჩევს, ",
  "dhp269:1": "და ბოროტს განერიდება – ",
  "dhp269:2": "სწორედ ის არის ბრძენი და ასე გახდები ბრძენი. ",
  "dhp269:3": "ვინც სამყაროში ორივეს შეიმეცნებს, ",
  "dhp269:4": "სწორედ ის არის ბრძენი. ",
  "dhp270:0": "",
  "dhp270:1": "თუკი ცოცხალ არსებებს ზიანს აყენებ, ",
  "dhp270:2": "კეთილშობილი ვერ გახდები. ",
  "dhp270:3": "ვინც არ ვნებს ცოცხალ არსებებს, ",
  "dhp270:4": "სწორედ ის არის კეთილშობილი. ",
  "dhp271:0": "",
  "dhp271:1": "არც მხოლოდ წესებითა და რიტუალებით, ",
  "dhp271:2": "არც განსწავლით, ",
  "dhp271:3": "არც მედიტაციური შთანთქმით, ",
  "dhp271:4": "არც განმარტოებით ",
  "dhp272:1": "ვეზიარები განდგომილების იმ ნეტარებას, ",
  "dhp272:2": "რომელიც უცხოა ჩვეულებრივი ადამიანისთვის. ",
  "dhp272:3": "ბერი ვერ იქნება მშვიდად, ",
  "dhp272:4": "სანამ ბიწებს სრულად არ განლევს. ",
  "dhp272:5": ""
}