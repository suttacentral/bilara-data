{
  "dhp1:0.1": "მცირე კრებული (ხუდდაკა–ნიკაია) ",
  "dhp1:0.2": "ჭეშმარიტების სწავლებანი 1-20 ",
  "dhp1:0.3": "1. წყვილი სტროფები ",
  "dhp1:1": "განზრახვა განსაზღვრავს გამოცდილებას; ",
  "dhp1:2": "განზრახვა უპირველესია, ის ქმნის ყოველივეს. ",
  "dhp1:3": "თუკი დამახინჯებული განზრახვით ",
  "dhp1:4": "ისაუბრებ ან იმოქმედებ, ",
  "dhp1:5": "ტანჯვა მოგყვება თან, ",
  "dhp1:6": "როგორც ურმის თვალი მიყვება ხარის ნაბიჯს. ",
  "dhp2:1": "განზრახვა განსაზღვრავს გამოცდილებას; ",
  "dhp2:2": "განზრახვა უპირველესია, ის ქმნის ყოველივეს. ",
  "dhp2:3": "თუკი სუფთა განზრახვით ",
  "dhp2:4": "ისაუბრებ ან იმოქმედებ, ",
  "dhp2:5": "ბედნიერება მოგყვება თან, ",
  "dhp2:6": "როგორც ჩრდილი, რომელიც არასოდეს გტოვებს. ",
  "dhp3:1": "“მან გამლანძღა, მან დამარტყა! ",
  "dhp3:2": "მან მცემა, მან გამქურდა!” ",
  "dhp3:3": "მათთვის, ვინც მსგავს წყენას ატარებს, ",
  "dhp3:4": "სიძულვილი არასოდეს მიყუჩდება. ",
  "dhp4:1": "“მან გამლანძღა, მან დამარტყა! ",
  "dhp4:2": "მან მცემა, მან გამქურდა!” ",
  "dhp4:3": "მათთვის, ვინც მსგავს წყენას არ ატარებს, ",
  "dhp4:4": "სიძულვილი მიყუჩდება. ",
  "dhp5:1": "ვინაიდან სიძულვილი ",
  "dhp5:2": "სიძულვილით არასოდეს მიყუჩდება, ",
  "dhp5:3": "არამედ, მხოლოდ სიყვარულით: ",
  "dhp5:4": "ეს უძველესი სწავლებაა. ",
  "dhp6:1": "თუკი სხვებს ეს არ ესმით, ",
  "dhp6:2": "დაე ჩვენ, ვისაც ეს გვესმის, ",
  "dhp6:3": "თავშეკავებულნი ვიყოთ ამ მხრივ; ",
  "dhp6:4": "ვინაიდან სწორედ ასე ყუჩდება დაპირისპირება. ",
  "dhp7:1": "ვინც ეწაფება მშვენიერებას, ",
  "dhp7:2": "თავაშვებულად, ",
  "dhp7:3": "სიმაძღრით, ",
  "dhp7:4": "სიზარმაცით, უსაქმურობით: ",
  "dhp7:5": "მარა მათ მოერევა, ",
  "dhp7:6": "როგორც ქარი – სუსტ ხეს. ",
  "dhp8:1": "ვინც შეისწავლის სიბიძნურეს, ",
  "dhp8:2": "თავშეკავებულად, ",
  "dhp8:3": "ზომიერი კვებით, ",
  "dhp8:4": "რწმენით და შემართებით: ",
  "dhp8:5": "მარა მათ ვერ მოერევა, ",
  "dhp8:6": "როგორც ქარი ვერ მოერევა კლდოვან მთას. ",
  "dhp9:1": "იგი, ვინც იმოსება ოხრად შეფერილი სამოსით, ",
  "dhp9:2": "და თავად არ არის უმანკო, ",
  "dhp9:3": "თავშეკავებასა და ჭეშმარიტებას მოკლებული, ",
  "dhp9:4": "არ არის ღირსი ამ სამოსის. ",
  "dhp10:1": "იგი, ვინც განწმინდა ყველა თავისი მანკი, ",
  "dhp10:2": "მტკიცე ზნეობით, ",
  "dhp10:3": "თავშეკავებისა და ჭეშმარიტების ფლობით, ",
  "dhp10:4": "ჭეშმარიტად ღირსია ოხრად შეფერილი სამოსის. ",
  "dhp11:1": "ვინც უმნიშვნელოს მნიშვნელოვნად მიიჩნევს, ",
  "dhp11:2": "მნიშვნელოვანს კი უმნიშვნელოდ, ",
  "dhp11:3": "ვერ იაზრებს მნიშვნელოვანს, ",
  "dhp11:4": "ვინაიდან არასწორი აზროვნება მათი სავანეა. ",
  "dhp12:1": "ვინც მნიშვნელოვანს შეიცნობს, როგორც მნიშვნელოვანს, ",
  "dhp12:2": "ხოლო უმნიშვნელოს – როგორც უმნიშვნელოს; ",
  "dhp12:3": "იაზრებს მნიშვნელოვანს, ",
  "dhp12:4": "ვინაიდან სწორი აზროვნებაა მათი სავანე. ",
  "dhp13:1": "ისევე, როგორც წვიმა ჟონავს ",
  "dhp13:2": "უხეიროდ გადახურულ სახლში, ",
  "dhp13:3": "ასევე ჟონავს ვნება ",
  "dhp13:4": "განუვითარებელ გონებაში. ",
  "dhp14:1": "ისევე, როგორც წვიმა არ ჟონავს ",
  "dhp14:2": "კარგად გადახურულ სახლში, ",
  "dhp14:3": "ასევე არ ჟონავს ვნება ",
  "dhp14:4": "კარგად განვითარებულ გონებაში. ",
  "dhp15:1": "ისინი ამიერშიც და იმიერშიც გლოვობენ, ",
  "dhp15:2": "რადგან ბოროტის მქმნელი ორივეგან გლოვობს. ",
  "dhp15:3": "ისინი გლოვობენ და ბორგავენ, ",
  "dhp15:4": "ვინაიდან ხედავენ საკუთარ გახრწნილ საქციელს. ",
  "dhp16:1": "ისინი ამიერშიც და იმიერშიც ხარობენ, ",
  "dhp16:2": "რადგან კარგის მქმნელი ორივეგან ხარობს. ",
  "dhp16:3": "ისინი ხარობენ და ზეიმობენ, ",
  "dhp16:4": "ვინაიდან ხედავენ საკუთარ წმინდა საქციელს. ",
  "dhp17:1": "ისინი ამიერშიც და იმიერშიც იტანჯებიან, ",
  "dhp17:2": "რადგან ბოროტის მქმნელი ორივეგან იტანჯება. ",
  "dhp17:3": "ისინი იტანჯებიან, ვინაიდან ფიქრობენ საკუთარ ცუდ საქციელზე; ",
  "dhp17:4": "როდესაც ცუდ ადგილას მიდიან, ისინი კიდევ უფრო იტანჯებიან. ",
  "dhp18:1": "ისინი ამიერშიც და იმიერშიც ნეტარებენ, ",
  "dhp18:2": "რადგან კარგის მქნელი ორივეგან ნეტარებს. ",
  "dhp18:3": "ისინი ნეტარებენ ვინაიდან ფიქრობენ საკუთარ კარგ საქციელზე. ",
  "dhp18:4": "როდესაც კარგ ადგილას მიდიან, ისინი კიდევ უფრო ნეტარებენ. ",
  "dhp19:1": "რამდენიც არ უნდა იკითხოს წმინდა წერილი, ",
  "dhp19:2": "თუკი დაუდევარი ადამიანი მას არ მიჰყვება, ",
  "dhp19:3": "მაშინ, როგორც მწყემსი, რომელიც სხვის ნახირს ითვლის, ",
  "dhp19:4": "ისიც აკლდება განდეგილი ცხოვრების მადლს. ",
  "dhp20:1": "სულაც რომ იშვიათად იკითხოს წმინდა წერილი, ",
  "dhp20:2": "თუკი იგი მას სწორად მიჰყვება, ",
  "dhp20:3": "რამეთუ მიატოვა სიხარბე, სიძულვილი და უგუნურება, ",
  "dhp20:4": "ღრმა შემეცნებით და განთავისუფლებული გულით, ",
  "dhp20:5": "თუკი არ ეჭიდება ამ ცხოვრებას ანდა შემდეგს, ",
  "dhp20:6": "იგი იზიარებს განდეგილი ცხოვრების მადლს. "
}