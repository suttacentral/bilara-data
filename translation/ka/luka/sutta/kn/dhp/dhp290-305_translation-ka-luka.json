{
  "dhp290:0.1": "მცირე კრებული (ხუდაკა-ნიკაია) ",
  "dhp290:0.2": "ჭეშმარიტების გზა (დჰამაპადა) 290-305 ",
  "dhp290:0.3": "21. სხვადასხვაგვარი ",
  "dhp290:1": "თუკი მცირე ბედნიერებაზე უარის თქმას ",
  "dhp290:2": "უხვი ბედნიერება მოაქვს, ",
  "dhp290:3": "გონიერმა უარი უნდა თქვას მცირე ბედნიერებაზე ",
  "dhp290:4": "და უხვი ბედნიერება მოიპოვოს. ",
  "dhp291:1": "ვინც საკუთარ ბედნიერებას ეძებს ",
  "dhp291:2": "სხვისთვის ტანჯვის მიყენებით, ",
  "dhp291:3": "სიძულვილთან წილნაყარი, ",
  "dhp291:4": "ვერასოდეს განთავისუფლდება სიძულვილისაგან. ",
  "dhp292:1": "ვინც უგულებელყოფს იმას, რაც უნდა გაკეთდეს ",
  "dhp292:2": "და აკეთებს იმას, რაც არ უნდა გაკეთდეს, ",
  "dhp292:3": "ამპარტავანი და დაუდევარი, ",
  "dhp292:4": "მანკიერება მხოლოდ ემატება. ",
  "dhp293:1": "ვინც სწორედ წარმართავს ",
  "dhp293:2": "სხეულებრივი გაცნობიერებულობა, ",
  "dhp293:3": "არ ესწრაფვის იმას, რაც არ უნდა გაკეთდეს, ",
  "dhp293:4": "და ყოველთვის აკეთებს იმას, რაც უნდა გაკეთდეს ",
  "dhp293:5": "გაცნობიერებული და ფხიზელი, ",
  "dhp293:6": "მანკიერება ქრება. ",
  "dhp294:1": "დედ-მამისა და ",
  "dhp294:2": "ორი დიდგვაროვანი მეფის მოკვლის შემდეგ; ",
  "dhp294:3": "სამეფოსა და მისი მებაჟის განადგურების შემდეგ, ",
  "dhp294:4": "ბრაჰმინი გზას უდარდელად აგრძელებს. ",
  "dhp295:1": "დედ-მამისა და "
}