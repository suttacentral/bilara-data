{
  "dhp21:0.1": "მცირე კრებული (ხუდდაკა–ნიკაია) ",
  "dhp21:0.2": "წმინდა პწკარები 21-23 ",
  "dhp21:0.3": "2. გულმოდგინება ",
  "dhp21:1": "სიფხიზლე სიკვდილისგან თავისუფალი მდგომარეობაა; ",
  "dhp21:2": "დაუდევრობა კი – სიკვდილის. ",
  "dhp21:3": "ფხიზელნი არ კვდებიან, ",
  "dhp21:4": "ხოლო დაუდევარნი თითქოს უკვე მკვდრები არიან. ",
  "dhp22:1": "ესმით რა ეს სხვაობა, ",
  "dhp22:2": "ფხიზელნი ხარობენ ",
  "dhp22:3": "საკუთარი სიფხიზლით, ",
  "dhp22:4": "ბედნიერნი დიადთა სამკვიდროში ყოფნით. ",
  "dhp23:1": "ვინც მუდამ მედიტაციას აკეთებს, ",
  "dhp23:2": "დიდი მონდომებით; ",
  "dhp23:3": "ყურადღებიანნი აღწევენ ნირვანას, ",
  "dhp23:4": "უღელიდან უზენაეს თავშესაფარს. ",
  "dhp24:1": "ვინც ბეჯითი და გაცნობიერებულია, ",
  "dhp24:2": "საქმით წმინდა და ყურადღებიანი, ",
  "dhp24:3": "მოზომილი, მართალი და გულმოდგინე, ",
  "dhp24:4": "მისი სახელი მხოლოდ უმჯობესება. ",
  "dhp25:1": "სიბეჯითითა და გულმოდგინებით, ",
  "dhp25:2": "მოზომვითა და თავშეკავებით, ",
  "dhp25:3": "გონიერი ადამიანი აშენებს კუნძულს, ",
  "dhp25:4": "რომელსაც ვერანაირი წყალდიდობა ვერ წალეკავს. "
}