{
  "dhp60:0.1": "მცირე კრებული (ხუდდაკა–ნიკაია) ",
  "dhp60:0.2": "ჭეშმარიტების სწავლება 60-75 ",
  "dhp60:0.3": "5. უგუნურნი ",
  "dhp60:1": "გრძელია ღამე მათთვის, ვისაც ღვიძავთ, ",
  "dhp60:2": "გრძელია სავალი მათთვის, ვინც დაღლილია, ",
  "dhp60:3": "დიდხანს ხეტიალობენ უგუნურნი, ",
  "dhp60:4": "რომელთაც ჭეშმარიტი მოძღვრება არ ესმით. ",
  "dhp61:1": "თუკი ხეტიალისას ვერ იპოვნე მეგზური, ",
  "dhp61:2": "შენი ტოლსწორი ანდაც შენზე უკეთესი, ",
  "dhp61:3": "მაშინ ჯობს მარტო იხეტიალო, ",
  "dhp61:4": "რადგან უგუნურთან ვერ იამხანაგებ. ",
  "dhp62:1": "“ჩემი ვაჟები მე მეკუთვნის, ჩემი ქონება მე მეკუთვნის” – ",
  "dhp62:2": "ბორგავს უგუნური. ",
  "dhp62:3": "რამეთუ საკუთარი თავიც კი არ გეკუთვნის შენ, ",
  "dhp62:4": "არამცთუ ვაჟები ან ქონება. ",
  "dhp63:1": "უგუნური, რომელმაც იცის საკუთარი უგუნრება, ",
  "dhp63:2": "ამ საკითხში მაინც არის ბრძენი. ",
  "dhp63:3": "სწორედ ის არის ჭეშმარიტად უგუნური, ",
  "dhp63:4": "ვისაც თავი ბრძენი ჰგონია. ",
  "dhp64:1": "უგუნური, თუნდაც მთელი ცხოვრება ",
  "dhp64:2": "უსმენდეს სიბრძნეს, ",
  "dhp64:3": "მაინც ვერ იგებს სწავლებას, ",
  "dhp64:4": "როგორც კოვზი ვერ იგებს წვნიანის გემოს. ",
  "dhp65:1": "გონიერი, თუნდაც მცირე ხნით ",
  "dhp65:2": "მოისმინოს სიბრძნე, ",
  "dhp65:3": "მალევე იგებს სწავლებას, ",
  "dhp65:4": "როგორც ენა – წვნიანის გემოს. ",
  "dhp66:1": "უგუნური და უვიცი საკუთარი ",
  "dhp66:2": "თავის ყველაზე დიდი მტერია. "
}