{
  "dhp334:0.1": "მცირე კრებული (ხუდაკა-ნიკაია) ",
  "dhp334:0.2": "ჭეშმარიტების გზა (დჰამაპადა) 334-359 ",
  "dhp334:0.3": "24. ლტოლვა ",
  "dhp334:0.4": "",
  "dhp334:1": "როდესაც ადამიანი დაუდევრად ცხოვრობს, ",
  "dhp334:2": "მასში ლტოლვა მხვიარა ლიანებივით იზრდება. ",
  "dhp334:3": "ის აქეთ-იქით დახტის, ",
  "dhp334:4": "როგორც მაიმუნი, რომელიც ტყეში ხილს ეძებს. ",
  "dhp335:1": "ვისაც ეს საძაგელი ლტოლვა და ",
  "dhp335:2": "სამყაროზე მიჯაჭვულობა დაჯაბნის, ",
  "dhp335:3": "როგორც წვიმაში ბალახი, ",
  "dhp335:4": "მისი დარდიც იზრდება. ",
  "dhp336:1": "მაგრამ, ვინც ამ ლტოლვას დაჯაბნის, ",
  "dhp336:2": "რომლის დაძლევაც ამქვეყნად ასეოდენ რთულია, ",
  "dhp336:3": "მწუხარება შორდება მას, ",
  "dhp336:4": "როგორც ფოთოლს – წყლის წვეთი. ",
  "dhp337:1": "მოგმართავთ, ",
  "dhp337:2": "აქ შეკრებილო პატივცემულნო: ",
  "dhp337:3": "ამოთხარეთ ლტოლვის ფესვი, ",
  "dhp337:4": "როგორც ამოთხრიდით სარეველას ფესვების ძიებისას. ",
  "dhp337:5": "ნუ მისცემ მარას უფლებას კიდევ და კიდევ გაგტეხოს, ",
  "dhp337:6": "როგორც მდინარის დინება ტეხს ლერწამს. ",
  "dhp338:0": "",
  "dhp338:1": "მოჭრილი ხეც კი ხელახლა იზრდება, ",
  "dhp338:2": "თუკი მისი ფესვები ძლიერი და დაუზიანებელია; ",
  "dhp338:3": "ტანჯვაც კვლავ და კვლავ აღმოცენდება, ",
  "dhp338:4": "სანამ ლტოლვისაკენ მიდრეკილება არ ამოიძირკვება. ",
  "dhp339:1": "მცდარი შეხედულებების მქონე ადამიანს, ",
  "dhp339:2": "რომელშიც სიამოვნებისაკენ მიმდინარე ",
  "dhp339:3": "ოცდათექვსმეტი ნაკადი მძლავრობს, ",
  "dhp339:4": "ვნებიანი ფიქრები იტაცებს. ",
  "dhp340:1": "ნაკადნი ყველგან მიედინებიან; ",
  "dhp340:2": "სარეველა აღმოცენდება და რჩება. ",
  "dhp340:3": "როდესაც დაინახავთ ამ სარეველას, ",
  "dhp340:4": "მისი ფესვი სიბრძნით გადაჭერით. ",
  "dhp341:1": "არსების სიამოვნებანი ",
  "dhp341:2": "გრძნობებიდან და ლტოლვებიდან მოედინება. ",
  "dhp341:3": "ბედნიერების მაძიებელნი და სიამოვნებისაკენ მიდრეკილნი ",
  "dhp341:4": "განაგრძობენ კვლავშობასა და დაბერებას. ",
  "dhp342:1": "ვისაც წყურვილი მართავს, ",
  "dhp342:2": "მახეში გაბმული კურდღელივით ფართხალებს. ",
  "dhp342:3": "დიდი ხნის განმავლობაში შებოჭილნი და დატყვევებულნი, ",
  "dhp342:4": "კვლავ და კვლავ ტანჯვას განიცდიან. ",
  "dhp343:1": "ვისაც წყურვილი მართავს, ",
  "dhp343:2": "მახეში გაბმული კურდღელივით ფართხალებს. ",
  "dhp343:3": "ამიტომ, ვისაც ვნებათა განქარვება სწადია, ",
  "dhp343:4": "უნდა განდევნოს წყურვილი. ",
  "dhp344:0": "",
  "dhp344:1": "ვინც ვნებათა ტყეს თავი დააღწია და განმარტოების ტყეს მიაშურა, ",
  "dhp344:2": "ხოლო განმარტოებიდან კვლავ ვნებათა ტყეში გარბის, ",
  "dhp344:3": "შეხედეთ! ",
  "dhp344:4": "განთავისუფლებული, თავისი ნებით მიისწრაფვის ტყვეობისკენ. ",
  "dhp345:0": "",
  "dhp345:1": "გონიერნი ამბობენ, რომ ბორკილი, ",
  "dhp345:2": "რომელიც რკინისგან, ხისგან ან ლერწმისგან არის გაკეთებული, მძიმე არ არის. ",
  "dhp345:3": "მაგრამ, ძვირფასი სამკაულებით ტკბობა, ",
  "dhp345:4": "ზრუნვა მეუღლეებსა და შვილებზე: ",
  "dhp346:1": "გონიერნი ამბობენ, რომ სწორედ ეს არის მძიმე ბორკილი, ",
  "dhp346:2": "რომლისგანაც თავის დაღწევა ასეოდენ რთულია და რომელიც ამ ყველაფერში ჩაფლულთ ძირს ექაჩება. ",
  "dhp346:3": "ამ ბორკილის დამსხვრევის შემდეგ, ისინი საერო ცხოვრებიდან მიდიან ",
  "dhp346:4": "და უდარდელნი, გრძნობით სიამოვნებებს უკან ტოვებენ. ",
  "dhp347:0": "",
  "dhp347:1": "ვნებით შეპყრობილნი ვარდებიან დინებაში, ",
  "dhp347:2": "როგორც საკუთარ ქსელში გაბმული ობობა. ",
  "dhp347:3": "ამის გადაჭრით ყურადღებიანნი წინ მიიწევენ, ",
  "dhp347:4": "და უდარდელნი, ყოველგვარ ტანჯვას უკან ტოვებენ. ",
  "dhp348:0": "",
  "dhp348:1": "გაუშვი წარსული, გაუშვი მომავალი, ",
  "dhp348:2": "გაუშვი აწმყო და განთავისუფლდი კვლავშობისგან. ",
  "dhp348:3": "როდესაც შენი გული ყოველმხრივ განთავისუფლებულია, ",
  "dhp348:4": "აღარ განაგრძობ კვლავშობასა და დაბერებას. ",
  "dhp349:0": "",
  "dhp349:1": "ადამიანისთვის, ვინც გონებით ბორგავს, ",
  "dhp349:2": "ვნებითა და მშვენიერებით არის შეპყრობილი, ",
  "dhp349:3": "ლტოლვა კვლავ და კვლავ იზრდება და ",
  "dhp349:4": "მჭიდროდ აბამს მას. ",
  "dhp350:1": "მაგრამ ის, ვისაც უყვარს საკუთარი ფიქრების დამშვიდება, ",
  "dhp350:2": "აცნობიერებს არამიმზიდველს, მუდამ ფხიზელია, ",
  "dhp350:3": "უდაოდ აღმოფხვრის ამ ლტოლვას ",
  "dhp350:4": "და მარას ბორკილებს დაამსხვრევს. ",
  "dhp351:0": "",
  "dhp351:1": "მისთვის, ვინც თავდაჯერებული და უშიშარია, ",
  "dhp351:2": "ლტოლვისაგან და ნაკლისაგან თავისუფალი, ",
  "dhp351:3": "რომელმაც მოიგერია არსებობის ნესტარი, ",
  "dhp351:4": "ეს ძვლების ტომარა უკანასკნელია. ",
  "dhp352:1": "ლტოლვისგან დაცლილი, მიჯაჭვულობის არმქონე, ",
  "dhp352:2": "ცნებათა განმარტებაში დახელოვნებული, ",
  "dhp352:3": "მან იცის მარცვალთა სწორი ",
  "dhp352:4": "შეხამება და მიმდევრობა; ",
  "dhp352:5": "მასზე ამბობენ, რომ ეს მისი უკანსკნელი სხეულია, ",
  "dhp352:6": "და უწოდებე ბრძენ, დიად ადამიანს. ",
  "dhp353:0": "",
  "dhp353:1": "მე ვარ გამარჯვებული, ყოვლისმცოდნე, ",
  "dhp353:2": "ყოველმხრივ შეუბღალავი. ",
  "dhp353:3": "ყველაფერი მივატოვე, ლტოლვის განადგურებით გავთავისუფლდი. ",
  "dhp353:4": "რაკი ეს მე თავად შევიცანი, ვისი მიმდევარი უნდა ვიყო? ",
  "dhp354:0": "",
  "dhp354:1": "სწავლების საჩუქარი ყველა სხვა საჩუქარს აღემატება, ",
  "dhp354:2": "სწავლების გემო ყველა სხვა გემოს აღემატება, ",
  "dhp354:3": "სწავლების სიხარული ყველა სხვა სიხარულს აღემატება, ",
  "dhp354:4": "ლტოლვის დასრულება კი ყველა სხვა ტანჯვას აღემატება. ",
  "dhp355:0": "",
  "dhp355:1": "სიმდიდრე ღუპავს უგუნურს, ",
  "dhp355:2": "მაგრამ არა შორეული ნაპირის მაძიებელს. ",
  "dhp355:3": "სიმდიდრისადმი ლტოლვით, უგუნური ",
  "dhp355:4": "ღუპავს საკუთარ თავსაც და სხვებსაც. ",
  "dhp356:0": "",
  "dhp356:1": "სარეველა ნაკვეთის ჭირია, ",
  "dhp356:2": "ხოლო სიხარბე – ხალხის. ",
  "dhp356:3": "ამიტომ, სიხარბისაგან დაცლილისათვის მიძღვნილი საჩუქარი ",
  "dhp356:4": "ძლიერ ნაყოფიერია. ",
  "dhp357:1": "სარეველა ნაკვეთის ჭირია, ",
  "dhp357:2": "ხოლო სიძულვილი – ხალხის. ",
  "dhp357:3": "ამიტომ, სიძულვილისაგან დაცლილისათვის მიძღვნილი საჩუქარი ",
  "dhp357:4": "ძლიერ ნაყოფიერია. ",
  "dhp358:1": "სარეველა ნაკვეთის ჭირია, ",
  "dhp358:2": "ხოლო უგუნურება – ხალხის. ",
  "dhp358:3": "ამიტომ, უგუნურებისაგან დაცლილისათვის მიძღვნილი საჩუქარი ",
  "dhp358:4": "ძლიერ ნაყოფიერია. ",
  "dhp359:1": "სარეველა ნაკვეთის ჭირია, ",
  "dhp359:2": "ხოლო წყურვილი – ხალხის. ",
  "dhp359:3": "ამიტომ, წყურვილისგან დაცლილისათვის მიძღვნილი საჩუქარი ",
  "dhp359:4": "ძლიერ ნაყოფიერია. ",
  "dhp359:5": ""
}