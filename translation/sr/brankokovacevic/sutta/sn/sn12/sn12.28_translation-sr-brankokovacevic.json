{
  "sn12.28:0.1": "Budini govori tematski grupisani 12.28 ",
  "sn12.28:0.2": "3. Deset snaga ",
  "sn12.28:0.3": "Monah ",
  "sn12.28:1.1": "Kraj Sāvatthīja. ",
  "sn12.28:1.2": "Onda Blaženi ovako reče: ",
  "sn12.28:1.3": "„Monasi, monah razume starost i smrt, njihov nastanak, njihov nestanak i put koji vodi do njihovog nestanka. On razume rođenje… ",
  "sn12.28:1.4": "razume bivanje… ",
  "sn12.28:1.5": "razume vezivanje… ",
  "sn12.28:1.6": "razume žudnju… ",
  "sn12.28:1.7": "razume osećaj… ",
  "sn12.28:1.8": "razume kontakt… ",
  "sn12.28:1.9": "razume šest područja čula… "
}