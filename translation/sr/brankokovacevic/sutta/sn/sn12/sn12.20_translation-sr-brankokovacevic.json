{
  "sn12.20:0.1": "Budini govori tematski grupisani 12.20 ",
  "sn12.20:0.2": "2. Hrana ",
  "sn12.20:0.3": "Nužni preduslovi ",
  "sn12.20:1.1": "Kraj Sāvatthīja. ",
  "sn12.20:1.2": "„Monasi, podučiću vas uslovljenom nastanku i onom što na taj način nastaje. ",
  "sn12.20:1.3": "Slušajte i dobro zapamtite šta ću vam reći.” ",
  "sn12.20:1.4": "„Da, poštovani,” odgovoriše oni. ",
  "sn12.20:1.5": "A Blaženi ovako nastavi: ",
  "sn12.20:2.1": "„Šta je to, monasi, uslovljeni nastanak? "
}