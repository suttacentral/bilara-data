{
  "sn12.1:0.1": "Budini govori tematski grupisani 12.1 ",
  "sn12.1:0.2": "Budni ",
  "sn12.1:0.3": "Uslovljeni nastanak ",
  "sn12.1:1.1": "Ovako sam čuo. ",
  "sn12.1:1.2": "Jednom je Blaženi boravio kraj Sāvatthīja, u Đetinom gaju, u manastiru koji je podigao Anāthapiṇḍika. ",
  "sn12.1:1.3": "I tu on ovako reče monasima: ",
  "sn12.1:1.4": "„Monasi.” ",
  "sn12.1:1.5": "„Da, poštovani”, odgovoriše oni. ",
  "sn12.1:1.6": "A Blaženi ovako nastavi: ",
  "sn12.1:1.7": "„Monasi, podučiću vas uslovljenom nastanku. ",
  "sn12.1:1.8": "Slušajte i dobro zapamtite šta ću vam reći.” ",
  "sn12.1:1.9": "„Da, poštovani,” odgovoriše oni. ",
  "sn12.1:1.10": "A Blaženi ovako nastavi: ",
  "sn12.1:2.1": "„Šta je to, monasi, uslovljeni nastanak? "
}