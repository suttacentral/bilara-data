{
  "sn15.6:0.1": "Budini govori tematski grupisani 15.6 ",
  "sn15.6:0.2": "1. Prvo poglavlje ",
  "sn15.6:0.3": "Seme gorušice ",
  "sn15.6:1.1": "Kraj Sāvatthīja. ",
  "sn15.6:1.2": "Onda neki monah dođe do Blaženog, pokloni mu se i sede sa strane. Dok je tako sedeo, reče on Blaženome: ",
  "sn15.6:1.3": "„Poštovani, koliko je dug eon?” ",
  "sn15.6:1.4": "„Dug je, monaše, eon. "
}