{
  "sn1.50:0.1": "Budini govori tematski grupisani 1.50 ",
  "sn1.50:0.2": "5. Požar ",
  "sn1.50:0.3": "Ghaṭīkāra ",
  "sn1.50:1.1": "(Božanstvo Ghaṭīkāra:) „Sedam oslobođenih monaha",
  "sn1.50:1.2": "preporodilo se u Aviha svetu; ",
  "sn1.50:1.3": "strast i mržnja u njima presahle,",
  "sn1.50:1.4": "nadišli vezanosti za ovaj svet.” ",
  "sn1.50:2.1": "(Blaženi:) „A ko su ti što pregaziše močvaru,",
  "sn1.50:2.2": "kraljevstvo Smrti, tako teško prohodno?",
  "sn1.50:2.3": "Ko su ti što, napustivši ljudsko telo,",
  "sn1.50:2.4": "nadiđoše i nebeski jaram?”",
  "sn1.50:3.1": "(Ghaṭīkāra:) „Upaka, Palagaṇḍa, ",
  "sn1.50:3.2": "i Pukkusāti – to su trojica;",
  "sn1.50:3.3": "zatim Bhaddiya i Khaṇḍadeva, ",
  "sn1.50:3.4": "Bāhudanti i Piṅgiya.",
  "sn1.50:3.5": "Oni su, napustivši ljudsko telo, ",
  "sn1.50:3.6": "nebeski jaram nadišli.” ",
  "sn1.50:4.1": "(Blaženi:) „Lepo govoriš o njima, ",
  "sn1.50:4.2": "o onima koji Mārine zamke odbaciše. ",
  "sn1.50:4.3": "A čiju su Dhammu razumeli",
  "sn1.50:4.4": "kad presekoše sponu bivanja?” ",
  "sn1.50:5.1": "(Ghaṭīkāra:) „To nije Dhamma nikog drugog do Blaženog,",
  "sn1.50:5.2": "ničije drugo do tvoje Učenje! ",
  "sn1.50:5.3": "Tvoju su Dhammu razumeli ",
  "sn1.50:5.4": "kad presekoše sponu bivanja.",
  "sn1.50:6.1": "Tamo gde ime i oblik",
  "sn1.50:6.2": "bez ostatka prestaju,",
  "sn1.50:6.3": "tu su Dhammu dobro razumel",
  "sn1.50:6.4": "kad presekoše sponu bivanja.” ",
  "sn1.50:7.1": "(Blaženi:) „Duboke reči si izgovorio, ",
  "sn1.50:7.2": "teško ih je razumeti, teško dokučiti. ",
  "sn1.50:7.3": "Da li si tu Dhammu razumevši, ",
  "sn1.50:7.4": "takve reči izgovorio? ",
  "sn1.50:8.1": "(Ghaṭīkāra:) „U prošlosti bejah grnčar, ",
  "sn1.50:8.2": "Ghaṭīkāra iz Vekñiṅge. ",
  "sn1.50:8.3": "Izdržavao sam oca i majku, ",
  "sn1.50:8.4": "kao nezaređeni sledbenik bude Kassape. ",
  "sn1.50:9.1": "Uzdržavah se od snošaja, ",
  "sn1.50:9.2": "u celibatu živeh, telesnim vezama nesputan; ",
  "sn1.50:9.3": "u istom selu živesmo, ",
  "sn1.50:9.4": "u prošlosti bejah prijatelj tvoj. ",
  "sn1.50:10.1": "Ja sam onaj koji zna monahe ",
  "sn1.50:10.2": "koji postadoše potpuno oslobođeni, ",
  "sn1.50:10.3": "pošto su pohlepu i mržnju sasvim uklonili, ",
  "sn1.50:10.4": "nadišli vezanosti za ovaj svet.” ",
  "sn1.50:11.1": "(Blaženi:) „Upravo tako je u to vreme bilo ",
  "sn1.50:11.2": "kako kažeš, o Bhaggava: ",
  "sn1.50:11.3": "u prošlosti beše grnčar, ",
  "sn1.50:11.4": "Ghaṭīkāra iz Vekñiṅge. ",
  "sn1.50:11.5": "Izdržavao si oca i majku, ",
  "sn1.50:11.6": "kao nezaređeni sledbenik bude Kassape. ",
  "sn1.50:12.1": "Uzdržavao si se od snošaja, ",
  "sn1.50:12.2": "u celibatu živeo, telesnim vezama nesputan; ",
  "sn1.50:12.3": "u istom selu živesmo, ",
  "sn1.50:12.4": "u prošlosti bio si prijatelj moj.” ",
  "sn1.50:13.1": "Takav se susret dogodio ",
  "sn1.50:13.2": "između dva prijatelja od davnina; ",
  "sn1.50:13.3": "obojica sada u sebi probuđeni, ",
  "sn1.50:13.4": "u svom poslednjem telu žive. ",
