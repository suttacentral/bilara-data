{
  "sn1.48:0.1": "Budini govori tematski grupisani 1.48 ",
  "sn1.48:0.2": "5. Požar ",
  "sn1.48:0.3": "Đetin gaj ",
  "sn1.48:1.1": "„Ovo je zaista taj Đetin gaj, ",
  "sn1.48:1.2": "pribežište zajednice mudraca, ",
  "sn1.48:1.3": "u njemu kralj Dhamme boravi, ",
  "sn1.48:1.4": "to je mesto koje u meni budi radost. ",
  "sn1.48:2.1": "Dela, znanje, pravednost, ",
  "sn1.48:2.2": "vrlina i najbolje življenje: ",
  "sn1.48:2.3": "time smrtnik pročišćen biva, ",
  "sn1.48:2.4": "a ne poreklom ili imetkom. "
}