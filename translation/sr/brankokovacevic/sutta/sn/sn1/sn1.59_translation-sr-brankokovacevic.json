{
  "sn1.59:0.1": "Budini govori tematski grupisani 1.59 ",
  "sn1.59:0.2": "6. Starost ",
  "sn1.59:0.3": "Saputnik ",
  "sn1.59:1.1": "„Šta je čovekov saputnik? ",
  "sn1.59:1.2": "Šta je to što ga upućuje? ",
  "sn1.59:1.3": "Čime ushićen smrtnik biva, ",
  "sn1.59:1.4": "kada se svake patnje oslobađa?” ",
  "sn1.59:2.1": "„Poverenje je čovekov saputnik. ",
  "sn1.59:2.2": "Mudrost je ta koja ga upućuje. "
}