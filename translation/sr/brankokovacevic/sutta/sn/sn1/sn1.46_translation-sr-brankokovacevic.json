{
  "sn1.46:0.1": "Budini govori tematski grupisani 1.46 ",
  "sn1.46:0.2": "5. Požar ",
  "sn1.46:0.3": "Vile ",
  "sn1.46:1.1": "„Odzvanjaju ovde glasovi vila, ",
  "sn1.46:1.2": "ali je i mnogo zlih demona; ",
  "sn1.46:1.3": "Ovaj gaj bi trebalo nazvati ’Obmana’: ",
  "sn1.46:1.4": "pa kako iz njega pobeći?” ",
  "sn1.46:2.1": "„Ta staza se ’Pravim putem’ zove, ",
  "sn1.46:2.2": "a ’besmrtno’ je njezino krajnje odredište; ",
  "sn1.46:2.3": "Kočija se ’nepokolebljivost’ naziva, ",
  "sn1.46:2.4": "a točkovi su joj dobre misli. ",
  "sn1.46:3.1": "Osećaj stida joj je naslon, ",
  "sn1.46:3.2": "sedište presvučeno svesnosšću, ",
  "sn1.46:3.3": "njezinog kočijaša Dhammom zovem, "
}