{
  "sn1.73:0.1": "Budini govori tematski grupisani 1.73 ",
  "sn1.73:0.2": "8. Ubijanje ",
  "sn1.73:0.3": "Blago ",
  "sn1.73:1.1": "„Šta je najveće čovekovo blago? ",
  "sn1.73:1.2": "Šta, dobro praktikovano, donosi sreću? ",
  "sn1.73:1.3": "Šta je zaista najslađe među ukusima? ",
  "sn1.73:1.4": "Kako živi onaj za kojeg kažu da živi najbolje?” ",
  "sn1.73:2.1": "„Poverenje je najveće čovekovo blago. "
