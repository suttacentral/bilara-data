{
  "sn22.59:0.1": "Budini govori tematski grupisani 22.59 ",
  "sn22.59:0.2": "6. Prianjanje ",
  "sn22.59:0.3": "O obeležju ne-sopstva ",
  "sn22.59:1.1": "Jednom je Blaženi boravio kraj Vārāṇasīja, u Parku jelena, u Isipatani. ",
  "sn22.59:1.2": "Tu se on ovako obrati grupi od pet monaha: ",
  "sn22.59:1.3": "„Monasi.” ",
  "sn22.59:1.4": "„Da, poštovani”, odgovoriše oni. ",
  "sn22.59:1.5": "A Blaženi ovako nastavi: ",
  "sn22.59:2.1": "„Monasi, materijalni oblik nije trajno sopstvo. "
}