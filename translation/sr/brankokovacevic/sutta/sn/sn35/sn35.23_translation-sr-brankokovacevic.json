{
  "sn35.23:0.1": "Budini govori tematski grupisani 35.23 ",
  "sn35.23:0.2": "3. Sve ",
  "sn35.23:0.3": "Sve ",
  "sn35.23:1.1": "Kraj Sāvatthīja. ",
  "sn35.23:1.2": "„Monasi, podučiću vas o svemu. ",
  "sn35.23:1.3": "Saslušajte me. ",
  "sn35.23:1.4": "Šta je to sve? ",
  "sn35.23:1.5": "Oko i materijalni oblici, uho i zvukovi, nos i mirisi, jezik i ukusi, telo i dodiri, um i objekti uma: ",
  "sn35.23:1.6": "to se naziva sve. "
}