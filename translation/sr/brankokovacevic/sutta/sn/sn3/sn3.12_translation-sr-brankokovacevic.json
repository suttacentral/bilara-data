{
  "sn3.12:0.1": "Budini govori tematski grupisani 3.12 ",
  "sn3.12:0.2": "2. Drugo poglavlje ",
  "sn3.12:0.3": "Pet kraljeva ",
  "sn3.12:1.1": "Kraj Sāvatthīja. ",
  "sn3.12:1.2": "Jednom su prilikom pet kraljeva, predvođeni kraljem Pasenadijem, uživali i zabavljali se, kad se ovakav razgovor zapodenu među njima: ",
  "sn3.12:1.3": "„Koje je najveće čulno zadovoljstvo?” ",
  "sn3.12:1.4": "Jedan od njih reče: ",
  "sn3.12:1.5": "„Oblici su najveći među čulnim zadovoljstvima”. ",
  "sn3.12:1.6": "Drugi ustvrdi: ",
  "sn3.12:1.7": "„Zvukovi su najveći među čulnim zadovoljstvima”. ",
  "sn3.12:1.8": "Treći: ",
  "sn3.12:1.9": "„Mirisi su najveći među čulnim zadovoljstvima”. ",
  "sn3.12:1.10": "Četvrti: "
}