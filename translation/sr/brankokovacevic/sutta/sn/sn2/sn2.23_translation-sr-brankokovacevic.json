{
  "sn2.23:0.1": "Budini govori tematski grupisani 2.23 ",
  "sn2.23:0.2": "3. Sledbenici drugih učitelja ",
  "sn2.23:0.3": "Seri ",
  "sn2.23:1.1": "Stojeći sa strane, mlado božanstvo Seri se Blaženom obrati ovim stihovima: ",
  "sn2.23:2.1": "„Uvek se raduju hrani ",
  "sn2.23:2.2": "i božanska i ljudska bića. ",
  "sn2.23:2.3": "Pa kakva to vrsta duha može biti, ",
  "sn2.23:2.4": "koji se hrani ne raduje? ",
  "sn2.23:3.1": "Oni koji daju iz uverenja, ",
  "sn2.23:3.2": "srca ispunjenog pouzdanjem, "
}