{
  "sn2.20:0.1": "Budini govori tematski grupisani 2.20 ",
  "sn2.20:0.2": "2. Anāthapiṇḍika ",
  "sn2.20:0.3": "Anāthapiṇḍika ",
  "sn2.20:1.1": "Stojeći sa strane, mlado božanstvo Anāthapiṇḍika u prisustvu Blaženog izgovori ove stihove: ",
  "sn2.20:2.1": "„Ovo je zaista taj Đetin gaj, ",
  "sn2.20:2.2": "pribežište zajednice mudraca, ",
  "sn2.20:2.3": "u njemu kralj Dhamme boravi, "
}