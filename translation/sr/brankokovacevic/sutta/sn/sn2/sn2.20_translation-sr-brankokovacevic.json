{
  "sn2.20:0.1": "Budini govori tematski grupisani 2.20 ",
  "sn2.20:0.2": "2. Anāthapiṇḍika ",
  "sn2.20:0.3": "Anāthapiṇḍika ",
  "sn2.20:1.1": "Stojeći sa strane, mlado božanstvo Anāthapiṇḍika u prisustvu Blaženog izgovori ove stihove: ",
  "sn2.20:2.1": "„Ovo je zaista taj Đetin gaj, ",
  "sn2.20:2.2": "pribežište zajednice mudraca, ",
  "sn2.20:2.3": "u njemu kralj Dhamme boravi, ",
  "sn2.20:2.4": "to je mesto koje u meni budi radost. ",
  "sn2.20:3.1": "Dela, znanje, pravednost, ",
  "sn2.20:3.2": "vrlina i najbolje življenje: ",
  "sn2.20:3.3": "time smrtnik pročišćen biva, ",
  "sn2.20:3.4": "a ne poreklom ili imetkom. ",
  "sn2.20:4.1": "Zato, čovek koji je mudar ",
  "sn2.20:4.2": "i stara se o sopstvenoj dobrobiti. ",
  "sn2.20:4.3": "treba pažljivo da istražuje Dhammu: ",
  "sn2.20:4.4": "time u njoj pročišćen biva. ",
  "sn2.20:5.1": "Sāriputta istinski je mudrošću obdaren, "
}