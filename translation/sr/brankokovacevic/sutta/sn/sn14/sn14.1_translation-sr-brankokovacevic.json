{
  "sn14.1:0.1": "Budini govori tematski grupisani 14.1 ",
  "sn14.1:0.2": "1. Raznolikost ",
  "sn14.1:0.3": "Raznolikost elemenata (1) ",
  "sn14.1:1.1": "Kraj Sāvatthīja. ",
  "sn14.1:1.2": "„Monasi, podučiću vas raznovrsnosti elemenata. ",
  "sn14.1:1.3": "Slušajte i dobro zapamtite šta ću vam reći.” ",
  "sn14.1:1.4": "„Da, poštovani,” odgovoriše oni. "
