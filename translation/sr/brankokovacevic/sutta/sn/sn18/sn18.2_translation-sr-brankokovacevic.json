{
  "sn18.2:0.1": "Budini govori tematski grupisani 18.2 ",
  "sn18.2:0.2": "1. Prvo poglavlje ",
  "sn18.2:0.3": "Oblici, itd. ",
  "sn18.2:1.1": "Kraj Sāvatthīja. ",
  "sn18.2:1.2": "„Šta misliš, Rāhula, ",
  "sn18.2:1.3": "jesu li oblici… ",
  "sn18.2:1.5": "zvukovi… ",
  "sn18.2:1.6": "mirisi… ",
  "sn18.2:1.7": "ukusi… ",
  "sn18.2:1.8": "dodiri… ",
  "sn18.2:1.9": "mentalne pojave trajne ili prolazne?” ",
  "sn18.2:1.10": "„Prolazne, poštovani.” "
}