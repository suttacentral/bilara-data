{
  "sn18.6:0.1": "Budini govori tematski grupisani 18.6 ",
  "sn18.6:0.2": "1. Prvo poglavlje ",
  "sn18.6:0.3": "Opažaj ",
  "sn18.6:1.1": "Kraj Sāvatthīja. ",
  "sn18.6:1.2": "„Šta misliš, Rāhula, ",
  "sn18.6:1.3": "je li opažaj oblika… ",
  "sn18.6:1.5": "opažaj zvukova… ",
  "sn18.6:1.6": "opažaj mirisa… ",
  "sn18.6:1.7": "opažaj ukusa… ",
  "sn18.6:1.8": "opažaj dodira… ",
  "sn18.6:1.9": "opažaj mentalnih pojava trajan ili prolazan?” ",
  "sn18.6:1.10": "„Prolazan, poštovani.” "
}