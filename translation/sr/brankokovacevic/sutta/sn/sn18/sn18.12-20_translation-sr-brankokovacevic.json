{
  "sn18.12-20:0.1": "Budini govori tematski grupisani 18.12-20 ",
  "sn18.12-20:0.2": "2. Drugo poglavlje ",
  "sn18.12-20:0.3": "Devet govora o oblicima itd. ",
  "sn18.12-20:1.1": "Kraj Sāvatthīja. ",
  "sn18.12-20:1.2": "„Šta misliš, Rāhula, ",
  "sn18.12-20:1.3": "jesu li oblici trajni ili prolazni?” ",
  "sn18.12-20:1.4": "„Prolazni, poštovani.” … ",
  "sn18.12-20:1.5": "zvukovi… ",
  "sn18.12-20:1.6": "mirisi… ",
  "sn18.12-20:1.7": "ukusi… ",
  "sn18.12-20:1.8": "dodiri… ",
  "sn18.12-20:1.9": "mentalne pojave… ",
  "sn18.12-20:2.1": "Svest o viđenom… ",
  "sn18.12-20:2.2": "svest o čujnom… ",
  "sn18.12-20:2.3": "svest o omirisanom… "
}