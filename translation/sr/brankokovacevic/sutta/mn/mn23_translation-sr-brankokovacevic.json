{
  "mn23:0.1": "Budni govori srednje dužine 23 ",
  "mn23:0.2": "Mravinjak ",
  "mn23:1.1": "Ovako sam čuo. ",
  "mn23:1.2": "Jednom je Blaženi boravio kraj Sāvatthīja, u Đetinom gaju, u manastiru koji je podigao Anāthapiṇḍika. ",
  "mn23:1.3": "U isto vreme poštovani Kumāra Kassapa živeo je u Slepčevom gaju. ",
  "mn23:1.4": "I kada je jednom noć bila na izmaku, neko božanstvo izuzetne lepote, koje je svojim sjajem obasjalo čitav Đetin gaj, dođe do poštovanog Kumāra Kassape i stade sa strane. Stojeći tako, božanstvo mu reče: ",
  "mn23:2.1": "„Monaše, monaše, ovaj mravinjak dimi se noću i gori danju. ",
  "mn23:2.2": "Tako reče brahman: ",
  "mn23:2.3": "’Dubi nožem, ti mudri.’ ",
  "mn23:2.4": "Dubeći nožem, mudrac ugleda gredu: ",
  "mn23:2.5": "’Greda, o poštovani gospodine.’ ",
  "mn23:2.6": "Tako reče brahman: ",
  "mn23:2.7": "’Ukloni gredu.’ ",
  "mn23:2.8": "dubi nožem, ti mudri.’ ",
  "mn23:2.9": "Dubeći nožem, mudrac ugleda žabu. ",
  "mn23:2.10": "’Žaba, o poštovani gospodine.’ ",
  "mn23:2.11": "Tako reče brahman: ",
  "mn23:2.12": "’Odbaci žabu; ",
  "mn23:2.13": "dubi nožem, ti mudri.’ ",
  "mn23:2.14": "Dubeći nožem, mudrac ugleda rašlje: ",
  "mn23:2.15": "’Rašlje, o poštovani gospodine.’ ",
  "mn23:2.16": "Tako reče brahman: ",
  "mn23:2.17": "’Odbaci rašlje; ",
  "mn23:2.18": "dubi nožem, ti mudri.’ ",
  "mn23:2.19": "Dubeći nožem, mudrac ugleda sito: ",
  "mn23:2.20": "’Sito, o poštovani gospodine.’ ",
  "mn23:2.21": "Tako reče brahman: ",
  "mn23:2.22": "’Odbaci sito; ",
  "mn23:2.23": "dubi nožem, ti mudri.’ ",
  "mn23:2.24": "Dubeći nožem, mudrac ugleda kornjaču: ",
  "mn23:2.25": "’Kornjača, o poštovani gospodine.’ ",
  "mn23:2.26": "Tako reče brahman: ",
  "mn23:2.27": "’Odbaci kornjaču; ",
  "mn23:2.28": "dubi nožem, ti mudri.’ "
}