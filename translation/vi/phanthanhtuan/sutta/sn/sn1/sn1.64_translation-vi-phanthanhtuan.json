{
  "sn1.64:0.1": "Tương Ưng Bộ Kinh 1.64 ",
  "sn1.64:0.2": "7. Phẩm Con Đường ",
  "sn1.64:0.3": "Kinh Kiết Sử ",
  "sn1.64:1.1": ""Điều gì trói buộc thế gian, ",
  "sn1.64:1.2": "Điều gì là sự di chuyển của thế gian; ",
  "sn1.64:1.3": "Do đoạn trừ điều gì, ",
  "sn1.64:1.4": "Được gọi là Niết-bàn?" ",
  "sn1.64:2.1": ""Hỷ ái là kiết sử của thế gian, ",
  "sn1.64:2.2": "Tầm là sự di chuyển của thế gian; ",
  "sn1.64:2.3": "Do đoạn trừ tham ái, ",
  "sn1.64:2.4": "Được gọi là Niết-bàn." "
}
