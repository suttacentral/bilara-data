{
  "sn1.21:0.1": "Tương Ưng Bộ Kinh 1.21 ",
  "sn1.21:0.2": "3. Phẩm Cây Thương ",
  "sn1.21:0.3": "Kinh Cây Thương ",
  "sn1.21:1.1": "Nhân duyên tại Sāvatthi. ",
  "sn1.21:1.2": "Đứng sang một bên, vị thiên thần ấy đọc bài kệ này trước Thế Tôn: ",
  "sn1.21:2.1": "'Như bị đâm bởi cây thương, '",
  "sn1.21:2.2": "Như đầu đang bốc lửa; ",
  "sn1.21:2.3": "Để từ bỏ tham dục, ",
  "sn1.21:2.4": "Tỳ Kheo hãy sống chánh niệm du hành.' ",
  "sn1.21:3.1": "'Như bị đâm bởi cây thương, '",
  "sn1.21:3.2": "Như đầu đang bốc lửa; ",
  "sn1.21:3.3": "Để từ bỏ thân kiến, ",
  "sn1.21:3.4": "Tỳ Kheo hãy sống chánh niệm du hành.' "
}