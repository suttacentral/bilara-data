{
  "sn28.6:0.1": "Tương Ưng Bộ 28.6 ",
  "sn28.6:0.2": "1. Phẩm Xá-Lợi-Phất ",
  "sn28.6:0.3": "Kinh Thức Vô Biên Xứ ",
  "sn28.6:1.1": "Nhân duyên tại Sāvatthi. ",
  "sn28.6:1.2": "Tôn giả Ānanda thấy... ",
  "sn28.6:1.3": ""Ở đây, thưa đạo hữu, vượt qua hoàn toàn không vô biên xứ, với ý tưởng 'thức là vô biên', tôi chứng và trú thức vô biên xứ... ",
  "sn28.6:1.4": "hay 'Tôi đã xuất khỏi'." ",
  "sn28.6:1.5": "Thứ sáu. "
}
