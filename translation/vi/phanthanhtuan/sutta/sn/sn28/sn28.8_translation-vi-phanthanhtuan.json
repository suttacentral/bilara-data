{
  "sn28.8:0.1": "Tương Ưng Bộ 28.8 ",
  "sn28.8:0.2": "1. Phẩm Xá-Lợi-Phất ",
  "sn28.8:0.3": "Kinh Phi Tưởng Phi Phi Tưởng Xứ ",
  "sn28.8:1.1": "Nhân duyên tại Sāvatthi. ",
  "sn28.8:1.2": "Rồi Tôn giả Sāriputta... ",
  "sn28.8:1.3": ""Ở đây, thưa đạo hữu, vượt qua hoàn toàn vô sở hữu xứ, tôi chứng và trú phi tưởng phi phi tưởng xứ... ",
  "sn28.8:1.4": "hay 'Tôi đã xuất khỏi'." ",
  "sn28.8:1.5": "Thứ tám. "
}
