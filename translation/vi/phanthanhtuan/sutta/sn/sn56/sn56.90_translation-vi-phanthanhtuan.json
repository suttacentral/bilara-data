{
  "sn56.90:0.1": "Tương Ưng Bộ 56.90 ",
  "sn56.90:0.2": "9. Phẩm Lặp Lại Thóc Thô, Thứ Ba ",
  "sn56.90:0.3": "Kinh Voi, Bò và Ngựa ",
  "sn56.90:1.1": "… "Cũng vậy, này các Tỳ Kheo, ít những chúng sinh nào kiêng tránh nhận voi, bò, ngựa và ngựa cái; còn nhiều hơn là những chúng sinh không kiêng tránh nhận voi, bò, ngựa và ngựa cái …v.v…. ",
  "sn56.90:1.2": "Thứ mười. ",
  "sn56.90:1.3": "Phẩm Lặp Lại Thóc Thô Thứ Ba, phẩm thứ chín. ",
  "sn56.90:2.0": "Tóm lược: ",
  "sn56.90:2.1": "Ca múa, giường nằm, bạc, ",
  "sn56.90:2.2": "Thóc, thịt, con gái; ",
  "sn56.90:2.3": "Nô tỳ, dê cừu, ",
  "sn56.90:2.4": "Gà heo và voi. "
}