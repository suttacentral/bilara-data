{
  "sn48.93-104:0.1": "Tương Ưng Bộ 48.93 ",
  "sn48.93-104:0.2": "10. Phẩm Cần Làm Mạnh Mẽ ",
  "sn48.93-104:0.3": "Phẩm Cần Làm Mạnh Mẽ ",
  "sn48.93-104:1.1": "(Phẩm Cần Làm Mạnh Mẽ cần được trình bày đầy đủ.) ",
  "sn48.93-104:2.0": "Tóm lược phẩm: ",
  "sn48.93-104:2.1": "Sức mạnh, hạt giống, voi, ",
  "sn48.93-104:2.2": "cây, bình, tốt tươi; ",
  "sn48.93-104:2.3": "Bầu trời, hai đám mây, ",
  "sn48.93-104:2.4": "thuyền, khách vãng lai, dòng sông. "
}