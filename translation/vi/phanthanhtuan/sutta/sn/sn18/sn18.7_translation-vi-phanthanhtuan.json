{
  "sn18.7:0.1": "Tương Ưng Bộ 18.7 ",
  "sn18.7:0.2": "1. Phẩm Thứ Nhất ",
  "sn18.7:0.3": "Kinh Tư ",
  "sn18.7:1.1": "Trú tại Sāvatthī. ",
  "sn18.7:1.2": ""Này Rāhula, ông nghĩ thế nào, ",
  "sn18.7:1.3": "tư về sắc là thường hằng hay vô thường?" ",
  "sn18.7:1.4": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.7:1.5": ""tư về thanh âm …(và tiếp tục)… ",
  "sn18.7:1.6": "tư về hương … ",
  "sn18.7:1.7": "tư về vị … ",
  "sn18.7:1.8": "tư về xúc … ",
  "sn18.7:1.9": "tư về pháp là thường hằng hay vô thường?" ",
  "sn18.7:1.10": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.7:1.11": ""Này Rāhula, thấy vậy, bậc Thánh đệ tử đa văn nhàm chán đối với tư về sắc …(và tiếp tục)… nhàm chán đối với tư về thanh âm … nhàm chán đối với tư về hương … nhàm chán đối với tư về vị … nhàm chán đối với tư về xúc … nhàm chán đối với tư về pháp …(và tiếp tục)… ",
  "sn18.7:1.12": "vị ấy biết như vậy." ",
  "sn18.7:1.13": "Kinh thứ bảy. "
}