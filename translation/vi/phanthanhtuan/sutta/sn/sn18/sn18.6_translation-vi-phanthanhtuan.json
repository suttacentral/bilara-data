{
  "sn18.6:0.1": "Tương Ưng Bộ 18.6 ",
  "sn18.6:0.2": "1. Phẩm Thứ Nhất ",
  "sn18.6:0.3": "Kinh Tưởng ",
  "sn18.6:1.1": "Trú tại Sāvatthī. ",
  "sn18.6:1.2": ""Này Rāhula, ông nghĩ thế nào, ",
  "sn18.6:1.3": "tưởng về sắc là thường hằng hay vô thường?" ",
  "sn18.6:1.4": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.6:1.5": ""tưởng về thanh âm …(và tiếp tục)… ",
  "sn18.6:1.6": "tưởng về hương … ",
  "sn18.6:1.7": "tưởng về vị … ",
  "sn18.6:1.8": "tưởng về xúc … ",
  "sn18.6:1.9": "tưởng về pháp là thường hằng hay vô thường?" ",
  "sn18.6:1.10": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.6:1.11": ""Này Rāhula, thấy vậy, bậc Thánh đệ tử đa văn nhàm chán đối với tưởng về sắc …(và tiếp tục)… nhàm chán đối với tưởng về thanh âm … nhàm chán đối với tưởng về hương … nhàm chán đối với tưởng về vị … nhàm chán đối với tưởng về xúc … nhàm chán đối với tưởng về pháp …(và tiếp tục)… ",
  "sn18.6:1.12": "vị ấy biết như vậy." ",
  "sn18.6:1.13": "Kinh thứ sáu. "
}