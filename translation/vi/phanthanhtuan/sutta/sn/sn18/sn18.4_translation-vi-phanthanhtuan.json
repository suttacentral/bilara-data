{
  "sn18.4:0.1": "Tương Ưng Bộ 18.4 ",
  "sn18.4:0.2": "1. Phẩm Thứ Nhất ",
  "sn18.4:0.3": "Kinh Xúc Chạm ",
  "sn18.4:1.1": "Trú tại Sāvatthī. ",
  "sn18.4:1.2": ""Này Rāhula, ông nghĩ thế nào, ",
  "sn18.4:1.3": "nhãn xúc là thường hằng hay vô thường?" ",
  "sn18.4:1.4": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.4:1.5": ""nhĩ xúc …(và tiếp tục)… ",
  "sn18.4:1.6": "tỷ xúc … ",
  "sn18.4:1.7": "thiệt xúc … ",
  "sn18.4:1.8": "thân xúc … ",
  "sn18.4:1.9": "ý xúc là thường hằng hay vô thường?" ",
  "sn18.4:1.10": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.4:1.11": ""Này Rāhula, thấy vậy, bậc Thánh đệ tử đa văn nhàm chán đối với nhãn xúc …(và tiếp tục)… nhàm chán đối với nhĩ xúc … nhàm chán đối với tỷ xúc … nhàm chán đối với thiệt xúc … nhàm chán đối với thân xúc … nhàm chán đối với ý xúc; ",
  "sn18.4:1.12": "nhàm chán rồi ly tham …(và tiếp tục)… ",
  "sn18.4:1.13": "vị ấy biết như vậy." ",
  "sn18.4:1.14": "Kinh thứ tư. "
}