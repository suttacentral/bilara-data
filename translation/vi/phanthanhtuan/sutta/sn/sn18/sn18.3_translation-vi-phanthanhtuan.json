{
  "sn18.3:0.1": "Tương Ưng Bộ 18.3 ",
  "sn18.3:0.2": "1. Phẩm Thứ Nhất ",
  "sn18.3:0.3": "Kinh Thức ",
  "sn18.3:1.1": "Trú tại Sāvatthī. ",
  "sn18.3:1.2": ""Này Rāhula, ông nghĩ thế nào, ",
  "sn18.3:1.3": "nhãn thức là thường hằng hay vô thường?" ",
  "sn18.3:1.4": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.3:1.5": ""nhĩ thức …(và tiếp tục)… ",
  "sn18.3:1.6": "tỷ thức … ",
  "sn18.3:1.7": "thiệt thức … ",
  "sn18.3:1.8": "thân thức … ",
  "sn18.3:1.9": "ý thức là thường hằng hay vô thường?" ",
  "sn18.3:1.10": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.3:1.11": ""Này Rāhula, thấy vậy, bậc Thánh đệ tử đa văn nhàm chán đối với nhãn thức …(và tiếp tục)… nhàm chán đối với nhĩ thức … nhàm chán đối với tỷ thức … nhàm chán đối với thiệt thức … nhàm chán đối với thân thức … nhàm chán đối với ý thức; ",
  "sn18.3:1.12": "nhàm chán rồi ly tham …(và tiếp tục)… ",
  "sn18.3:1.13": "vị ấy biết như vậy." ",
  "sn18.3:1.14": "Kinh thứ ba. "
}