{
  "sn18.9:0.1": "Tương Ưng Bộ 18.9 ",
  "sn18.9:0.2": "1. Phẩm Thứ Nhất ",
  "sn18.9:0.3": "Kinh Giới ",
  "sn18.9:1.1": "Trú tại Sāvatthī. ",
  "sn18.9:1.2": ""Này Rāhula, ông nghĩ thế nào, ",
  "sn18.9:1.3": "địa đại là thường hằng hay vô thường?" ",
  "sn18.9:1.4": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.9:1.5": ""thủy đại …(và tiếp tục)… ",
  "sn18.9:1.6": "hỏa đại … ",
  "sn18.9:1.7": "phong đại … ",
  "sn18.9:1.8": "không đại … ",
  "sn18.9:1.9": "thức đại là thường hằng hay vô thường?" ",
  "sn18.9:1.10": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.9:1.11": ""Này Rāhula, thấy vậy, bậc Thánh đệ tử đa văn nhàm chán đối với địa đại …(và tiếp tục)… nhàm chán đối với thủy đại … nhàm chán đối với hỏa đại … nhàm chán đối với phong đại … nhàm chán đối với không đại … nhàm chán đối với thức đại …(và tiếp tục)… ",
  "sn18.9:1.12": "vị ấy biết như vậy." ",
  "sn18.9:1.13": "Kinh thứ chín. "
}