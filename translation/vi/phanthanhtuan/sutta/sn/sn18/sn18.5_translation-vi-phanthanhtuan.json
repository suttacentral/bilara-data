{
  "sn18.5:0.1": "Tương Ưng Bộ 18.5 ",
  "sn18.5:0.2": "1. Phẩm Thứ Nhất ",
  "sn18.5:0.3": "Kinh Thọ ",
  "sn18.5:1.1": "Trú tại Sāvatthī. ",
  "sn18.5:1.2": ""Này Rāhula, ông nghĩ thế nào, ",
  "sn18.5:1.3": "thọ do nhãn xúc sinh là thường hằng hay vô thường?" ",
  "sn18.5:1.4": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.5:1.5": ""thọ do nhĩ xúc sinh …(và tiếp tục)… ",
  "sn18.5:1.6": "thọ do tỷ xúc sinh … ",
  "sn18.5:1.7": "thọ do thiệt xúc sinh … ",
  "sn18.5:1.8": "thọ do thân xúc sinh … ",
  "sn18.5:1.9": "thọ do ý xúc sinh là thường hằng hay vô thường?" ",
  "sn18.5:1.10": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.5:1.11": ""Này Rāhula, thấy vậy, bậc Thánh đệ tử đa văn nhàm chán đối với thọ do nhãn xúc sinh …(và tiếp tục)… nhĩ … tỷ … thiệt … thân … nhàm chán đối với thọ do ý xúc sinh …(và tiếp tục)… ",
  "sn18.5:1.12": "vị ấy biết như vậy." ",
  "sn18.5:1.13": "Kinh thứ năm. "
}