{
  "sn18.1:0.1": "Tương Ưng Bộ 18.1 ",
  "sn18.1:0.2": "1. Phẩm Thứ Nhất ",
  "sn18.1:0.3": "Kinh Mắt ",
  "sn18.1:1.1": "Tôi nghe như vầy—",
  "sn18.1:1.2": "Một thời, Thế Tôn trú tại Sāvatthī, trong rừng Jetavana, tịnh xá của ông Anāthapiṇḍika. ",
  "sn18.1:1.3": "Rồi Tôn giả Rāhula đến chỗ Thế Tôn; sau khi đến, đảnh lễ Thế Tôn rồi ngồi xuống một bên. Ngồi xuống một bên, Tôn giả Rāhula bạch Thế Tôn: ",
  "sn18.1:1.4": ""Lành thay, bạch Thế Tôn, xin Thế Tôn hãy thuyết pháp vắn tắt cho con, để con nghe pháp từ Thế Tôn, rồi sống một mình, tách xa mọi người, không phóng dật, nhiệt tâm, tinh tấn." ",
  "sn18.1:2.1": ""Này Rāhula, ông nghĩ thế nào, ",
  "sn18.1:2.2": "mắt là thường hằng hay vô thường?" ",
  "sn18.1:2.3": ""Vô thường, bạch Thế Tôn." ",
  "sn18.1:2.4": ""Cái gì vô thường, cái đó là khổ hay lạc?" ",
  "sn18.1:2.5": ""Là khổ, bạch Thế Tôn." ",
  "sn18.1:2.6": ""Cái gì vô thường, khổ, có bản chất biến đổi, có hợp lý chăng khi nhìn nhận cái đó là: ",
  "sn18.1:2.7": "'Cái này là của ta, ta là thế này, đây là tự ngã của ta'?" ",
  "sn18.1:2.8": ""Thưa không, bạch Thế Tôn." ",
  "sn18.1:3.1": ""Tai là thường hằng hay vô thường?" ",
  "sn18.1:3.2": ""Vô thường, bạch Thế Tôn" …(và tiếp tục như vậy)…. ",
  "sn18.1:3.3": ""Mũi là thường hằng hay vô thường?" ",
  "sn18.1:3.4": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.1:3.5": ""Lưỡi là thường hằng hay vô thường?" ",
  "sn18.1:3.6": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.1:3.7": ""Thân là thường hằng hay vô thường?" ",
  "sn18.1:3.8": ""Vô thường, bạch Thế Tôn" … ",
  "sn18.1:3.9": ""Ý là thường hằng hay vô thường?" ",
  "sn18.1:3.10": ""Vô thường, bạch Thế Tôn." ",
  "sn18.1:3.11": ""Cái gì vô thường, cái đó là khổ hay lạc?" ",
  "sn18.1:3.12": ""Là khổ, bạch Thế Tôn." ",
  "sn18.1:3.13": ""Cái gì vô thường, khổ, có bản chất biến đổi, có hợp lý chăng khi nhìn nhận cái đó là: ",
  "sn18.1:3.14": "'Cái này là của ta, ta là thế này, đây là tự ngã của ta'?" ",
  "sn18.1:3.15": ""Thưa không, bạch Thế Tôn." ",
  "sn18.1:4.1": ""Này Rāhula, thấy vậy, bậc Thánh đệ tử đa văn nhàm chán đối với mắt …(và tiếp tục)… nhàm chán đối với tai … nhàm chán đối với mũi … nhàm chán đối với lưỡi … nhàm chán đối với thân … nhàm chán đối với ý; ",
  "sn18.1:4.2": "nhàm chán rồi ly tham; do ly tham nên giải thoát; khi giải thoát, có trí biết rằng 'Ta đã giải thoát'. ",
  "sn18.1:4.3": "'Sinh đã tận, phạm hạnh đã thành, việc cần làm đã làm xong, không còn trở lại đời này nữa'—vị ấy biết như vậy." ",
  "sn18.1:4.4": "(Bằng phương pháp lược bỏ này, mười kinh phải được trình bày.) ",
  "sn18.1:4.5": "Kinh thứ nhất. "
}