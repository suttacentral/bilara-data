{
  "sn24.14:0.1": "Tương Ưng Bộ 24.14 ",
  "sn24.14:0.2": "1. Phẩm Dự Lưu ",
  "sn24.14:0.3": "Kinh Linh Hồn Và Thân Xác Là Khác Nhau ",
  "sn24.14:1.1": "Nhân duyên tại Sāvatthi (Xá-vệ). ",
  "sn24.14:1.2": ""Này các Tỳ Kheo, do có cái gì, do chấp thủ cái gì, do thiên chấp cái gì mà tà kiến này sinh khởi: ",
  "sn24.14:1.3": "'linh hồn và thân xác là khác nhau'"? ",
  "sn24.14:1.4": ""Bạch Thế Tôn, các pháp của chúng con lấy Thế Tôn làm căn bản …(viết tắt)… ",
  "sn24.14:1.5": "chắc chắn hướng đến giác ngộ." ",
  "sn24.14:1.6": "Thứ mười bốn. "
}