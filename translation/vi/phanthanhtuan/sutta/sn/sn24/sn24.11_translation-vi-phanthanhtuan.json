{
  "sn24.11:0.1": "Tương Ưng Bộ 24.11 ",
  "sn24.11:0.2": "1. Phẩm Dự Lưu ",
  "sn24.11:0.3": "Kinh Thế Giới Là Hữu Hạn ",
  "sn24.11:1.1": "Nhân duyên tại Sāvatthi (Xá-vệ). ",
  "sn24.11:1.2": ""Này các Tỳ Kheo, do có cái gì, do chấp thủ cái gì, do thiên chấp cái gì mà tà kiến này sinh khởi: ",
  "sn24.11:1.3": "'thế giới là hữu hạn'"? ",
  "sn24.11:1.4": ""Bạch Thế Tôn, các pháp của chúng con lấy Thế Tôn làm căn bản …(viết tắt)… ",
  "sn24.11:1.5": "chắc chắn hướng đến giác ngộ." ",
  "sn24.11:1.6": "Thứ mười một. "
}