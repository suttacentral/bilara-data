{
  "sn24.16:0.1": "Tương Ưng Bộ 24.16 ",
  "sn24.16:0.2": "1. Phẩm Dự Lưu ",
  "sn24.16:0.3": "Kinh Như Lai Không Tồn Tại Sau Khi Chết ",
  "sn24.16:1.1": "Nhân duyên tại Sāvatthi (Xá-vệ). ",
  "sn24.16:1.2": ""Này các Tỳ Kheo, do có cái gì, do chấp thủ cái gì, do thiên chấp cái gì mà tà kiến này sinh khởi: ",
  "sn24.16:1.3": "'Như Lai không tồn tại sau khi chết'"? ",
  "sn24.16:1.4": ""Bạch Thế Tôn, các pháp của chúng con lấy Thế Tôn làm căn bản …(viết tắt)… ",
  "sn24.16:1.5": "chắc chắn hướng đến giác ngộ." ",
  "sn24.16:1.6": "Thứ mười sáu. "
}