{
  "sn12.72-81:0.1": "Tương Ưng Bộ 12.72–81 ",
  "sn12.72-81:0.2": "8. Phẩm Sa-môn Bà-la-môn ",
  "sn12.72-81:0.3": "Mười Kinh Bắt Đầu Từ Kinh Sanh ",
  "sn12.72-81:1.1": "'Trú tại Sāvatthī. '",
  "sn12.72-81:1.2": "Không biết rõ sanh …(như trên)…. ",
  "sn12.72-81:2.1": "'Không biết rõ hữu …(như trên)…. '",
  "sn12.72-81:3.1": "'Không biết rõ thủ …(như trên)…. '",
  "sn12.72-81:4.1": "'Không biết rõ ái …(như trên)…. '",
  "sn12.72-81:5.1": "'Không biết rõ thọ …(như trên)…. '",
  "sn12.72-81:6.1": "'Không biết rõ xúc …(như trên)…. '",
  "sn12.72-81:7.1": "'Không biết rõ sáu xứ …(như trên)…. '",
  "sn12.72-81:8.1": "'Không biết rõ danh sắc …(như trên)…. '",
  "sn12.72-81:9.1": "'Không biết rõ thức …(như trên)…. '",
  "sn12.72-81:10.1": "'Không biết rõ hành, không biết rõ nguồn gốc của hành, không biết rõ sự diệt của hành, không biết rõ con đường dẫn đến sự diệt của hành …(như trên)… '",
  "sn12.72-81:10.2": "biết rõ …(như trên)… ",
  "sn12.72-81:10.3": "tự mình chứng ngộ, thực chứng rồi an trú.' ",
  "sn12.72-81:10.4": "Thứ mười một. ",
  "sn12.72-81:10.5": "Phẩm Sa-môn Bà-la-môn thứ tám. ",
  "sn12.72-81:11.0": "Tóm tắt phẩm: ",
  "sn12.72-81:11.1": "Mười một bài về duyên khởi, ",
  "sn12.72-81:11.2": "phân tích bốn sự thật; ",
  "sn12.72-81:11.3": "Phẩm Sa-môn Bà-la-môn, ",
  "sn12.72-81:11.4": "là phẩm thứ tám trong Tương Ưng Nhân Duyên. ",
  "sn12.72-81:12.0": "Tóm tắt các phẩm: ",
  "sn12.72-81:12.1": "Phật, thức ăn, mười lực, ",
  "sn12.72-81:12.2": "Kaḷāra và phẩm trưởng giả thứ năm; ",
  "sn12.72-81:12.3": "Phẩm Khổ, Đại Phẩm, ",
  "sn12.72-81:12.4": "thứ tám là phẩm Sa-môn Bà-la-môn. "
}