{
  "sn23.21:0.1": "Tương Ưng Bộ 23.21 ",
  "sn23.21:0.2": "2. Phẩm Ma Vương Thứ Hai ",
  "sn23.21:0.3": "Kinh Pháp Sanh Khởi ",
  "sn23.21:1.1": "Nhân duyên ở Sāvatthi. ",
  "sn23.21:1.2": "Ngồi xuống một bên, Tôn giả Rādha bạch Thế Tôn: ",
  "sn23.21:1.3": ""'Pháp sanh khởi, pháp sanh khởi', bạch Thế Tôn, người ta thường nói. ",
  "sn23.21:1.4": "Bạch Thế Tôn, thế nào là pháp sanh khởi?" ",
  "sn23.21:1.5": ""Này Rādha, sắc là pháp sanh khởi, thọ là pháp sanh khởi, tưởng là pháp sanh khởi, các hành là pháp sanh khởi, thức là pháp sanh khởi. ",
  "sn23.21:1.6": "Quán như vậy … ",
  "sn23.21:1.7": "không còn trở lại trạng thái này nữa." ",
  "sn23.21:1.8": "Thứ mười một. "
}