{
  "sn23.17:0.1": "Tương Ưng Bộ 23.17 ",
  "sn23.17:0.2": "2. Phẩm Ma Vương Thứ Hai ",
  "sn23.17:0.3": "Kinh Vô Ngã ",
  "sn23.17:1.1": "Nhân duyên ở Sāvatthi. ",
  "sn23.17:1.2": "Ngồi xuống một bên, Tôn giả Rādha bạch Thế Tôn: ",
  "sn23.17:1.3": ""'Vô ngã, vô ngã', bạch Thế Tôn, người ta thường nói. ",
  "sn23.17:1.4": "Bạch Thế Tôn, thế nào là vô ngã?" ",
  "sn23.17:1.5": ""Này Rādha, sắc là vô ngã, thọ là vô ngã, tưởng là vô ngã, các hành là vô ngã, thức là vô ngã. ",
  "sn23.17:1.6": "Quán như vậy … ",
  "sn23.17:1.7": "không còn trở lại trạng thái này nữa." ",
  "sn23.17:1.8": "Thứ bảy. "
}