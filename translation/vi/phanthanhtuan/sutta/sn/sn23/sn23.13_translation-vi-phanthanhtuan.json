{
  "sn23.13:0.1": "Tương Ưng Bộ 23.13 ",
  "sn23.13:0.2": "2. Phẩm Ma Vương Thứ Hai ",
  "sn23.13:0.3": "Kinh Vô Thường ",
  "sn23.13:1.1": "Nhân duyên ở Sāvatthi. ",
  "sn23.13:1.2": "Ngồi xuống một bên, Tôn giả Rādha bạch Thế Tôn: ",
  "sn23.13:1.3": ""'Vô thường, vô thường', bạch Thế Tôn, người ta thường nói. ",
  "sn23.13:1.4": "Bạch Thế Tôn, thế nào là vô thường?" ",
  "sn23.13:1.5": ""Này Rādha, sắc là vô thường, thọ là vô thường, tưởng là vô thường, các hành là vô thường, thức là vô thường. ",
  "sn23.13:1.6": "Quán như vậy … ",
  "sn23.13:1.7": "không còn trở lại trạng thái này nữa." ",
  "sn23.13:1.8": "Thứ ba. "
}