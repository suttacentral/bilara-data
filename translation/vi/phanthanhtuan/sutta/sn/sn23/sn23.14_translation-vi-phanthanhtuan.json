{
  "sn23.14:0.1": "Tương Ưng Bộ 23.14 ",
  "sn23.14:0.2": "2. Phẩm Ma Vương Thứ Hai ",
  "sn23.14:0.3": "Kinh Pháp Vô Thường ",
  "sn23.14:1.1": "Nhân duyên ở Sāvatthi. ",
  "sn23.14:1.2": "Ngồi xuống một bên, Tôn giả Rādha bạch Thế Tôn: ",
  "sn23.14:1.3": ""'Pháp vô thường, pháp vô thường', bạch Thế Tôn, người ta thường nói. ",
  "sn23.14:1.4": "Bạch Thế Tôn, thế nào là pháp vô thường?" ",
  "sn23.14:1.5": ""Này Rādha, sắc là pháp vô thường, thọ là pháp vô thường, tưởng là pháp vô thường, các hành là pháp vô thường, thức là pháp vô thường. ",
  "sn23.14:1.6": "Quán như vậy … ",
  "sn23.14:1.7": "không còn trở lại trạng thái này nữa." ",
  "sn23.14:1.8": "Thứ tư. "
}