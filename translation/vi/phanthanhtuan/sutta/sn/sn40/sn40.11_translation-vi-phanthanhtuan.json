{
  "sn40.11:0.1": "Tương Ưng Bộ 40.11 ",
  "sn40.11:0.2": "1. Phẩm Moggallāna ",
  "sn40.11:0.3": "Kinh Candana ",
  "sn40.11:1.1": "Rồi thiên tử Candana …pe…. ",
  "sn40.11:2.1": "Rồi thiên tử Suyāma …pe…. ",
  "sn40.11:3.1": "Rồi thiên tử Santusita …pe…. ",
  "sn40.11:4.1": "Rồi thiên tử Sunimmita …pe…. ",
  "sn40.11:5.1": "Rồi thiên tử Vasavatti …pe…. ",
  "sn40.11:6.1": "(Giống như Kinh Sakka, năm kinh rút gọn này cần được trình bày đầy đủ.) ",
  "sn40.11:6.2": "Thứ mười một. ",
  "sn40.11:6.3": "Phẩm Moggallāna thứ nhất. ",
  "sn40.11:7.0": "Tóm tắt phẩm: ",
  "sn40.11:7.1": "Có tầm và không tầm, ",
  "sn40.11:7.2": "lạc thọ và hành xả; ",
  "sn40.11:7.3": "Hư không và thức, ",
  "sn40.11:7.4": "vô sở hữu và phi tưởng; ",
  "sn40.11:7.5": "Vô tướng, Sakka, ",
  "sn40.11:7.6": "và Candana là thứ mười một. ",
  "sn40.11:7.7": "Tương Ưng Moggallāna hoàn mãn. "
}
