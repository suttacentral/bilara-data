{
  "sn17.27:0.1": "Kinh Tương Ưng 17.27 ",
  "sn17.27:0.2": "3. Phẩm Thứ Ba ",
  "sn17.27:0.3": "Kinh Sa-môn và Bà-la-môn (Thứ Ba) ",
  "sn17.27:1.1": "Trú tại Sāvatthī. ",
  "sn17.27:1.2": ""Này các Tỳ Kheo, những Sa-môn hay Bà-la-môn nào không như thật biết rõ lợi dưỡng, cung kính và danh vọng, không biết rõ sự sinh khởi của chúng, không biết rõ sự đoạn diệt của chúng, không biết rõ con đường dẫn đến sự đoạn diệt của chúng ...pe... ",
  "sn17.27:1.3": "biết rõ ...pe... ",
  "sn17.27:1.4": "chứng ngộ bằng thắng trí rồi an trú." ",
  "sn17.27:1.5": "Thứ bảy. "
