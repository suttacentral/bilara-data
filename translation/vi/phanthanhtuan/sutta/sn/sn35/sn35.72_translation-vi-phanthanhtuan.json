{
  "sn35.72:0.1": "Tương Ưng Bộ 35.72 ",
  "sn35.72:0.2": "7. Phẩm Migajāla ",
  "sn35.72:0.3": "Kinh Sáu Xúc Xứ (Thứ Hai) ",
  "sn35.72:1.1": ""Này các Tỳ Kheo, bất kỳ Tỳ Kheo nào không như thật biết rõ sự tập khởi, sự đoạn diệt, vị ngọt, sự nguy hiểm và sự xuất ly của sáu xúc xứ. ",
  "sn35.72:1.2": "Phạm hạnh của người đó chưa hoàn thành, người đó còn xa cách giáo pháp và luật này." ",
  "sn35.72:2.1": "Khi nghe vậy, một Tỳ Kheo bạch Thế Tôn rằng: ",
  "sn35.72:2.2": ""Bạch Thế Tôn, tôi đã thở phào, đã thoát khỏi bế tắc. ",
  "sn35.72:2.3": "Bạch Thế Tôn, tôi thực sự không như thật biết rõ sự tập khởi, sự đoạn diệt, vị ngọt, sự nguy hiểm và sự xuất ly của sáu xúc xứ." ",
  "sn35.72:3.1": ""Này Tỳ Kheo, Ông nghĩ thế nào, ",
  "sn35.72:3.2": "Ông có nhìn nhận mắt là 'cái này không phải của ta, ta không phải là cái này, cái này không phải là tự ngã của ta' không?" ",
  "sn35.72:4.1": ""Bạch Thế Tôn, vâng." ",
  "sn35.72:5.1": ""Lành thay, này Tỳ Kheo, và ở đây đối với Ông, này Tỳ Kheo, mắt được thấy đúng như thật bằng trí tuệ chân chánh rằng 'cái này không phải của ta, ta không phải là cái này, cái này không phải là tự ngã của ta'. ",
  "sn35.72:5.2": "Như vậy đối với Ông, xúc xứ thứ nhất này sẽ được đoạn trừ, không còn tái sinh trong tương lai …v.v… ",
  "sn35.72:6.1": ""Ông có nhìn nhận lưỡi là 'cái này không phải của ta, ta không phải là cái này, cái này không phải là tự ngã của ta' không?" ",
  "sn35.72:7.1": ""Bạch Thế Tôn, vâng." ",
  "sn35.72:8.1": ""Lành thay, này Tỳ Kheo, và ở đây đối với Ông, này Tỳ Kheo, lưỡi được thấy đúng như thật bằng trí tuệ chân chánh rằng 'cái này không phải của ta, ta không phải là cái này, cái này không phải là tự ngã của ta'. Như vậy đối với Ông, xúc xứ thứ tư này sẽ được đoạn trừ, không còn tái sinh trong tương lai …v.v… ",
  "sn35.72:9.1": ""Ông có nhìn nhận ý là 'cái này không phải của ta, ta không phải là cái này, cái này không phải là tự ngã của ta' không?" ",
  "sn35.72:10.1": ""Bạch Thế Tôn, vâng." ",
  "sn35.72:11.1": ""Lành thay, này Tỳ Kheo, và ở đây đối với Ông, này Tỳ Kheo, ý được thấy đúng như thật bằng trí tuệ chân chánh rằng 'cái này không phải của ta, ta không phải là cái này, cái này không phải là tự ngã của ta'. ",
  "sn35.72:11.2": "Như vậy đối với Ông, xúc xứ thứ sáu này sẽ được đoạn trừ, không còn tái sinh trong tương lai." ",
  "sn35.72:11.3": "Kinh thứ mười. "
}
