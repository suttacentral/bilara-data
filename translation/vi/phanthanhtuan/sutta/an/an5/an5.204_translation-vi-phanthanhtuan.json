{
  "an5.204:0.1": "Tăng Chi Bộ 5.204 ",
  "an5.204:0.2": "21. Phẩm Kimila ",
  "an5.204:0.3": "Kinh Năm Lực ",
  "an5.204:1.1": ""Này các Tỳ Kheo, có năm lực này. ",
  "an5.204:1.2": "Đó là năm lực nào? ",
  "an5.204:1.3": "Lực tín, lực tàm, lực quý, lực tấn, lực tuệ— ",
  "an5.204:1.4": "này các Tỳ Kheo, đây là năm lực." ",
  "an5.204:1.5": "Phẩm thứ tư. "
}
