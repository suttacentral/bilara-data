{
  "an10.156-166:0.1": "Tăng Chi Bộ 10.156–166 ",
  "an10.156-166:0.2": "16. Phẩm Con Người ",
  "an10.156-166:0.3": "Kinh Cần Được Kết Giao Và Các Kinh Khác ",
  "an10.156-166:1.1": ""Này các Tỳ Kheo, người thành tựu mười pháp thì không nên kết giao… ",
  "an10.156-166:1.2": "nên kết giao… ",
  "an10.156-166:1.3": "không nên gần gũi… ",
  "an10.156-166:1.4": "nên gần gũi… ",
  "an10.156-166:1.5": "không đáng được cúng dường… ",
  "an10.156-166:1.6": "đáng được cúng dường… ",
  "an10.156-166:1.7": "không đáng được tán thán… ",
  "an10.156-166:1.8": "đáng được tán thán… ",
  "an10.156-166:1.9": "không có sự tôn kính… ",
  "an10.156-166:1.10": "có sự tôn kính… ",
  "an10.156-166:1.11": "không có sự lắng nghe… ",
  "an10.156-166:1.12": "có sự lắng nghe… ",
  "an10.156-166:1.13": "không làm hài lòng… ",
  "an10.156-166:1.14": "làm hài lòng… ",
  "an10.156-166:1.15": "không được thanh tịnh… ",
  "an10.156-166:1.16": "được thanh tịnh… ",
  "an10.156-166:1.17": "không vượt qua được ngã mạn… ",
  "an10.156-166:1.18": "vượt qua được ngã mạn… ",
  "an10.156-166:1.19": "không tăng trưởng trí tuệ… ",
  "an10.156-166:1.20": "tăng trưởng trí tuệ… ",
  "an10.156-166:2.1": "tích lũy nhiều điều bất phước… ",
  "an10.156-166:2.2": "tích lũy nhiều phước đức. ",
  "an10.156-166:2.3": "Mười pháp đó là gì? ",
  "an10.156-166:2.4": "Người ấy có chánh kiến, có chánh tư duy, có chánh ngữ, có chánh nghiệp, có chánh mạng, có chánh tinh tấn, có chánh niệm, có chánh định, có chánh tri, có chánh giải thoát— ",
  "an10.156-166:2.5": "này các Tỳ Kheo, người thành tựu mười pháp này sẽ tích lũy nhiều phước đức." ",
  "an10.156-166:2.6": "Phẩm Con Người, phẩm thứ nhất. "
}