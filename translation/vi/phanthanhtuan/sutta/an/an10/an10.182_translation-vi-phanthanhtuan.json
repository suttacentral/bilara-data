{
  "an10.182:0.1": "Tăng Chi Bộ Kinh 10.182 ",
  "an10.182:0.2": "18. Phẩm Thiện Lành ",
  "an10.182:0.3": "Kinh Pháp và Phi Pháp ",
  "an10.182:1.1": ""Này các Tỳ Kheo, Ta sẽ giảng cho các ông về pháp và phi pháp. ",
  "an10.182:1.2": "Hãy lắng nghe …vân vân… ",
  "an10.182:1.3": "Và này các Tỳ Kheo, thế nào là phi pháp? ",
  "an10.182:1.4": "Sát sinh …vân vân… ",
  "an10.182:1.5": "tà kiến— ",
  "an10.182:1.6": "này các Tỳ Kheo, đây gọi là phi pháp. ",
  "an10.182:2.1": "Và này các Tỳ Kheo, thế nào là pháp? ",
  "an10.182:2.2": "Từ bỏ sát sinh …vân vân… ",
  "an10.182:2.3": "chánh kiến— ",
  "an10.182:2.4": "này các Tỳ Kheo, đây gọi là pháp." ",
  "an10.182:2.5": "Thứ năm. "
}
