{
  "thig15.1:0.1": "Стихи старших монахинь 15.1 ",
  "thig15.1:0.2": "Сорок строф ",
  "thig15.1:0.3": "Исидаси Тхери ",
  "thig15.1:1.1": "В Паталипутте — граде, названном в честь цветка, ",
  "thig15.1:1.2": "Великолепном, ",
  "thig15.1:1.3": "Из клана Сакьев две бхиккхуни пребывали, ",
  "thig15.1:1.4": "Обладающие превосходными качествами. ",
  "thig15.1:2.1": "Исидаси величали одну, <j>Вторую — Бодхи; ",
  "thig15.1:2.2": "Исполненные добродетелей, ",
  "thig15.1:2.3": "В джханах ликующие, с познаньями великими, ",
  "thig15.1:2.4": "Искоренившие все омраченья. ",
  "thig15.1:3.1": "Вернувшись со сбора подаяний, ",
  "thig15.1:3.2": "С трапезой покончив и чаши свои омыв, ",
  "thig15.1:3.3": "Устроившись удобно, ",
  "thig15.1:3.4": "Такую беседу они повели. "
}